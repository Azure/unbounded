<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="capacity-architecture" name="Provider-independent autoscaling">
    <mxGraphModel dx="1300" dy="1280" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="1280">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
