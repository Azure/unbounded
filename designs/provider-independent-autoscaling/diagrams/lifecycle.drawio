<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="allocation-lifecycle" name="Allocation and retirement">
    <mxGraphModel dx="1140" dy="820" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="820">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Allocate independently of registration; release independently of Node deletion" style="text;html=1;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1080" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="request" value="MachineAllocation&#xa;Pool slot OR NodeClaim&#xa;Protected consumer UID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="allocating" value="HostAllocate&#xa;Persist intent; Begin / Poll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="allocated" value="Allocated&#xa;Recoverable provider binding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="usable" value="Registered / usable&#xa;Exact identity; separate Ready evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="850" y="280" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="retiring" value="Release intent OR&#xa;Node termination observed&#xa;Fence repair and rejoin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="280" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="settle" value="Settle original allocation&#xa;Unknown stays blocked&#xa;No new provisioning request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="drain" value="One disruption owner&#xa;CAS path OR Karpenter&#xa;Drain + storage safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="release" value="HostRelease&#xa;Prove access fenced and&#xa;capacity entitlement returned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="850" y="470" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="released" value="Released&#xa;Allow finalizer removal&#xa;Finish remaining Node cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="850" y="660" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cancel-note" value="Cancellation / consumer loss before a confirmed binding:&#xa;preserve the original operation and settle any effects.&#xa;No remote effect means no remote release is needed." style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="30" y="650" width="680" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="release-note" value="A terminating Node is valid.&#xa;Node absence is NOT a&#xa;precondition for HostRelease." style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Blue: shared lifecycle responsibility. Grey: caller/runtime milestones. Dashed: cancellation path." style="text;html=1;align=left;fontSize=14;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="30" y="790" width="1080" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="request-allocate" value="pin class / offering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="request" target="allocating"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="allocate-bound" value="confirmed result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="allocating" target="allocated"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bound-usable" value="observe bootstrap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="allocated" target="usable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="usable-retire" value="scale down / delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="usable" target="retiring"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="request-cancel" value="cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="request" target="settle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="allocate-cancel" value="consumer lost / cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="allocating" target="settle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="230"/><mxPoint x="282" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="settle-retire" value="settled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="settle" target="retiring"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bound-retire" value="cancel before join" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="allocated" target="retiring"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="230"/><mxPoint x="651" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="retire-drain" value="coordinate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="retiring" target="drain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="drain-release" value="safe to release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="drain" target="release"><mxGeometry relative="1" as="geometry"/></mxCell>
