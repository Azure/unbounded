[Unit]
Description=Allocation launch check for the kubelet (unbounded agent)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/unbounded/bin/unbounded-agent allocation-launch-check
Restart=on-failure
