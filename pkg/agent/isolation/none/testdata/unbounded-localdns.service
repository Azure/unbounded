[Unit]
Description=Unbounded LocalDNS (unbounded agent)
Wants=unbounded-localdns-network.service
After=network.target unbounded-localdns-network.service
Before=unbounded-containerd.service unbounded-kubelet.service

[Service]
Type=notify
NotifyAccess=all
ExecStart=/opt/unbounded/node/current/libexec/unbounded-localdns-supervisor
WatchdogSec=60
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=30
Slice=localdns.slice
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
