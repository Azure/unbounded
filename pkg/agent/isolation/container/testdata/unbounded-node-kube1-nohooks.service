[Unit]
Description=Unbounded node container (kube1)
Wants=network-online.target
After=network-online.target local-fs.target
Conflicts=unbounded-node-kube2.service
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=simple
Slice=system.slice
Delegate=yes
DelegateSubgroup=supervisor
KillMode=mixed
KillSignal=SIGRTMIN+3
TimeoutStartSec=360
TimeoutStopSec=120
Restart=always
RestartSec=1
RestartMaxDelaySec=60
RestartSteps=10
ExecStartPre=-/opt/unbounded/runtime/runc delete --force unbounded-kube1
ExecStartPre=/usr/bin/mkdir -p /run/bpffs/kube1
ExecStartPre=/bin/sh -c '/usr/bin/mountpoint -q /run/bpffs/kube1 || /usr/bin/mount -t bpf bpf /run/bpffs/kube1'
ExecStartPre=/usr/bin/mkdir -p /var/lib/kubelet
ExecStartPre=/bin/sh -c '/usr/bin/mountpoint -q /var/lib/kubelet || /usr/bin/mount --bind /var/lib/kubelet /var/lib/kubelet'
ExecStartPre=/usr/bin/mount --make-rshared /var/lib/kubelet
ExecStart=/opt/unbounded/runtime/runc run --bundle /var/lib/unbounded/containers/bundles/kube1 unbounded-kube1
ExecStopPost=-/opt/unbounded/runtime/runc delete --force unbounded-kube1

[Install]
WantedBy=multi-user.target
