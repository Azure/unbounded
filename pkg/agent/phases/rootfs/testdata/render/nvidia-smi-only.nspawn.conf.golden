# The .nspawn file is read by machinectl/systemd-nspawn automatically. Because
# the default systemd-nspawn@.service template uses `--settings=override`,
# settings here (in the trusted /etc/systemd/nspawn/ directory) take precedence
# over CLI flags - PrivateUsers=no overrides -U, VirtualEthernet=no overrides
# --network-veth. There is no need to override ExecStart.
#
# Security relaxations required for nested containers (kubelet -> containerd -> runc):
#   Capability=all       - runc needs CAP_SYS_ADMIN, CAP_NET_ADMIN, CAP_MKNOD, etc.
#   PrivateUsers=no      - runc needs real root (UID 0) for namespace creation.
#   SystemCallFilter=@keyring bpf perf_event_open - containerd uses the kernel
#                                   keyring subsystem; runc/CNIs use eBPF and
#                                   perf events for cgroups and datapaths.
#   VirtualEthernet=no   - share host network; kubelet uses the host's routable IP.

[Exec]
Capability=all
PrivateUsers=no
SystemCallFilter=@keyring bpf perf_event_open

[Network]
VirtualEthernet=no

[Files]
# Bind-mount the host's kernel modules directory read-only into the container.
# This is required to export the host kernel to the machine.
BindReadOnly=/lib/modules
# Bind this machine's private bpffs so eBPF CNIs can create and share BPF maps
# without seeing pins from other nspawn machines.
Bind=/run/bpffs/kube1:/sys/fs/bpf
# Bind staged offline container image archives read-only into the container.
BindReadOnly=/var/lib/unbounded/container-images/current:/var/lib/unbounded/container-images
# Stage host-matched NVIDIA helpers so node-start can copy them into the root
# passed to nvidia-ctk with --driver-root. They are not run from this mount.
BindReadOnly=/usr/bin:/run/host-nvidia-bin
