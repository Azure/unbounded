# Build artifacts
bin/
!cmd/unbounded-storage/src/bin/
/gantry
/gantry-benchmark
/dist/
build/
inventory.db
*.exe
*.exe~
*.dll
*.so
*.dylib

# Net binaries (ignore loose binaries, not cmd dirs)
unbounded-net-*
!unbounded-net-*/
__debug*

# Developer Stuff
hack/scratch
hack/bin/
tmp/
# Sparse checkout of the workflow's own hack/release/ tooling, created by the
# deploy jobs in nightly.yaml and release-upgrade.yaml.
_deploy-tools/
.vm/
.vm-e2e/
unbounded-agent-config-dev.json
/resources/

# Kubernetes
.kube/
*.kubeconfig

# SSH
*_rsa
*_ed25519
*.pub

# Go tools
*.test
*.out
coverage.txt
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# Logs
*.log

# Dependency directories
vendor/

# IDE/editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated
.DS_Store
Thumbs.db

# Hugo
docs/public/
docs/resources/
docs/.hugo_build.lock

# AI Tools
.opencode
.claude/settings.local.json
.worktrees/

# Python
__pycache__/

# Rust
target/

# Environment files
.env
.env.*
.envrc
# Exception: .env.example is the template-of-record for new operators
# copying to .env. Without this re-include the .env.* rule above would
# silently swallow it.
!.env.example
!**/.env.example

# Frontend
/frontend/node_modules/
/frontend/dist/
/docs/architecture-tool/node_modules/
/docs/architecture-tool/dist/*
!/docs/architecture-tool/dist/.gitignore
.vite/
.npm/

# Playwright
.playwright-cli/
.playwright/

# Rendered templates
hack/net/templates/*.json
# Rendered manifest output is managed by per-directory .gitignore placeholders
# under deploy/{machina,net}/rendered/ so the //go:embed all:rendered
# directives in deploy/{machina,net}/embed.go remain satisfiable on a fresh
# clone.

# Temporary files
*.tmp

public/
.hugo_build.lock
