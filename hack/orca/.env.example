# Orca dev harness -- copy this file to .env, edit if needed, then run
# `make -C hack/orca up`.
#
# The harness supports three origin modes via ORIGIN_DRIVER:
#
#   1. azureblob with Azurite (default): in-cluster Azurite acts as
#      the Azure Blob origin (LocalStack is still the cachestore).
#      Exercises the actual azureblob driver path. Zero credentials
#      needed - the well-known Azurite dev key is auto-injected.
#
#   2. awss3 with LocalStack: in-cluster LocalStack acts as both
#      origin and cachestore (different buckets). Useful for testing
#      the pure S3 driver path with zero real-cloud dependencies.
#      Switch by setting ORIGIN_DRIVER=awss3.
#
#   3. azureblob with real Azure: ORIGIN_DRIVER=azureblob plus a
#      blank AZUREBLOB_ENDPOINT (or unset) and real values for
#      AZURE_STORAGE_ACCOUNT, AZURE_STORAGE_KEY, AZURE_CONTAINER.

# ---------------------------------------------------------------------------
# Origin driver: "azureblob" (Azurite or real Azure), "awss3" (LocalStack).
ORIGIN_DRIVER=azureblob

# Origin identifier baked into chunk keys. Changing this invalidates
# previously cached chunks (by design).
ORIGIN_ID=azureblob-azurite

# ---------------------------------------------------------------------------
# Azure Blob origin -- used when ORIGIN_DRIVER=azureblob (default).
#
# For the Azurite-emulator path (no Azure account needed): leave
# AZURE_STORAGE_ACCOUNT/AZURE_STORAGE_KEY blank. The harness will
# auto-pick devstoreaccount1 + the well-known dev key, and route
# requests at the in-cluster Azurite Service.
#
# For real Azure: fill in all three values and set AZUREBLOB_ENDPOINT
# blank (or unset) so the driver targets *.blob.core.windows.net.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=orca-test

# Endpoint override for the azureblob driver. Set automatically by the
# Makefile to point at Azurite when ORIGIN_DRIVER=azureblob and you
# don't override it here. Leave blank for real Azure.
# AZUREBLOB_ENDPOINT=http://azurite.unbounded-kube.svc.cluster.local:10000/devstoreaccount1/

# ---------------------------------------------------------------------------
# AWSS3 (LocalStack) origin -- used when ORIGIN_DRIVER=awss3 (opt-in).
ORIGIN_AWSS3_ENDPOINT=http://localstack.unbounded-kube.svc.cluster.local:4566
ORIGIN_AWSS3_REGION=us-east-1
ORIGIN_AWSS3_BUCKET=orca-origin

# ---------------------------------------------------------------------------
# Cachestore knobs. Defaults are appropriate for the in-cluster
# LocalStack deployed by the dev harness.
CACHESTORE_BUCKET=orca-cache
CACHESTORE_ENDPOINT=http://localstack.unbounded-kube.svc.cluster.local:4566
CACHESTORE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Image override. The dev harness builds locally with `image-orca-local`
# and tags as ORCA_IMAGE; if you want to test a different image, set it
# here. Default keeps a stable :dev tag so kind load doesn't choke on
# git-describe slashes in the auto-derived VERSION.
ORCA_IMAGE=ghcr.io/azure/orca:dev

# Replicas. Must match number of worker nodes in kind-config.yaml.
TARGET_REPLICAS=3

# ---------------------------------------------------------------------------
# Logging level: one of "debug", "info", "warn", "error". Wired into
# the rendered ConfigMap so it persists across `make reset`. The
# ORCA_LOG_LEVEL environment variable on the pod will still override
# at runtime if you set it via `kubectl set env`. Debug enables the
# full per-chunk trace through fetch / cluster / cachestore / origin
# / handlers - useful for inspecting cache behaviour interactively.
LOG_LEVEL=info
