# Manual troubleshooting template. The normal operator VM bootstrap writes the
# equivalent root-only configuration to /etc/gantry-benchmark/env.

# Required safety confirmation. This must exactly match:
#   kubectl config current-context
export BENCHMARK_CONFIRM_CONTEXT="replace-with-kubectl-context"

# Measurement mode. Direct mode is the dual-ACR benchmark.
#   proxy  - both phases route through the counting proxy, which is the measured
#            ACR origin. Origin bytes are measured directly.
#   direct - no proxy. The baseline pulls from its dedicated ACR and the Gantry
#            phase uses Gantry's dedicated ACR through its own origin client. Gantry origin bytes are
#            measured by gantry_origin_bytes_total, including partial transfers
#            and retries. Direct mode rolls Gantry onto a run-scoped DHT, and needs
#            no BENCHMARK_PROXY_IMAGE.
export BENCHMARK_MODE="direct"

# Direct mode: two different ACRs. prepare generates one random payload set and
# pushes the same repository/tag and payload fingerprint to both registries.
# Phase-specific paths inside each payload layer prevent containerd from reusing
# baseline content on the same nodes during the Gantry phase.
export BASELINE_ACR_NAME="replace-baseline"
export BASELINE_ACR_LOGIN_SERVER="replace-baseline.azurecr.io"
export BASELINE_ACR_USERNAME=""
export BASELINE_ACR_PASSWORD=""

export GANTRY_ACR_NAME="replace-gantry"
export GANTRY_ACR_LOGIN_SERVER="replace-gantry.azurecr.io"
export GANTRY_ACR_USERNAME=""
export GANTRY_ACR_PASSWORD=""

# Legacy proxy mode only: one ACR contains the proxy and both generated images.
export ACR_NAME="replace"
export ACR_LOGIN_SERVER="replace.azurecr.io"
export ACR_USERNAME=""
export ACR_PASSWORD=""
export BENCHMARK_PROXY_IMAGE="${ACR_LOGIN_SERVER}/acr-origin-proxy:benchmark"

# Required to make ACR-side pull counts/bytes and audit-log startup latency the
# primary benchmark measurements. The operator needs Azure CLI access;
# benchmark image traffic reaches ACR through the AKS Private Endpoint.
export BENCHMARK_AZURE_TELEMETRY="false"
export AZURE_LOG_ANALYTICS_WORKSPACE_ID=""
export AZURE_AKS_RESOURCE_ID=""

# Direct mode: each phase is measured against its own ACR and Private Endpoint.
export AZURE_BASELINE_ACR_RESOURCE_ID=""
export AZURE_BASELINE_ACR_PRIVATE_ENDPOINT_RESOURCE_ID=""
export AZURE_GANTRY_ACR_RESOURCE_ID=""
export AZURE_GANTRY_ACR_PRIVATE_ENDPOINT_RESOURCE_ID=""

# Legacy proxy mode only.
export AZURE_ACR_RESOURCE_ID=""
export AZURE_ACR_PRIVATE_ENDPOINT_RESOURCE_ID=""
export BENCHMARK_TELEMETRY_TIMEOUT="15m"
export BENCHMARK_TELEMETRY_POLL_INTERVAL="15s"

# Cluster components.
export GANTRY_NAMESPACE="gantry-system"
export GANTRY_DAEMONSET="gantry"
export GANTRY_CONFIGMAP="gantry-config"
export MONITORING_NAMESPACE="monitoring"
export PROMETHEUS_SERVICE="kps-kube-prometheus-stack-prometheus"
export KPS_RELEASE="kps"

# Benchmark dimensions.
export BENCHMARK_NAMESPACE="gantry-benchmark"
export BENCHMARK_NODE_COUNT="300"
export BENCHMARK_IMAGE_SIZE_MIB="1024"
# Number of separate COPY layers the payload is split across. 1 is the
# pathological single-giant-layer case (no cross-layer pipelining). Set higher
# to model a real multi-layer image, e.g. 8 for an 8 GiB / 8x1 GiB image. Must
# be >= 1 and <= BENCHMARK_IMAGE_SIZE_MIB.
export BENCHMARK_IMAGE_LAYERS="1"
export BENCHMARK_IMAGE_PLATFORM="linux/amd64"
export BENCHMARK_WORKLOAD_REPOSITORY="gantry-benchmark-pull"
export BENCHMARK_ROLLOUT_TIMEOUT="20m"

# Regression gates. Values are ratios, not percentages.
export BENCHMARK_MINIMUM_BYTE_REDUCTION="0.90"
export BENCHMARK_MAXIMUM_LATENCY_RATIO="1.0"

# Supported values: podman or docker. Docker uses Buildx.
export CONTAINER_ENGINE="podman"