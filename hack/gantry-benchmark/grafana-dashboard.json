      {"current": {}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(origin_requests_completed_total{namespace=\"$namespace\",gantry_benchmark=\"true\"},run_id)", "includeAll": false, "label": "Run ID", "name": "run_id", "query": {"query": "label_values(origin_requests_completed_total{namespace=\"$namespace\",gantry_benchmark=\"true\"},run_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "refresh": 1, "sort": 2, "type": "query"},
      {"current": {"text": "gantry-system", "value": "gantry-system"}, "hide": 0, "label": "Gantry namespace", "name": "gantry_namespace", "options": [{"selected": true, "text": "gantry-system", "value": "gantry-system"}], "query": "gantry-system", "type": "custom"}
    ]
