{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Origin comparison",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "decbytes"}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "sum by (phase) (origin_bytes_upstream_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",gantry_benchmark=\"true\"})", "legendFormat": "{{phase}}", "refId": "A"}
      ],
      "title": "ACR upstream bytes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "decbytes"}},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "sum by (phase) (origin_bytes_to_client_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",gantry_benchmark=\"true\"})", "legendFormat": "{{phase}}", "refId": "A"}
      ],
      "title": "Bytes delivered to clients",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "sum by (phase,path_class) (origin_requests_completed_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",gantry_benchmark=\"true\"})", "legendFormat": "{{phase}} {{path_class}}", "refId": "A"}
      ],
      "title": "Origin requests by phase and path",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "1 - sum(origin_bytes_upstream_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=\"gantry_cold\",gantry_benchmark=\"true\"}) / sum(origin_bytes_upstream_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=\"baseline\",gantry_benchmark=\"true\"})", "refId": "A"}
      ],
      "title": "Origin byte reduction",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "max"]}},
      "targets": [
        {"expr": "sum by (phase,path_class) (rate(origin_bytes_upstream_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",gantry_benchmark=\"true\"}[1m]))", "legendFormat": "{{phase}} {{path_class}}", "refId": "A"}
      ],
      "title": "ACR bytes/sec by phase and path",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "max"]}},
      "targets": [
        {"expr": "sum by (phase,client_class,path_class) (rate(origin_requests_completed_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",gantry_benchmark=\"true\"}[1m]))", "legendFormat": "{{phase}} {{client_class}} {{path_class}}", "refId": "A"}
      ],
      "title": "Origin requests/sec by phase, caller, and path",
      "type": "timeseries"
    },
    {
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15},
      "id": 400,
      "title": "Pod pull latency",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-pod image pull duration (pod completion time minus start time) for the benchmark pull Job, by phase. Derived from kube-state-metrics pod timing, so it needs no custom-label passthrough.",
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 16},
      "id": 13,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "quantile(0.95, kube_pod_completion_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-baseline-$run_id-.*\"} - on(namespace,pod) kube_pod_start_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-baseline-$run_id-.*\"})", "legendFormat": "baseline", "refId": "A"},
        {"expr": "quantile(0.95, kube_pod_completion_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-gantry-cold-$run_id-.*\"} - on(namespace,pod) kube_pod_start_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-gantry-cold-$run_id-.*\"})", "legendFormat": "gantry_cold", "refId": "B"}
      ],
      "title": "Pod pull latency (P95)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Median per-pod image pull duration for the benchmark pull Job, by phase.",
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 16},
      "id": 14,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "quantile(0.50, kube_pod_completion_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-baseline-$run_id-.*\"} - on(namespace,pod) kube_pod_start_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-baseline-$run_id-.*\"})", "legendFormat": "baseline", "refId": "A"},
        {"expr": "quantile(0.50, kube_pod_completion_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-gantry-cold-$run_id-.*\"} - on(namespace,pod) kube_pod_start_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-gantry-cold-$run_id-.*\"})", "legendFormat": "gantry_cold", "refId": "B"}
      ],
      "title": "Pod pull latency (P50)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "P95 pull-latency reduction: 1 - (gantry_cold P95 / baseline P95).",
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 16},
      "id": 15,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "1 - (quantile(0.95, kube_pod_completion_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-gantry-cold-$run_id-.*\"} - on(namespace,pod) kube_pod_start_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-gantry-cold-$run_id-.*\"})) / (quantile(0.95, kube_pod_completion_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-baseline-$run_id-.*\"} - on(namespace,pod) kube_pod_start_time{namespace=\"$namespace\",pod=~\"gantry-benchmark-baseline-$run_id-.*\"}))", "refId": "A"}
      ],
      "title": "P95 pull latency reduction",
      "type": "stat"
    },
    {
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 200,
      "title": "Gantry and rollout",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "max"]}},
      "targets": [
        {"expr": "sum(rate(p2p_peer_fetch_total{namespace=\"$gantry_namespace\",outcome=\"hit\",gantry_benchmark=\"true\"}[1m]))", "legendFormat": "peer hits", "refId": "A"},
        {"expr": "sum(rate(p2p_origin_pull_total{namespace=\"$gantry_namespace\",gantry_benchmark=\"true\"}[1m]))", "legendFormat": "origin pulls", "refId": "B"}
      ],
      "title": "Peer hits versus Gantry origin pulls",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 24},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last"]}},
      "targets": [
        {"expr": "sum by (label_gantry_unbounded_cloud_io_phase) (kube_pod_status_phase{namespace=\"$namespace\",phase=\"Succeeded\"} * on(namespace,pod) group_left(label_gantry_unbounded_cloud_io_phase,label_gantry_unbounded_cloud_io_run_id) kube_pod_labels{namespace=\"$namespace\",label_gantry_unbounded_cloud_io_run_id=\"$run_id\",label_app_kubernetes_io_name=\"gantry-benchmark-pull\"})", "legendFormat": "{{label_gantry_unbounded_cloud_io_phase}}", "refId": "A"}
      ],
      "title": "Completed pull pods",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 24},
      "id": 9,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "min(p2p_dht_health_score{namespace=\"$gantry_namespace\",gantry_benchmark=\"true\"})", "refId": "A"}
      ],
      "title": "Minimum DHT health",
      "type": "gauge"
    },
    {
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32},
      "id": 500,
      "title": "Origin errors",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "HTTP error responses returned by the proxy. Upstream ACR responses pass through unchanged; proxy-generated 502 responses are classified separately in the transport-errors panel.",
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last"]}},
      "targets": [
        {"expr": "sum by (phase,status) (origin_requests_completed_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",status=~\"4..|5..\",gantry_benchmark=\"true\"})", "legendFormat": "{{phase}} HTTP {{status}}", "refId": "A"}
      ],
      "title": "HTTP errors by status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Transport failures before ACR returned an HTTP response, classified into bounded reasons such as timeout, connection_refused, connection_reset, dns, and other.",
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last"]}},
      "targets": [
        {"expr": "sum by (phase,reason) (origin_upstream_errors_total{namespace=\"$namespace\",run_id=\"$run_id\",phase=~\"baseline|gantry_cold\",gantry_benchmark=\"true\"})", "legendFormat": "{{phase}} {{reason}}", "refId": "A"}
      ],
      "title": "Upstream transport errors",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
