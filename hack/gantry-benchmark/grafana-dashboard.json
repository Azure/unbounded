      {"current": {}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "definition": "label_values(kube_pod_labels{namespace=\"$namespace\",label_app_kubernetes_io_name=\"gantry-benchmark-pull\"},label_gantry_unbounded_cloud_io_run_id)", "includeAll": false, "label": "Run ID", "name": "run_id", "query": {"query": "label_values(kube_pod_labels{namespace=\"$namespace\",label_app_kubernetes_io_name=\"gantry-benchmark-pull\"},label_gantry_unbounded_cloud_io_run_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "refresh": 1, "sort": 2, "type": "query"},
      {"current": {"text": "gantry-system", "value": "gantry-system"}, "hide": 0, "label": "Gantry namespace", "name": "gantry_namespace", "options": [{"selected": true, "text": "gantry-system", "value": "gantry-system"}], "query": "gantry-system", "type": "custom"}
    ]
  },
  "time": {"from": "now-2h", "to": "now"},
