# Monitoring objects the benchmark installs in every mode. The Gantry PodMonitor
# stamps gantry_benchmark="true" onto agent samples so benchmark queries cannot
# collide with an operator's existing Gantry scrape config. Direct mode has no
# counting proxy but still needs these samples, so they live outside
# proxy.yaml.tmpl.
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: gantry-benchmark-agent
  namespace: {{ .Namespace }}
  labels:
    release: {{ .MonitoringLabel }}
    app.kubernetes.io/part-of: gantry-benchmark
spec:
  namespaceSelector:
    matchNames:
      - {{ .GantryNamespace }}
  selector:
    matchLabels:
      app.kubernetes.io/name: gantry
  podTargetLabels:
    - controller-revision-hash
  podMetricsEndpoints:
    - port: metrics
      path: /metrics
      interval: 10s
      metricRelabelings:
        - action: replace
          targetLabel: gantry_benchmark
          replacement: "true"
