# Copy to deploy.env. This file contains names and topology only, never secrets.

AZURE_SUBSCRIPTION_ID="replace-subscription-id"
DEPLOYMENT_NAME="vapa-gantry-benchmark1"
BASELINE_ACR_NAME="replacegloballyuniquebase"
GANTRY_ACR_NAME="replacegloballyuniquep2p"

# Required deployment authorization. Must exactly match the resource group.
DEPLOY_CONFIRM="vapa-gantry-benchmark1"
# DEPLOY_KUBECONFIG="/absolute/path/to/dedicated-kubeconfig"

# Recovered and validated 1000-node topology.
AZURE_LOCATION="canadacentral"
AKS_KUBERNETES_VERSION="1.35"
AKS_NODE_COUNT="1000"
AKS_NODE_VM_SIZE="Standard_D8s_v3"
AKS_NODE_OS_DISK_GB="512"
AKS_MAX_PODS="250"

VNET_CIDR="10.224.0.0/12"
AKS_SUBNET_CIDR="10.224.0.0/20"
POD_CIDR="10.64.0.0/12"
SERVICE_CIDR="10.0.0.0/16"
DNS_SERVICE_IP="10.0.0.10"
PRIVATE_ENDPOINT_SUBNET_CIDR="10.225.0.0/27"
OPERATOR_SUBNET_CIDR="10.236.0.0/24"

BENCHMARK_NODE_COUNT="1000"
BENCHMARK_IMAGE_SIZE_MIB="40960"
BENCHMARK_IMAGE_LAYERS="40"
BENCHMARK_MINIMUM_BYTE_REDUCTION="0.90"
BENCHMARK_MAXIMUM_LATENCY_RATIO="1.0"

# Optional all-or-none set to reuse an identical-payload image pair from a retained run.
ADOPT_BASELINE_IMAGE=""
ADOPT_GANTRY_IMAGE=""
ADOPT_PAYLOAD_SHA256=""

OPERATOR_VM_SIZE="Standard_D32ds_v5"
OPERATOR_VM_ZONE="1"
OPERATOR_BUILD_DISK_GB="512"
OPERATOR_BUILD_DISK_SKU="PremiumV2_LRS"
OPERATOR_BUILD_DISK_IOPS="20000"
OPERATOR_BUILD_DISK_MBPS="750"
OPERATOR_SSH_PORT="50001"
# Leave empty to allow only the deploying workstation's current public IPv4 /32.
OPERATOR_SSH_SOURCE_CIDR=""

# Leave false to deploy and validate everything without starting the benchmark.
START_BENCHMARK="false"