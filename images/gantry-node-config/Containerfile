FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.2-trixie AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -o /out/gantry-node-config ./cmd/gantry-node-config

FROM docker.io/library/ubuntu:noble@sha256:84e77dee7d1bc93fb029a45e3c6cb9d8aa4831ccfcc7103d36e876938d28895b

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl kmod util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/gantry-node-config /usr/local/bin/gantry-node-config
COPY images/gantry-node-config/configure-overlaybd.sh /usr/local/bin/configure-overlaybd.sh
RUN chmod 0755 /usr/local/bin/gantry-node-config /usr/local/bin/configure-overlaybd.sh

ENTRYPOINT ["/usr/local/bin/configure-overlaybd.sh"]