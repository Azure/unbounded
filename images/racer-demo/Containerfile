# Build from the repository root with -f images/racer-demo/Containerfile -t racer-demo.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.9-trixie AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg/racersdk/ ./pkg/racersdk/
COPY cmd/racer-demo/ ./cmd/racer-demo/
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/ ./cmd/racer-demo/...

# Keep a shell and sleep available for interactive Kubernetes demos.
FROM docker.io/library/debian:trixie-slim
COPY --from=builder /out/client /usr/local/bin/racer-demo
COPY --from=builder /out/origin /usr/local/bin/racer-demo-origin
COPY LICENSE NOTICE /usr/share/licenses/racer-demo/
USER 65532:65532
# Override the pod command with ["racer-demo-origin"] to serve, or exec racer-demo get/bench.
CMD ["sleep", "infinity"]
