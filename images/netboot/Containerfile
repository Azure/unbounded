ARG TARGETARCH

# The amd64 installer runs the Ubuntu generic kernel. The Ubuntu shim and GRUB
# verify it, so the installer still boots with Secure Boot enabled. Its module
# set already includes the Microsoft MANA NIC driver.
FROM docker.io/library/ubuntu:24.04 AS kernel-amd64

RUN apt-get update && \
    ok=false && \
    for attempt in 1 2 3 4 5; do \
      if apt-get install -y --no-install-recommends linux-image-generic; then \
        ok=true; break; \
      fi; \
      echo "apt-get install failed (attempt $attempt/5), retrying in 30s..."; \
      sleep 30; \
      apt-get update; \
    done && $ok && \
    mkdir -p /out && \
    cp -a /boot /out/boot && \
    cp -a /lib/modules /out/modules && \
    rm -rf /var/lib/apt/lists/*

# The arm64 Ubuntu generic kernel lacks the Microsoft MANA NIC driver, so the
# arm64 installer runs the Azure Linux kernel. The Ubuntu shim does not trust
# this kernel, so the arm64 installer needs Secure Boot turned off.
FROM mcr.microsoft.com/azurelinux/base/core:3.0 AS kernel-arm64

RUN tdnf install -y kernel && \
    tdnf clean all && \
    mkdir -p /out && \
    cp -a /boot /out/boot && \
    cp -a /usr/lib/modules /out/modules

FROM kernel-${TARGETARCH} AS kernel

FROM docker.io/library/ubuntu:24.04 AS build

ARG TARGETARCH

RUN apt-get update && \
    ok=false && \
    for attempt in 1 2 3 4 5; do \
      if apt-get install -y --no-install-recommends \
           ca-certificates cpio curl efibootmgr kmod xz-utils; then \
        ok=true; break; \
      fi; \
      echo "apt-get install failed (attempt $attempt/5), retrying in 30s..."; \
      sleep 30; \
      apt-get update; \
    done && $ok && \
    rm -rf /var/lib/apt/lists/*

# Azure Linux ships xz-compressed modules. Decompress them so that any kmod
# build in the Ubuntu initrd can load them, then rebuild the module index.
COPY --from=kernel /out/modules /usr/lib/modules
COPY --from=kernel /out/boot /tmp/kernel-boot
RUN KVER=$(ls /lib/modules | head -1) && \
    find "/lib/modules/${KVER}" -name '*.ko.xz' -exec xz -d {} + && \
    depmod "${KVER}"

RUN mkdir -p /artifacts && \
    KVER=$(ls /lib/modules | head -1) && \
    cp "/tmp/kernel-boot/vmlinuz-${KVER}" /artifacts/vmlinuz && \
    chmod 644 /artifacts/vmlinuz && \
    if [ "${TARGETARCH}" = "amd64" ]; then \
        NETBOOT_BASE="https://releases.ubuntu.com/24.04.2/netboot/amd64"; \
        curl -fSL --connect-timeout 10 --retry 3 --retry-delay 2 \
            -o /artifacts/shimx64.efi "${NETBOOT_BASE}/bootx64.efi" && \
        curl -fSL --connect-timeout 10 --retry 3 --retry-delay 2 \
            -o /artifacts/grubx64.efi "${NETBOOT_BASE}/grubx64.efi" && \
        curl -fSL --connect-timeout 10 --retry 3 --retry-delay 2 \
            -o /artifacts/initrd "${NETBOOT_BASE}/initrd"; \
    elif [ "${TARGETARCH}" = "arm64" ]; then \
        NETBOOT_URL="https://cdimage.ubuntu.com/ubuntu/releases/24.04.4/release/ubuntu-24.04.4-netboot-arm64.tar.gz"; \
        curl -fSL --connect-timeout 10 --retry 3 --retry-delay 2 \
            -o /tmp/netboot.tar.gz "${NETBOOT_URL}" && \
        tar -xzf /tmp/netboot.tar.gz -C /tmp && \
        cp /tmp/arm64/bootaa64.efi /artifacts/shimaa64.efi && \
        cp /tmp/arm64/grubaa64.efi /artifacts/grubaa64.efi && \
        cp /tmp/arm64/initrd /artifacts/initrd && \
        rm -rf /tmp/netboot.tar.gz /tmp/arm64; \
    else \
        echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1; \
    fi

COPY images/netboot/assets/init /tmp/initrd-root/init
# The installer copies whole driver directories, then adds any module they
# depend on from other directories, such as net/psample and net/tls for
# mlx5_core. modules.dep lists the full dependency closure of each module, so
# one pass is enough.
RUN chmod 755 /tmp/initrd-root/init && \
    mkdir -p /tmp/initrd-root/usr/bin /tmp/initrd-root/usr/lib && \
    cp /usr/bin/efibootmgr /usr/bin/curl /tmp/initrd-root/usr/bin/ && \
    for lib in $(ldd /usr/bin/efibootmgr /usr/bin/curl | awk '/=>/{print $3}'); do \
        mkdir -p "/tmp/initrd-root$(dirname "$lib")" && \
        cp "$lib" "/tmp/initrd-root${lib}"; \
    done && \
    INTERP=$(ldd /usr/bin/efibootmgr | awk '/ld-linux/{print $1}') && \
    mkdir -p "/tmp/initrd-root$(dirname "$INTERP")" && \
    cp "$INTERP" "/tmp/initrd-root${INTERP}" && \
    KVER=$(ls /lib/modules | head -1) && \
    KMOD="/tmp/initrd-root/lib/modules/${KVER}" && \
    for dir in drivers/net drivers/scsi drivers/ata drivers/nvme \
               drivers/virtio drivers/block fs crypto lib; do \
        mkdir -p "${KMOD}/kernel/${dir}" && \
        cp -a "/lib/modules/${KVER}/kernel/${dir}/." "${KMOD}/kernel/${dir}/" || exit 1; \
    done && \
    (cd "${KMOD}" && find kernel -name '*.ko*') > /tmp/initrd-modules && \
    awk -F': ' 'NR==FNR { want[$1] = 1; next } ($1 in want) { n = split($2, d, " "); for (i = 1; i <= n; i++) print d[i] }' \
        /tmp/initrd-modules "/lib/modules/${KVER}/modules.dep" | sort -u > /tmp/initrd-deps && \
    while read -r dep; do \
        [ -e "${KMOD}/${dep}" ] && continue; \
        mkdir -p "$(dirname "${KMOD}/${dep}")" && \
        cp -a "/lib/modules/${KVER}/${dep}" "${KMOD}/${dep}" || exit 1; \
    done < /tmp/initrd-deps && \
    rm -f /tmp/initrd-modules /tmp/initrd-deps && \
    for f in modules.builtin modules.builtin.modinfo modules.order; do \
        [ ! -e "/lib/modules/${KVER}/$f" ] || cp "/lib/modules/${KVER}/$f" "${KMOD}/$f"; \
    done && \
    depmod -b /tmp/initrd-root "${KVER}" && \
    cd /tmp/initrd-root && \
    find . -print0 | cpio --create --format=newc --quiet --null > /artifacts/init.cpio

RUN mkdir -p /disk/grub /disk/cloud-init && \
    cp /artifacts/vmlinuz /artifacts/initrd /artifacts/init.cpio /disk/ && \
	if [ "${TARGETARCH}" = "amd64" ]; then \
		cp /artifacts/shimx64.efi /artifacts/grubx64.efi /disk/ && \
		cp /artifacts/shimx64.efi /disk/bootx64.efi && \
		printf '%s\n' "dhcpBootImageName: shimx64.efi" "httpBootPath: bootx64.efi" "mediaFormat: unbounded-uefi-v1" > /disk/metadata.yaml; \
	elif [ "${TARGETARCH}" = "arm64" ]; then \
		cp /artifacts/shimaa64.efi /artifacts/grubaa64.efi /disk/ && \
		printf '%s\n' "dhcpBootImageName: shimaa64.efi" "httpBootPath: shimaa64.efi" "mediaFormat: unbounded-uefi-v1" > /disk/metadata.yaml; \
	fi

COPY images/netboot/assets/grub.cfg.tmpl /disk/grub/grub.cfg.tmpl
COPY images/netboot/assets/meta-data.tmpl /disk/cloud-init/meta-data.tmpl
COPY images/netboot/assets/network-config.tmpl /disk/cloud-init/network-config.tmpl
COPY images/netboot/assets/vendor-data.tmpl /disk/cloud-init/vendor-data.tmpl

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/Azure/unbounded" \
      org.opencontainers.image.description="Metalman reusable PXE netboot image"
COPY --from=build /disk /disk
COPY LICENSE NOTICE /unbounded/licenses/
