{{- if .BootLease }}
version: 2
ethernets:
  provisioning:
    match:
      macaddress: {{ yamlQuote .BootLease.MAC }}
    # DHCP runs alongside the static address only to hold the lease for
    # it, so the site DHCP server does not hand the address to another
    # host. Routes, DNS, and hostname still come from the static config.
    dhcp4: true
    dhcp4-overrides:
      use-routes: false
      use-dns: false
      use-ntp: false
      use-hostname: false
      use-domains: false
    dhcp6: false
    addresses:
      - {{ yamlQuote (printf "%s/%d" .BootLease.IPv4 (subnetPrefix .BootLease.SubnetMask)) }}
{{- if .BootLease.Gateway }}
    routes:
      - to: default
        via: {{ yamlQuote .BootLease.Gateway }}
{{- end }}
{{- if (ipAddresses .BootLease.DNS) }}
    nameservers:
      addresses:
{{- range (ipAddresses .BootLease.DNS) }}
        - {{ yamlQuote . }}
{{- end }}
{{- end }}
{{- else }}
version: 2
ethernets: {}
{{- end }}
