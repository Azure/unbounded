#!/bin/sh
# Unbounded Metal installer initrd /init script.
# Overlaid on top of the Ubuntu netboot initrd via a second cpio archive.
# Downloads a compressed raw disk image over HTTP, writes it to disk,
# injects cloud-init datasource configuration, and reboots.

set -e

mkdir -p /proc /sys /dev /tmp /run /mnt /mnt/esp
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Send output through the kernel log so it appears on all consoles.
exec >/dev/kmsg 2>&1

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

log() { echo "unbounded-metal: $*"; }
fatal() { log "FATAL: $*"; exec sh; }

retry() {
    local n="$1" delay="$2" desc="$3" i
    shift 3
    for i in $(seq 1 "$n"); do
        if "$@"; then
            [ "$i" -gt 1 ] && log "$desc succeeded (attempt $i/$n)"
            return 0
        fi
        [ "$i" -eq "$n" ] && return 1
        log "$desc failed (attempt $i/$n), retrying in ${delay}s"
        sleep "$delay"
    done
}

log "installer starting"

CMDLINE=$(cat /proc/cmdline)
get_param() {
    for tok in $CMDLINE; do
        case "$tok" in "$1"=*) echo "${tok#"$1"=}"; return 0 ;; esac
    done
    return 1
}

normalize_mac() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr '-' ':'
}

bootif_to_mac() {
    value=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    case "$value" in
        01-*) value=${value#01-} ;;
    esac
    echo "$value" | tr '-' ':'
}

log_interfaces() {
    log "network interfaces:"
    for dev in /sys/class/net/*; do
        [ -e "$dev" ] || continue
        name=$(basename "$dev")
        mac=$(cat "$dev/address" 2>/dev/null || true)
        state=$(cat "$dev/operstate" 2>/dev/null || true)
        log "  $name mac=${mac:-unknown} state=${state:-unknown}"
    done
}

log_disks() {
    log "candidate disks:"
    for disk in /sys/block/sd* /sys/block/nvme*n* /sys/block/vd*; do
        [ -e "$disk" ] || continue
        case "$(basename "$disk")" in
            *p[0-9]*|*[0-9])
                [ -e "$disk/partition" ] && continue
                ;;
        esac
        size=$(cat "$disk/size" 2>/dev/null || echo 0)
        model=$(cat "$disk/device/model" 2>/dev/null || true)
        serial=$(cat "$disk/device/serial" 2>/dev/null || true)
        removable=$(cat "$disk/removable" 2>/dev/null || true)
        log "  /dev/$(basename "$disk") sectors=$size model=${model:-unknown} serial=${serial:-unknown} removable=${removable:-unknown}"
    done
}

# The installer has no udev, so /dev/disk/by-id links do not exist. Create the
# common NVMe and virtio names so targetDisk can use a stable by-id path.
trim_id() {
    # Drop leading and trailing spaces and join inner runs with "_".
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    trim_ifs=$IFS
    IFS=_
    echo "$*"
    IFS=$trim_ifs
}

link_disk_ids() {
    mkdir -p /dev/disk/by-id
    for disk in /sys/block/nvme*n* /sys/block/vd*; do
        [ -e "$disk" ] || continue
        [ -e "$disk/partition" ] && continue
        name=$(basename "$disk")
        case "$name" in
            nvme*)
                model=$(trim_id "$(cat "$disk/device/model" 2>/dev/null || true)")
                serial=$(trim_id "$(cat "$disk/device/serial" 2>/dev/null || true)")
                wwid=$(trim_id "$(cat "$disk/wwid" 2>/dev/null || true)")
                nsid=$(cat "$disk/nsid" 2>/dev/null || true)
                nsid=${nsid:-${name##*n}}
                if [ -n "$model" ] && [ -n "$serial" ]; then
                    ln -sfn "../../$name" "/dev/disk/by-id/nvme-${model}_${serial}_${nsid}"
                    [ "$nsid" = 1 ] && ln -sfn "../../$name" "/dev/disk/by-id/nvme-${model}_${serial}"
                fi
                [ -n "$wwid" ] && ln -sfn "../../$name" "/dev/disk/by-id/nvme-${wwid}"
                ;;
            vd*)
                serial=$(trim_id "$(cat "$disk/serial" 2>/dev/null || true)")
                [ -n "$serial" ] && ln -sfn "../../$name" "/dev/disk/by-id/virtio-${serial}"
                ;;
        esac
    done
    return 0
}

target_disk_exists() {
    [ -e "$TARGET_DISK" ] && return 0
    case "$TARGET_DISK" in
        /dev/disk/by-id/*) link_disk_ids ;;
        *) return 1 ;;
    esac
    [ -e "$TARGET_DISK" ]
}

target_disk_sysfs() {
    base=$(basename "$TARGET_DISK")
    sysdisk=$(readlink -f "/sys/class/block/$base" 2>/dev/null || true)
    if [ -z "$sysdisk" ]; then
        sysdisk="/sys/block/$base"
    fi

    [ -d "$sysdisk" ] || return 1
    [ ! -e "$sysdisk/partition" ] || fatal "target disk $TARGET_DISK is a partition, expected whole disk"

    echo "$sysdisk"
}

partition_number() {
    part=$(basename "$1")
    cat "/sys/class/block/$part/partition" 2>/dev/null || true
}

# BEGIN local media functions
# Local media mode: the VirtualMedia ISO boots this installer with
# unbounded.install_url and a media.cpio that describes the host network.
# The functions below only read the paths in UB_NET, UB_MEDIA, UB_WORK, and
# UB_PROC_BOND and run "$UB_IP", so tests can point them at fixtures.

valid_install_url() {
    case "$1" in
        *[!a-zA-Z0-9_.:/-]*) return 1 ;;
        http://?*/bootmedia/*) ;;
        *) return 1 ;;
    esac
    vi_id=${1##*/bootmedia/}
    vi_host=${1#http://}
    vi_host=${vi_host%%/*}
    [ -n "$vi_host" ] || return 1
    [ "$1" = "http://$vi_host/bootmedia/$vi_id" ] || return 1
    [ "${#vi_id}" -eq 32 ] || return 1
    case "$vi_id" in *[!0-9a-f]*) return 1 ;; esac
    return 0
}

net_token_ok() {
    case "$1" in
        ''|*[!a-zA-Z0-9_.:/,+-]*) return 1 ;;
    esac
    return 0
}

net_uint_ok() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#1}" -le 9 ]
}

net_mtu_ok() {
    [ "$1" = - ] && return 0
    net_uint_ok "$1" && [ "$1" -ge 68 ] && [ "$1" -le 65535 ]
}

net_ifname_ok() {
    case "$1" in
        ''|.|..|*/*|*:*|*,*) return 1 ;;
    esac
    [ "${#1}" -le 15 ]
}

net_mac_ok() {
    case "$1" in
        [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;;
    esac
    return 1
}

net_ipv4_ok() {
    case "$1" in *[!0-9.]*|.*|*.|*..*) return 1 ;; esac
    ni_ifs=$IFS
    IFS=.
    # shellcheck disable=SC2086
    set -- $1
    IFS=$ni_ifs
    [ "$#" -eq 4 ] || return 1
    for ni_octet in "$@"; do
        net_uint_ok "$ni_octet" && [ "$ni_octet" -le 255 ] || return 1
    done
    return 0
}

net_cidr_ok() {
    case "$1" in */*) ;; *) return 1 ;; esac
    net_ipv4_ok "${1%/*}" || return 1
    nc_prefix=${1#*/}
    net_uint_ok "$nc_prefix" && [ "$nc_prefix" -le 32 ]
}

net_declared() {
    grep -qx "$1" "$UB_WORK/names" 2>/dev/null
}

net_declare() {
    net_ifname_ok "$1" || { log "invalid interface name $1"; return 1; }
    if net_declared "$1"; then
        log "duplicate interface name $1"
        return 1
    fi
    echo "$1" >> "$UB_WORK/names"
}

# parse_network_file validates the runtime description and splits it into one
# file per directive under UB_WORK, so the apply step can run in dependency
# order no matter how the description is ordered.
parse_network_file() {
    pn_file=$1
    [ -f "$pn_file" ] || { log "missing $pn_file"; return 1; }
    rm -rf "$UB_WORK"
    mkdir -p "$UB_WORK" || return 1
    for pn_kind in names ethernet bond vlan address route dns source; do
        : > "$UB_WORK/$pn_kind" || return 1
    done
    pn_lineno=0
    while IFS= read -r pn_line || [ -n "$pn_line" ]; do
        pn_lineno=$((pn_lineno + 1))
        pn_line=${pn_line%%#*}
        set -f
        # shellcheck disable=SC2086
        set -- $pn_line
        set +f
        [ "$#" -gt 0 ] || continue
        for pn_tok in "$@"; do
            net_token_ok "$pn_tok" || { log "network line $pn_lineno: invalid token"; return 1; }
        done
        pn_dir=$1
        shift
        case "$pn_dir" in
            ethernet)
                [ "$#" -eq 3 ] || { log "network line $pn_lineno: ethernet needs 3 arguments"; return 1; }
                net_declare "$1" || return 1
                net_mac_ok "$2" || { log "network line $pn_lineno: invalid MAC $2"; return 1; }
                if cut -d' ' -f2 "$UB_WORK/ethernet" | grep -qx "$2"; then
                    log "network line $pn_lineno: duplicate MAC $2"
                    return 1
                fi
                net_mtu_ok "$3" || { log "network line $pn_lineno: invalid MTU $3"; return 1; }
                ;;
            bond)
                [ "$#" -eq 7 ] || { log "network line $pn_lineno: bond needs 7 arguments"; return 1; }
                net_declare "$1" || return 1
                case "$2" in 802.3ad|active-backup|balance-xor) ;; *) log "network line $pn_lineno: unsupported bond mode $2"; return 1 ;; esac
                net_uint_ok "$3" || { log "network line $pn_lineno: invalid miimon $3"; return 1; }
                case "$4" in -|layer2|layer2+3|layer3+4|encap2+3|encap3+4) ;; *) log "network line $pn_lineno: invalid hash policy $4"; return 1 ;; esac
                case "$5" in -|slow|fast) ;; *) log "network line $pn_lineno: invalid LACP rate $5"; return 1 ;; esac
                net_mtu_ok "$6" || { log "network line $pn_lineno: invalid MTU $6"; return 1; }
                case "$7" in ,*|*,|*,,*) log "network line $pn_lineno: invalid member list"; return 1 ;; esac
                ;;
            vlan)
                [ "$#" -eq 4 ] || { log "network line $pn_lineno: vlan needs 4 arguments"; return 1; }
                net_declare "$1" || return 1
                net_ifname_ok "$2" || { log "network line $pn_lineno: invalid link $2"; return 1; }
                if ! net_uint_ok "$3" || [ "$3" -lt 1 ] || [ "$3" -gt 4094 ]; then
                    log "network line $pn_lineno: invalid VLAN ID $3"
                    return 1
                fi
                net_mtu_ok "$4" || { log "network line $pn_lineno: invalid MTU $4"; return 1; }
                ;;
            address)
                [ "$#" -eq 2 ] || { log "network line $pn_lineno: address needs 2 arguments"; return 1; }
                net_cidr_ok "$2" || { log "network line $pn_lineno: invalid address $2"; return 1; }
                ;;
            route)
                [ "$#" -eq 3 ] || { log "network line $pn_lineno: route needs 3 arguments"; return 1; }
                [ "$2" = default ] || net_cidr_ok "$2" || { log "network line $pn_lineno: invalid route $2"; return 1; }
                net_ipv4_ok "$3" || { log "network line $pn_lineno: invalid next hop $3"; return 1; }
                ;;
            dns)
                [ "$#" -eq 1 ] || { log "network line $pn_lineno: dns needs 1 argument"; return 1; }
                net_ipv4_ok "$1" || { log "network line $pn_lineno: invalid DNS server $1"; return 1; }
                ;;
            source)
                [ "$#" -eq 2 ] || { log "network line $pn_lineno: source needs 2 arguments"; return 1; }
                [ ! -s "$UB_WORK/source" ] || { log "network line $pn_lineno: duplicate source"; return 1; }
                net_ipv4_ok "$2" || { log "network line $pn_lineno: invalid source address $2"; return 1; }
                ;;
            *)
                log "network line $pn_lineno: unknown directive"
                return 1
                ;;
        esac
        echo "$*" >> "$UB_WORK/$pn_dir" || return 1
    done < "$pn_file"
    net_check_references
}

net_check_references() {
    while read -r cr_name _ _ _ _ _ cr_members; do
        cr_ifs=$IFS
        IFS=,
        for cr_member in $cr_members; do
            IFS=$cr_ifs
            if ! cut -d' ' -f1 "$UB_WORK/ethernet" | grep -qx "$cr_member"; then
                log "bond $cr_name member $cr_member is not a declared ethernet"
                return 1
            fi
            IFS=,
        done
        IFS=$cr_ifs
    done < "$UB_WORK/bond"
    cr_dup=$(awk '{ print $7 }' "$UB_WORK/bond" | tr ',' '\n' | sort | uniq -d | head -n 1)
    if [ -n "$cr_dup" ]; then
        log "ethernet $cr_dup belongs to more than one bond"
        return 1
    fi
    while read -r cr_name cr_link _; do
        if ! cut -d' ' -f1 "$UB_WORK/ethernet" "$UB_WORK/bond" | grep -qx "$cr_link"; then
            log "vlan $cr_name link $cr_link is not a declared ethernet or bond"
            return 1
        fi
    done < "$UB_WORK/vlan"
    while read -r cr_name _; do
        net_declared "$cr_name" || { log "unknown interface $cr_name"; return 1; }
    done < "$UB_WORK/address"
    while read -r cr_name _; do
        net_declared "$cr_name" || { log "unknown interface $cr_name"; return 1; }
    done < "$UB_WORK/route"
    [ -s "$UB_WORK/ethernet" ] || { log "network declares no ethernets"; return 1; }
    [ -s "$UB_WORK/source" ] || { log "network declares no source"; return 1; }
    read -r cr_name cr_ip < "$UB_WORK/source"
    if ! grep -q "^$cr_name $cr_ip/" "$UB_WORK/address"; then
        log "source address $cr_ip is not declared on $cr_name"
        return 1
    fi
    return 0
}

# net_find_mac prints the kernel device whose current MAC is $1. Bonding
# rewrites member MACs, so every ethernet is resolved before any bond exists.
net_find_mac() {
    fm_found=""
    fm_phys=""
    for fm_dev in "$UB_NET"/*; do
        [ -e "$fm_dev/address" ] || continue
        fm_name=${fm_dev##*/}
        [ "$fm_name" = lo ] && continue
        [ -e "$fm_dev/bonding" ] && continue
        [ -e "$fm_dev/master" ] && continue
        fm_mac=$(tr '[:upper:]' '[:lower:]' < "$fm_dev/address" 2>/dev/null || true)
        [ "$fm_mac" = "$1" ] || continue
        if [ -e "$fm_dev/device" ]; then
            # Virtual devices can copy a MAC; two physical ones cannot be
            # told apart.
            if [ -n "$fm_phys" ]; then
                log "MAC $1 matches devices $fm_phys and $fm_name" >&2
                return 2
            fi
            fm_phys=$fm_name
        elif [ -z "$fm_found" ]; then
            fm_found=$fm_name
        fi
    done
    fm_found=${fm_phys:-$fm_found}
    [ -n "$fm_found" ] || return 1
    echo "$fm_found"
}

net_map_ethernets() {
    : > "$UB_WORK/map" || return 1
    while read -r me_name me_mac _; do
        me_tries=0
        while :; do
            me_dev=$(net_find_mac "$me_mac") && break
            me_rc=$?
            [ "$me_rc" -eq 2 ] && return 1
            me_tries=$((me_tries + 1))
            if [ "$me_tries" -ge "${UB_MAP_TRIES:-30}" ]; then
                log "no network device has MAC $me_mac for $me_name"
                return 1
            fi
            sleep 1
        done
        log "ethernet $me_name is $me_dev ($me_mac)"
        echo "$me_name $me_dev" >> "$UB_WORK/map" || return 1
    done < "$UB_WORK/ethernet"
}

# net_dev prints the kernel device for a declared interface name.
net_dev() {
    nd_dev=$(awk -v n="$1" '$1 == n { print $2; exit }' "$UB_WORK/map")
    echo "${nd_dev:-$1}"
}

net_mtu() {
    [ "$2" = - ] && return 0
    "$UB_IP" link set dev "$1" mtu "$2"
}

apply_network() {
    net_map_ethernets || return 1
    while read -r an_name _ an_mtu; do
        an_dev=$(net_dev "$an_name")
        net_mtu "$an_dev" "$an_mtu" || { log "failed to set MTU on $an_dev"; return 1; }
    done < "$UB_WORK/ethernet"
    while read -r an_name an_mode an_miimon an_hash an_rate an_mtu an_members; do
        if [ -e "$UB_NET/$an_name" ]; then
            log "interface $an_name already exists"
            return 1
        fi
        set -- mode "$an_mode" miimon "$an_miimon"
        [ "$an_hash" = - ] || set -- "$@" xmit_hash_policy "$an_hash"
        [ "$an_rate" = - ] || set -- "$@" lacp_rate "$an_rate"
        log "creating bond $an_name ($an_mode) with $an_members"
        "$UB_IP" link add name "$an_name" type bond "$@" || { log "failed to create bond $an_name"; return 1; }
        an_ifs=$IFS
        IFS=,
        for an_member in $an_members; do
            IFS=$an_ifs
            an_dev=$(net_dev "$an_member")
            "$UB_IP" link set dev "$an_dev" down || return 1
            "$UB_IP" link set dev "$an_dev" master "$an_name" || { log "failed to add $an_dev to $an_name"; return 1; }
            IFS=,
        done
        IFS=$an_ifs
        net_mtu "$an_name" "$an_mtu" || { log "failed to set MTU on $an_name"; return 1; }
    done < "$UB_WORK/bond"
    while read -r an_name an_link an_id an_mtu; do
        if [ -e "$UB_NET/$an_name" ]; then
            log "interface $an_name already exists"
            return 1
        fi
        an_dev=$(net_dev "$an_link")
        log "creating VLAN $an_name (ID $an_id on $an_dev)"
        "$UB_IP" link add link "$an_dev" name "$an_name" type vlan id "$an_id" \
            || { log "failed to create VLAN $an_name"; return 1; }
        net_mtu "$an_name" "$an_mtu" || { log "failed to set MTU on $an_name"; return 1; }
    done < "$UB_WORK/vlan"
    for an_kind in ethernet bond vlan; do
        while read -r an_name _; do
            "$UB_IP" link set dev "$(net_dev "$an_name")" up || { log "failed to bring up $an_name"; return 1; }
        done < "$UB_WORK/$an_kind"
    done
    while read -r an_name an_cidr; do
        "$UB_IP" addr replace "$an_cidr" dev "$(net_dev "$an_name")" \
            || { log "failed to add $an_cidr to $an_name"; return 1; }
    done < "$UB_WORK/address"
    while read -r an_name an_to an_via; do
        "$UB_IP" route replace "$an_to" via "$an_via" dev "$(net_dev "$an_name")" \
            || { log "failed to add route $an_to via $an_via"; return 1; }
    done < "$UB_WORK/route"
    if [ -s "$UB_WORK/dns" ]; then
        sed 's/^/nameserver /' "$UB_WORK/dns" > "$UB_RESOLV" || return 1
    fi
    return 0
}

# net_source_bond prints the bond under the source interface, if any.
net_source_bond() {
    sb_name=$1
    sb_link=$(awk -v n="$sb_name" '$1 == n { print $2; exit }' "$UB_WORK/vlan")
    [ -z "$sb_link" ] || sb_name=$sb_link
    awk -v n="$sb_name" '$1 == n { print $1; exit }' "$UB_WORK/bond"
}

wait_source_link() {
    read -r ws_name _ < "$UB_WORK/source"
    ws_dev=$(net_dev "$ws_name")
    ws_bond=$(net_source_bond "$ws_name")
    ws_i=0
    ws_max=${UB_LINK_WAIT:-120}
    while [ "$ws_i" -lt "$ws_max" ]; do
        ws_carrier=$(cat "$UB_NET/$ws_dev/carrier" 2>/dev/null || true)
        ws_state=$(cat "$UB_NET/$ws_dev/operstate" 2>/dev/null || true)
        if [ "$ws_carrier" = 1 ] && [ "$ws_state" = up ]; then
            log "source interface $ws_name ($ws_dev) is up"
            return 0
        fi
        if [ $((ws_i % 10)) -eq 0 ]; then
            log "waiting for $ws_name ($ws_dev) carrier=${ws_carrier:-unknown} state=${ws_state:-unknown}"
            if [ -n "$ws_bond" ] && [ -r "$UB_PROC_BOND/$ws_bond" ]; then
                grep -E 'Interface|MII Status|Aggregator ID|Partner Mac|port state|LACP|Number of ports' \
                    "$UB_PROC_BOND/$ws_bond" 2>/dev/null | while IFS= read -r ws_line; do
                    log "  $ws_bond: $ws_line"
                done
            fi
        fi
        ws_i=$((ws_i + 1))
        sleep 1
    done
    log "WARNING: $ws_name ($ws_dev) is not up after ${ws_max}s, trying anyway"
    return 0
}

# parse_install reads KEY=VALUE instructions without evaluating them. Unknown
# keys are ignored; a known key with an invalid value rejects the response.
parse_install() {
    INSTALL_IMAGE_URL=""
    INSTALL_SERVE_URL=""
    INSTALL_DS_URL=""
    INSTALL_NODE_NAME=""
    INSTALL_NODE_NAMESPACE=""
    INSTALL_APISERVER_URL=""
    INSTALL_MEDIA_CALLBACK=""
    INSTALL_DISK=""
    while IFS= read -r pi_line || [ -n "$pi_line" ]; do
        [ -n "$pi_line" ] || continue
        case "$pi_line" in
            *=*) ;;
            *) log "install instructions: malformed line"; return 1 ;;
        esac
        pi_key=${pi_line%%=*}
        pi_value=${pi_line#*=}
        case "$pi_key" in
            IMAGE_URL|SERVE_URL|DS_URL|NODE_NAME|NODE_NAMESPACE|APISERVER_URL|MEDIA_CALLBACK|DISK) ;;
            *) continue ;;
        esac
        case "$pi_value" in
            *[!a-zA-Z0-9_.:/@+-]*) log "install instructions: invalid $pi_key"; return 1 ;;
        esac
        case "$pi_key" in
            IMAGE_URL) INSTALL_IMAGE_URL=$pi_value ;;
            SERVE_URL) INSTALL_SERVE_URL=$pi_value ;;
            DS_URL) INSTALL_DS_URL=$pi_value ;;
            NODE_NAME) INSTALL_NODE_NAME=$pi_value ;;
            NODE_NAMESPACE) INSTALL_NODE_NAMESPACE=$pi_value ;;
            APISERVER_URL) INSTALL_APISERVER_URL=$pi_value ;;
            MEDIA_CALLBACK) INSTALL_MEDIA_CALLBACK=$pi_value ;;
            DISK) INSTALL_DISK=$pi_value ;;
        esac
    done < "$1"
    [ -n "$INSTALL_IMAGE_URL" ] || { log "install instructions: IMAGE_URL missing"; return 1; }
    if [ "$INSTALL_MEDIA_CALLBACK" != "$2" ]; then
        log "install instructions: MEDIA_CALLBACK does not match install URL"
        return 1
    fi
    return 0
}

# fetch_install retries until metalman answers. It returns 0 with the
# instructions in $2, 3 when metalman refuses the boot (409), and 1 on a
# permanent failure. Other statuses, including 503 for transient metalman
# lookup errors, are retried.
fetch_install() {
    fi_url="$1/install"
    fi_out=$2
    fi_deadline=${UB_FETCH_ATTEMPTS:-60}
    fi_delay=2
    fi_i=0
    while [ "$fi_i" -lt "$fi_deadline" ]; do
        fi_i=$((fi_i + 1))
        rm -f "$fi_out"
        fi_status=$(curl --connect-timeout 5 --max-time 30 --retry 0 --silent \
            --output "$fi_out" --write-out '%{http_code}' "$fi_url") || fi_status=000
        case "$fi_status" in
            200) return 0 ;;
            409) log "metalman refused this boot (409)"; return 3 ;;
            400|401|403|404) log "install instructions request failed with $fi_status"; return 1 ;;
        esac
        log "install instructions request returned $fi_status (attempt $fi_i/$fi_deadline), retrying in ${fi_delay}s"
        sleep "$fi_delay"
        fi_delay=$((fi_delay * 2))
        [ "$fi_delay" -le 15 ] || fi_delay=15
    done
    log "install instructions unavailable after $fi_deadline attempts"
    return 1
}

# persist_host_network installs the rendered host network into the mounted
# root at $1, choosing networkd or netplan like the single-NIC path.
persist_host_network() {
    ph_root=$1
    if [ ! -d "$ph_root/etc/netplan" ] && [ -d "$ph_root/etc/systemd/network" ]; then
        log "persisting host network configuration for systemd-networkd"
        rm -f "$ph_root/etc/systemd/network/90-unbounded-dhcp.network" \
            "$ph_root/etc/systemd/network/10-unbounded-metal.network"
        ph_found=""
        for ph_file in "$UB_MEDIA"/networkd/*; do
            [ -f "$ph_file" ] || continue
            ph_base=${ph_file##*/}
            case "$ph_base" in
                *[!a-zA-Z0-9_.-]*|.*) log "invalid networkd file name $ph_base"; return 1 ;;
                *.link|*.netdev|*.network) ;;
                *) log "unexpected networkd file $ph_base"; return 1 ;;
            esac
            cp "$ph_file" "$ph_root/etc/systemd/network/$ph_base" || return 1
            chmod 644 "$ph_root/etc/systemd/network/$ph_base" || return 1
            ph_found=1
        done
        [ -n "$ph_found" ] || { log "media has no networkd files"; return 1; }
    else
        log "persisting host network configuration"
        mkdir -p "$ph_root/etc/netplan" || return 1
        rm -f "$ph_root/etc/netplan/50-cloud-init.yaml"
        cp "$UB_MEDIA/netplan.yaml" "$ph_root/etc/netplan/99-unbounded-metal.yaml" || return 1
        chmod 600 "$ph_root/etc/netplan/99-unbounded-metal.yaml" || return 1
    fi
    return 0
}
# END local media functions

KVER=$(uname -r)
for mod in virtio_pci virtio_blk ahci sd_mod nvme xfs ext4; do
    modprobe "$mod" 2>/dev/null || true
done
for mod in virtio_net e1000 e1000e igb ixgbe i40e ice mlx5_core mlx4_core bnxt_en tg3 be2net ena; do
    modprobe "$mod" 2>/dev/null || true
done
for f in /lib/modules/"${KVER}"/kernel/drivers/net/ethernet/*/*.ko* \
         /lib/modules/"${KVER}"/kernel/drivers/net/ethernet/*/*/*.ko*; do
    [ -e "$f" ] || continue
    mod=$(basename "$f")
    mod=${mod%.ko*}
    modprobe "$mod" 2>/dev/null || true
done
for mod in nls_cp437 nls_ascii nls_utf8 fat vfat efivarfs; do
    modprobe "$mod" 2>/dev/null || true
done

UB_NET=/sys/class/net
UB_MEDIA=/unbounded/media
UB_WORK=/tmp/unbounded-net
UB_PROC_BOND=/proc/net/bonding
UB_RESOLV=/etc/resolv.conf
UB_IP=ip
[ ! -x /unbounded/bin/ip ] || UB_IP=/unbounded/bin/ip

local_media_power_off() {
    log "powering off"
    sync
    poweroff -f 2>/dev/null || halt -f 2>/dev/null || echo o > /proc/sysrq-trigger
    sleep 30
    fatal "failed to power off"
}

local_media_setup() {
    valid_install_url "$INSTALL_URL" || fatal "invalid unbounded.install_url"
    log "local media install from $INSTALL_URL"
    modprobe bonding max_bonds=0 2>/dev/null || true
    modprobe 8021q 2>/dev/null || true
    log_interfaces
    parse_network_file "$UB_MEDIA/network" || fatal "invalid host network description"
    [ -f "$UB_MEDIA/netplan.yaml" ] || fatal "media has no netplan.yaml"
    apply_network || fatal "failed to configure host network"
    log_interfaces
    wait_source_link || true
    install_status=0
    fetch_install "$INSTALL_URL" /tmp/unbounded-install || install_status=$?
    case "$install_status" in
        0) ;;
        3) local_media_power_off ;;
        *) fatal "failed to fetch install instructions" ;;
    esac
    parse_install /tmp/unbounded-install "$INSTALL_URL" || fatal "invalid install instructions"
    rm -f /tmp/unbounded-install
    IMAGE_URL=$INSTALL_IMAGE_URL
    SERVE_URL=$INSTALL_SERVE_URL
    TARGET_DISK=$INSTALL_DISK
    DS_URL=$INSTALL_DS_URL
    NODE_NAME=$INSTALL_NODE_NAME
    NODE_NAMESPACE=$INSTALL_NODE_NAMESPACE
    APISERVER_URL=$INSTALL_APISERVER_URL
    MEDIA_CALLBACK=$INSTALL_MEDIA_CALLBACK
    VIRTUAL_MEDIA=1
    HOST_NETPLAN=$UB_MEDIA/netplan.yaml
    IP_PARAM=""
}

INSTALL_URL=$(get_param unbounded.install_url || true)
HOST_NETPLAN=""
if [ -n "$INSTALL_URL" ]; then
    local_media_setup
else
    IMAGE_URL=$(get_param unbounded.image_url) || fatal "unbounded.image_url not set"
    SERVE_URL=$(get_param unbounded.serve_url || true)
    TARGET_DISK=$(get_param unbounded.disk || true)
    BOOT_MAC=$(get_param unbounded.boot_mac || true)
    BOOTIF=$(get_param BOOTIF || true)
    DS_URL=$(get_param unbounded.ds_url || true)
    NODE_NAME=$(get_param unbounded.node_name || true)
    NODE_NAMESPACE=$(get_param unbounded.node_namespace || true)
    APISERVER_URL=$(get_param unbounded.apiserver_url || true)
    DNS_SERVERS=$(get_param unbounded.dns || true)
    VIRTUAL_MEDIA=$(get_param unbounded.virtual_media || true)
    MEDIA_CALLBACK=$(get_param unbounded.media_callback || true)
    if [ "$VIRTUAL_MEDIA" = 1 ]; then
        case "$MEDIA_CALLBACK" in
            http://*/bootmedia/*) ;;
            *) fatal "invalid virtual media callback URL" ;;
        esac
    fi
    BOOT_MAC=$(normalize_mac "$BOOT_MAC")
    if [ -z "$BOOT_MAC" ] && [ -n "$BOOTIF" ]; then
        BOOT_MAC=$(bootif_to_mac "$BOOTIF")
    fi

    log_interfaces

    log "waiting for network interface"
    IFACE=""
    find_iface_by_mac() {
        [ -n "$BOOT_MAC" ] || return 1
        for dev in /sys/class/net/*; do
            [ -e "$dev" ] || continue
            name=$(basename "$dev")
            [ "$name" = "lo" ] && continue
            mac=$(normalize_mac "$(cat "$dev/address" 2>/dev/null || true)")
            if [ "$mac" = "$BOOT_MAC" ]; then
                IFACE="$name"
                return 0
            fi
        done
        return 1
    }

    find_first_iface() {
        for dev in /sys/class/net/*; do
            [ -e "$dev" ] || continue
            name=$(basename "$dev")
            [ "$name" = "lo" ] && continue
            IFACE="$name"
            return 0
        done
        return 1
    }

    if [ -n "$BOOT_MAC" ]; then
        retry 30 1 "find network interface with MAC $BOOT_MAC" find_iface_by_mac \
            || fatal "no network interface found with MAC $BOOT_MAC"
    fi

    if [ -z "$IFACE" ]; then
        retry 30 1 "find network interface" find_first_iface || fatal "no network interface found"
        log "WARNING: using first non-loopback network interface $IFACE"
    else
        log "selected network interface $IFACE for MAC $BOOT_MAC"
    fi

    mask2cidr() {
        local cidr=0 octets=0 suffix=0
        for octet in $(echo "$1" | tr '.' ' '); do
            octets=$((octets + 1))
            [ "$octets" -le 4 ] || return 1
            if [ "$suffix" -eq 1 ]; then
                [ "$octet" = 0 ] || return 1
                continue
            fi
            case "$octet" in
                255) cidr=$((cidr + 8)) ;;
                254) cidr=$((cidr + 7)); suffix=1 ;;
                252) cidr=$((cidr + 6)); suffix=1 ;;
                248) cidr=$((cidr + 5)); suffix=1 ;;
                240) cidr=$((cidr + 4)); suffix=1 ;;
                224) cidr=$((cidr + 3)); suffix=1 ;;
                192) cidr=$((cidr + 2)); suffix=1 ;;
                128) cidr=$((cidr + 1)); suffix=1 ;;
                0) suffix=1 ;;
                *) return 1 ;;
            esac
        done
        [ "$octets" -eq 4 ] || return 1
        echo "$cidr"
    }

    IP_PARAM=$(get_param ip || true)
    if [ -n "$IP_PARAM" ]; then
        CLIENT_IP=$(echo "$IP_PARAM" | cut -d: -f1)
        GW=$(echo "$IP_PARAM" | cut -d: -f3)
        MASK=$(echo "$IP_PARAM" | cut -d: -f4)
        IFACE_PARAM=$(echo "$IP_PARAM" | cut -d: -f6)

        case "$MASK" in
            *.*.*.*) PREFIX=$(mask2cidr "$MASK") || fatal "invalid or non-contiguous subnet mask $MASK" ;;
            *) PREFIX="$MASK" ;;
        esac
        case "$PREFIX" in
            ''|*[!0-9]*) fatal "invalid IPv4 prefix $PREFIX" ;;
        esac
        [ "$PREFIX" -le 32 ] || fatal "invalid IPv4 prefix $PREFIX"
        [ -n "$CLIENT_IP" ] || fatal "static client IP is empty"
        [ -n "$BOOT_MAC" ] || fatal "unbounded.boot_mac is required for persistent static networking"

        if [ -n "$IFACE_PARAM" ] && [ -e "/sys/class/net/$IFACE_PARAM" ]; then
            IFACE="$IFACE_PARAM"
        fi

        log "configuring $IFACE with $CLIENT_IP/$PREFIX"
        retry 5 2 "link up $IFACE" ip link set "$IFACE" up || fatal "failed to bring up $IFACE"
        retry 3 1 "set address" ip addr replace "$CLIENT_IP/$PREFIX" dev "$IFACE" \
            || fatal "failed to configure $CLIENT_IP/$PREFIX on $IFACE"
        if [ -n "$GW" ]; then
            retry 3 1 "set default route" ip route replace default via "$GW" dev "$IFACE" \
                || fatal "failed to configure default route through $GW"
        fi

        if [ -n "$DNS_SERVERS" ]; then
            : > /etc/resolv.conf
            old_ifs=$IFS
            IFS=,
            for dns in $DNS_SERVERS; do
                IFS=$old_ifs
                [ -n "$dns" ] || fatal "empty DNS server in unbounded.dns"
                case "$dns" in *[!0-9a-fA-F:.]*) fatal "invalid DNS server $dns" ;; esac
                echo "nameserver $dns" >> /etc/resolv.conf
                IFS=,
            done
            IFS=$old_ifs
        fi
    fi
fi

if [ -z "$TARGET_DISK" ]; then
    log "waiting for block devices"
    find_disk() {
        TARGET_DISK=""
        MAX_SIZE=0
        for disk in /sys/block/sd* /sys/block/nvme*n* /sys/block/vd*; do
            [ -e "$disk" ] || continue
            [ -e "$disk/partition" ] && continue
            SIZE=$(cat "$disk/size" 2>/dev/null || echo 0)
            if [ "$SIZE" -gt "$MAX_SIZE" ]; then
                MAX_SIZE=$SIZE
                TARGET_DISK="/dev/$(basename "$disk")"
            fi
        done
        [ -n "$TARGET_DISK" ]
    }
    log_disks
    retry 30 1 "find block device" find_disk || fatal "no target disk found"
    log "WARNING: target disk was not specified, selected largest disk"
else
    if ! retry 30 1 "find target disk $TARGET_DISK" target_disk_exists; then
        log_disks
        fatal "target disk $TARGET_DISK does not exist"
    fi
fi
TARGET_DISK=$(readlink -f "$TARGET_DISK" 2>/dev/null || echo "$TARGET_DISK")
log "target disk: $TARGET_DISK"

log "downloading disk image from $IMAGE_URL"
retry 120 5 "download disk image" wget -q -O /tmp/disk.img.gz "$IMAGE_URL" \
    || fatal "failed to download disk image"

log "writing disk image to $TARGET_DISK"
write_image() { gunzip -c /tmp/disk.img.gz | dd of="$TARGET_DISK" bs=4194304; }
retry 3 5 "write disk image" write_image || fatal "failed to write disk image"
rm -f /tmp/disk.img.gz
sync

retry 5 2 "re-read partition table" blockdev --rereadpt "$TARGET_DISK" \
    || log "WARNING: could not re-read partition table"
sleep 2

parts_for_disk() {
    sysdisk=$(target_disk_sysfs) || return 0
    for p in "$sysdisk"/*; do
        [ -e "$p" ] || continue
        [ -e "$p/partition" ] || continue
        echo "/dev/$(basename "$p")"
    done
}

find_root_part() {
    ROOT_PART=""
    for part in $(parts_for_disk); do
        if mount "$part" /mnt 2>/dev/null; then
            if [ -d /mnt/etc ] && [ -d /mnt/var ]; then
                ROOT_PART="$part"
                umount /mnt
                return 0
            fi
            umount /mnt
        fi
    done
    return 1
}

if [ -n "$DS_URL" ] || [ -n "$IP_PARAM" ] || [ -n "$HOST_NETPLAN" ]; then
    retry 20 2 "find root partition" find_root_part || fatal "no root partition found on $TARGET_DISK"
    retry 5 2 "mount $ROOT_PART" mount "$ROOT_PART" /mnt || fatal "failed to mount $ROOT_PART"

    if [ -n "$HOST_NETPLAN" ]; then
        persist_host_network /mnt || fatal "failed to persist host network configuration"
    elif [ -n "$IP_PARAM" ] && [ ! -d /mnt/etc/netplan ] && [ -d /mnt/etc/systemd/network ]; then
        # Images without netplan (for example Azure Linux) use
        # systemd-networkd directly. The lower file name sorts before the
        # image's default DHCP file, which is removed so that other NICs do
        # not add competing default routes.
        log "persisting static network configuration for systemd-networkd"
        rm -f /mnt/etc/systemd/network/90-unbounded-dhcp.network
        {
            echo "[Match]"
            echo "MACAddress=${BOOT_MAC}"
            echo ""
            echo "[Network]"
            echo "DHCP=no"
            echo "IPv6AcceptRA=no"
            echo "Address=${CLIENT_IP}/${PREFIX}"
            [ -z "$GW" ] || echo "Gateway=${GW}"
            old_ifs=$IFS
            IFS=,
            for dns in $DNS_SERVERS; do
                echo "DNS=${dns}"
            done
            IFS=$old_ifs
        } > /mnt/etc/systemd/network/10-unbounded-metal.network
        chmod 644 /mnt/etc/systemd/network/10-unbounded-metal.network
    elif [ -n "$IP_PARAM" ]; then
        log "persisting static network configuration"
        mkdir -p /mnt/etc/netplan
        rm -f /mnt/etc/netplan/50-cloud-init.yaml
        cat > /mnt/etc/netplan/99-unbounded-metal.yaml <<NETPLAN
network:
  version: 2
  ethernets:
    provisioning:
      match:
        macaddress: "${BOOT_MAC}"
      dhcp4: false
      dhcp6: false
      addresses:
        - "${CLIENT_IP}/${PREFIX}"
NETPLAN
        if [ -n "$GW" ]; then
            cat >> /mnt/etc/netplan/99-unbounded-metal.yaml <<NETPLANROUTE
      routes:
        - to: default
          via: "${GW}"
NETPLANROUTE
        fi
        if [ -n "$DNS_SERVERS" ]; then
            cat >> /mnt/etc/netplan/99-unbounded-metal.yaml <<NETPLANDNS
      nameservers:
        addresses:
NETPLANDNS
            old_ifs=$IFS
            IFS=,
            for dns in $DNS_SERVERS; do
                IFS=$old_ifs
                echo "          - \"${dns}\"" >> /mnt/etc/netplan/99-unbounded-metal.yaml
                IFS=,
            done
            IFS=$old_ifs
        fi
        chmod 600 /mnt/etc/netplan/99-unbounded-metal.yaml
    fi

    if [ -n "$DS_URL" ]; then
        log "injecting cloud-init datasource: $DS_URL"
        mkdir -p /mnt/etc/cloud/cloud.cfg.d /mnt/etc/unbounded-metal
        cat > /mnt/etc/cloud/cloud.cfg.d/99-unbounded-metal.cfg <<CLOUDINIT
datasource_list: [NoCloud]
datasource:
  NoCloud:
    seedfrom: ${DS_URL}
network:
  config: disabled
CLOUDINIT
        rm -f /mnt/etc/cloud/cloud-init.disabled
        cat > /mnt/etc/unbounded-metal/config <<UMCONFIG
SERVE_URL=${SERVE_URL}
NODE_NAME=${NODE_NAME}
NODE_NAMESPACE=${NODE_NAMESPACE}
APISERVER_URL=${APISERVER_URL}
UMCONFIG
    fi
    sync
    umount /mnt
    log "installed system configured on $ROOT_PART"
fi

if [ -d /sys/firmware/efi ]; then
    log "creating UEFI boot entry for local disk"
    if ! mountpoint -q /sys/firmware/efi/efivars 2>/dev/null; then
        mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
    fi

    for part in $(parts_for_disk); do
        if mount -t vfat "$part" /mnt/esp 2>/dev/null; then
            LOADER=""
            for candidate in \
                /EFI/BOOT/BOOTX64.EFI \
                /EFI/BOOT/BOOTAA64.EFI \
                /EFI/ubuntu/shimx64.efi \
                /EFI/ubuntu/shimaa64.efi; do
                if [ -f "/mnt/esp${candidate}" ]; then
                    LOADER="$(echo "$candidate" | tr '/' '\\')"
                    break
                fi
            done
            umount /mnt/esp

            if [ -n "$LOADER" ] && command -v efibootmgr >/dev/null 2>&1; then
                ESP_NUM=$(partition_number "$part")
                if [ -n "$ESP_NUM" ]; then
                    efibootmgr --create --disk "$TARGET_DISK" --part "$ESP_NUM" \
                        --loader "$LOADER" --label "unbounded" 2>&1 \
                        && log "UEFI boot entry created (${LOADER} on part ${ESP_NUM})" \
                        || log "WARNING: efibootmgr failed, PXE chainloader will be used as fallback"
                    break
                fi
            fi
        fi
    done
fi

if [ "$VIRTUAL_MEDIA" = 1 ]; then
    # Stay in RAM until the controller has detached the ISO and cleared its
    # boot override. Requests are bounded, but waiting has no deadline: late
    # cleanup must let this installer reboot without writing the disk again.
    # If ownership is removed, an operator must resolve the blocked handoff.
    media_ack() {
        local status
        status=$(curl --connect-timeout 5 --max-time 15 --retry 0 \
            --silent --output /dev/null --write-out '%{http_code}' \
            --request "$1" "$MEDIA_CALLBACK/$2") || return 1
        [ "$status" = 200 ]
    }
    log "reporting virtual media installation complete"
    until media_ack POST complete; do
        log "waiting to persist image-written status; reboot remains blocked"
        sleep 5
    done
    until media_ack GET ready; do
        log "waiting for virtual media cleanup acknowledgment; reboot remains blocked"
        sleep 5
    done
elif [ -n "$SERVE_URL" ]; then
    log "disabling PXE boot"
    retry 5 2 "disable PXE" wget -q -O /dev/null "$SERVE_URL/pxe/disable" \
        || log "WARNING: failed to disable PXE boot"
fi

log "installation complete, rebooting"
sleep 2
retry 3 2 "reboot" reboot -f || fatal "failed to reboot"
