FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.0-trixie AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY ../../ .

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make token-refresher-build VERSION=${VERSION} ${GIT_COMMIT:+GIT_COMMIT=${GIT_COMMIT}} ${BUILD_TIME:+BUILD_TIME=${BUILD_TIME}}

FROM ubuntu:noble

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /unbounded/bin

COPY --from=builder /src/bin/token-refresher /unbounded/bin/token-refresher
COPY LICENSE NOTICE /unbounded/licenses/

ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

ENTRYPOINT ["/unbounded/bin/token-refresher"]
