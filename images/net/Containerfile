# Shared Containerfile for the unbounded-net controller and node images.
# Two final stages (`controller`, `node`) share a single builder and a
# trimmed Ubuntu runtime base. Build with `--target controller` or
# `--target node`.
#
# CGO is disabled so cross-compilation does not require an emulated builder.
# The eBPF object is generated by bpf2go and committed into the tree under
# internal/net/ebpf/, so this builder does NOT need clang / libbpf-dev.

# =============================================================================
# Build stage. Pin to BUILDPLATFORM so the Go toolchain runs natively even
# when targeting a foreign TARGETPLATFORM. ntttcp is the only piece of C code
# we still build; for cross-arch we use a Debian cross gcc.
# =============================================================================
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.3-trixie AS builder

ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

# Builder dependencies. gcc-aarch64-linux-gnu is only required when an amd64
# builder is producing an arm64 image (for ntttcp); it's small and harmless
# to install unconditionally.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        make \
        git \
        ca-certificates \
        curl \
        tar \
        gcc-aarch64-linux-gnu \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Platform args populated by buildkit from --platform.
ARG TARGETOS
ARG TARGETARCH
ARG BUILDARCH

# Software version args.
ARG CNI_PLUGINS_VERSION=v1.9.1

# Copy go mod files first for better caching.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Pre-downloaded CNI plugins live under resources/ in the build context.
COPY resources/ /resources/

RUN mkdir -p /cni-plugins \
    && file="/resources/cni-plugins-${TARGETOS}-${TARGETARCH}-${CNI_PLUGINS_VERSION}.tgz" \
    && if [ ! -s "$file" ]; then echo "Missing CNI plugins archive: $file"; exit 1; fi \
    && tar -xz -C /cni-plugins -f "$file"

# Build ntttcp for network performance testing. Cross-compile with the
# Debian aarch64 toolchain when the build host and target arch differ. If
# cross-compile fails for any reason we fall back to writing a stub script
# at /usr/local/bin/ntttcp so the node stage's COPY always succeeds; this is
# an explicit acceptable fallback from the rollout plan.
RUN set -eux; \
    for i in 1 2 3; do \
        git clone --depth 1 https://github.com/microsoft/ntttcp-for-linux.git /tmp/ntttcp-for-linux && break; \
        echo "git clone attempt $i failed, retrying in 10s..."; \
        rm -rf /tmp/ntttcp-for-linux; \
        [ "$i" = "3" ] && exit 1; \
        sleep 10; \
    done; \
    cd /tmp/ntttcp-for-linux/src; \
    if [ "${TARGETARCH}" = "arm64" ] && [ "${BUILDARCH}" != "arm64" ]; then \
        CC=aarch64-linux-gnu-gcc make || { \
            echo "WARN: ntttcp cross-compile failed; installing stub"; \
            printf '#!/bin/sh\necho "ntttcp not available on this image" >&2\nexit 1\n' > /usr/local/bin/ntttcp; \
            chmod 0755 /usr/local/bin/ntttcp; \
            rm -rf /tmp/ntttcp-for-linux; \
            exit 0; \
        }; \
    else \
        make; \
    fi; \
    if [ -x ntttcp ]; then cp ntttcp /usr/local/bin/ntttcp; fi; \
    rm -rf /tmp/ntttcp-for-linux

# Copy the rest of the source tree last so binary-source edits don't bust
# the dep/CNI/ntttcp caches above.
COPY . .

# VERSION/GIT_COMMIT/BUILD_TIME inject version metadata via ldflags. Use
# ${VAR:+...} so empty args fall back to the Makefile's defaults.
ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build,id=go-build-${TARGETARCH} \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make unbounded-net-controller-build unbounded-net-node-build unping-build unroute-build \
        VERSION=${VERSION} \
        ${GIT_COMMIT:+GIT_COMMIT=${GIT_COMMIT}} \
        ${BUILD_TIME:+BUILD_TIME=${BUILD_TIME}} \
    && cp bin/unbounded-net-controller /unbounded-net-controller \
    && cp bin/unbounded-net-node /unbounded-net-node \
    && cp bin/unping /unping \
    && cp bin/unroute /unroute

# =============================================================================
# Shared runtime base. The only stage that still runs under QEMU for arm64.
# =============================================================================
FROM docker.io/library/ubuntu:24.04 AS runtime-base

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates passwd iproute2 iptables util-linux hostname \
        wget tcpdump iputils-ping libatomic1 libcap2 openssl \
        procps less tar gzip jq python3 dnsutils \
        wireguard-tools \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV PS1='[\u@\h \W]\$ '

# =============================================================================
# Controller stage
# =============================================================================
FROM runtime-base AS controller

LABEL org.opencontainers.image.source="https://github.com/Azure/unbounded"
LABEL org.opencontainers.image.description="unbounded-net controller"
LABEL org.opencontainers.image.licenses="MIT"

RUN groupadd -r controller && useradd -r -g controller controller

COPY --from=builder /unbounded-net-controller /usr/local/bin/unbounded-net-controller
COPY --from=builder /unping /usr/local/bin/unping
COPY --from=builder /unroute /usr/local/bin/unroute

USER controller
ENTRYPOINT ["/usr/local/bin/unbounded-net-controller"]

# =============================================================================
# Node stage
# =============================================================================
FROM runtime-base AS node

LABEL org.opencontainers.image.source="https://github.com/Azure/unbounded"
LABEL org.opencontainers.image.description="unbounded-net node agent"
LABEL org.opencontainers.image.licenses="MIT"

COPY images/net/node-agent-init.sh /usr/local/bin/node-agent-init.sh
RUN chmod 0755 /usr/local/bin/node-agent-init.sh

COPY --from=builder /cni-plugins/ /opt/cni/bin/
COPY --from=builder /usr/local/bin/ntttcp /usr/local/bin/ntttcp
COPY --from=builder /unbounded-net-node /usr/local/bin/unbounded-net-node
COPY --from=builder /unping /usr/local/bin/unping
COPY --from=builder /unroute /usr/local/bin/unroute

ENTRYPOINT ["/usr/local/bin/unbounded-net-node"]
