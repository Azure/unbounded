FROM docker.io/library/ubuntu:24.04 AS build

ARG TARGETARCH
ARG UBUNTU_CLOUDIMG_URL=https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-${TARGETARCH}.img

RUN apt-get update && \
    ok=false && \
    for attempt in 1 2 3 4 5; do \
      if apt-get install -y --no-install-recommends \
           ca-certificates curl pigz qemu-utils; then \
        ok=true; break; \
      fi; \
      echo "apt-get install failed (attempt $attempt/5), retrying in 30s..."; \
      sleep 30; \
      apt-get update; \
    done && $ok && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /disk && \
    curl -fSL --connect-timeout 10 --retry 3 --retry-delay 2 \
        -o /tmp/cloudimg.qcow2 "${UBUNTU_CLOUDIMG_URL}" && \
    qemu-img convert -f qcow2 -O raw /tmp/cloudimg.qcow2 /tmp/disk.img && \
    rm /tmp/cloudimg.qcow2 && \
    pigz -1 /tmp/disk.img && \
    mv /tmp/disk.img.gz /disk/disk.img.gz

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/Azure/unbounded" \
      org.opencontainers.image.description="Metalman machine image for Ubuntu 24.04"
COPY --from=build /disk /disk
COPY LICENSE NOTICE /unbounded/licenses/
