FROM fedora:44

# Set so scripts and tools know they are running inside a container. This
# env var is well-known as it is used by systemd.
ENV container=docker

# Make Python pip ignore the fact it is running as root in a container. Noisy
# warnings if this is not set.
ENV PIP_ROOT_USER_ACTION=ignore

ENV LANG=C.UTF-8

# Install runtime dependencies. Please keep this list in alphabetical order
# for easy scanning.
#
# @c-development     - C/C++ compilers and headers for cgo builds.
# @development-tools - make, autoconf, patch, and the rest of the standard
#                      build toolchain.
# azure-cli          - Azure command-line interface.
# bc                 - shell arithmetic, useful for base conversions.
# ca-certificates    - TLS root store for anything that opens HTTPS.
# git                - source control.
# go                 - the Go toolchain.
# jq                 - shell processing of JSON documents.
# openssh-clients    - ssh/scp for git over SSH and remote shells.
# openssl-devel      - cgo headers needed by deps that link against OpenSSL
#                      (e.g. github.com/google/go-tpm-tools/simulator). CI
#                      runs on ubuntu-latest where libssl-dev is preinstalled.
# python             - required by various linting and codegen tools.
# rsync              - file syncing for scripts and tests.
# sudo               - the entrypoint runs as the unprivileged "dev" user;
#                      sudoers allows escalation when needed.
# tar                - archive extraction.
# tree               - pretty-print a directory tree.
# unzip              - archive extraction.
# util-linux         - provides "su" and friends.
# wget               - HTTP downloads.
# which              - PATH lookup.
RUN dnf makecache -y \
    && dnf install -y \
        @c-development \
        @development-tools \
        azure-cli \
        bc \
        ca-certificates \
        git \
        go \
        jq \
        openssh-clients \
        openssl-devel \
        python \
        rsync \
        sudo \
        tar \
        tree \
        unzip \
        util-linux \
        wget \
        which \
    && dnf upgrade -y \
    && dnf clean all

ENV GOROOT=/usr/lib/golang

# Pinned Go tool versions are supplied by the caller via --build-arg. The
# repository Makefile is the single source of truth (GOFUMPT_VERSION,
# GOLANGCI_LINT_VERSION, PROTOC_GEN_GO_VERSION, PROTOC_GEN_GO_GRPC_VERSION,
# CONTROLLER_GEN_VERSION); toolchain.sh extracts them from the Makefile and
# passes them in. Building without these args will fail fast at the
# `go install ...@` step, which is intentional: the image should never be
# built with unpinned tool versions.
ARG GOFUMPT_VERSION
ARG GOLANGCI_LINT_VERSION
ARG PROTOC_GEN_GO_VERSION
ARG PROTOC_GEN_GO_GRPC_VERSION
ARG CONTROLLER_GEN_VERSION

# GOBIN is set inline to /usr/local/bin so installed binaries land on the
# default PATH for every user, without leaking a build-time GOBIN/GOPATH into
# the runtime environment of the dev user (see entrypoint.sh).
RUN GOBIN=/usr/local/bin go install golang.org/x/tools/cmd/goimports@latest \
        && GOBIN=/usr/local/bin go install mvdan.cc/gofumpt@${GOFUMPT_VERSION} \
        && GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
        && GOBIN=/usr/local/bin go install google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION} \
        && GOBIN=/usr/local/bin go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION} \
        && GOBIN=/usr/local/bin go install sigs.k8s.io/controller-tools/cmd/controller-gen@${CONTROLLER_GEN_VERSION} \
        && rm -rf /root/go /root/.cache

# Create the unprivileged "dev" user the entrypoint runs as. The uid/gid are
# fixed at 1000:1000 so toolchain.sh can map the host invoking user 1:1 onto
# them via --userns=keep-id:uid=1000,gid=1000 under rootless podman. Sudoers
# is baked in so `sudo` works inside the container without the entrypoint
# having to mutate /etc/sudoers.d at runtime.
RUN useradd --create-home --shell /bin/bash --uid 1000 --user-group dev \
        && echo 'dev ALL=(root) NOPASSWD:ALL' > /etc/sudoers.d/dev \
        && chmod 0440 /etc/sudoers.d/dev

COPY --chmod=755 entrypoint.sh /

USER dev
ENTRYPOINT ["/entrypoint.sh"]
