FROM docker.io/library/ubuntu:noble@sha256:84e77dee7d1bc93fb029a45e3c6cb9d8aa4831ccfcc7103d36e876938d28895b

ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=

LABEL org.opencontainers.image.title="Project Signal runner" \
      org.opencontainers.image.description="Baseline execution environment for Project Signal certification scripts" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://github.com/Azure/unbounded"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      coreutils \
      curl \
      dnsutils \
      ethtool \
      infiniband-diags \
      iproute2 \
      iputils-ping \
      ibverbs-utils \
      jq \
      netcat-openbsd \
      numactl \
      openmpi-bin \
      openssh-client \
      openssh-server \
      pciutils \
      perftest \
      procps \
      rdma-core \
      util-linux \
    && rm -rf /var/lib/apt/lists/*

# NVIDIA Container Runtime injects driver-matched compute and utility
# libraries and tools when the Pod receives an NVIDIA GPU allocation.
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN command -v bash \
    && command -v sha256sum \
    && command -v base64 \
    && command -v curl \
    && command -v jq \
    && command -v ip \
    && command -v ping \
    && command -v ss \
    && command -v ethtool \
    && command -v lspci \
    && command -v numactl \
    && command -v rdma \
    && command -v ibstat \
    && command -v ibv_devinfo \
    && command -v ib_write_bw \
    && command -v mpirun \
    && command -v ssh \
    && command -v sshd

RUN mkdir -p /scripts /results /run/sshd

COPY LICENSE NOTICE /licenses/

WORKDIR /workspace
