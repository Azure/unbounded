# Build stage
# Pin the builder to BUILDPLATFORM so the Go toolchain runs natively on the
# host even when targeting a foreign TARGETPLATFORM.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.2-trixie AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY ../../ .

ARG TARGETOS
ARG TARGETARCH

RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} make racer-loadgen-build

# Runtime stage
# racer-loadgen is a static benchmark client, so it ships on scratch rather
# than ubuntu:noble. cmd/racer-loadgen/container_test.go enforces the base.
FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /src/bin/racer-loadgen /unbounded/bin/racer-loadgen
COPY LICENSE NOTICE /unbounded/licenses/

ENV PATH="/unbounded/bin"

WORKDIR /unbounded

# UDS startup needs the default root-owned /run/racer layout and an origin
# socket accessible to the root dataplane.
USER 0:0

# 8080 = synthetic registry, 9090 = metrics and health
EXPOSE 8080 9090

ENTRYPOINT ["/unbounded/bin/racer-loadgen"]
