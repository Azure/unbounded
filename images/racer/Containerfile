ARG RUST_IMAGE=docker.io/library/rust:1.96.0-bookworm
ARG RUNTIME_IMAGE=ubuntu:noble
# Build stage
# Build on the target platform: both Rust and the verbs adapter use its ABI.
FROM ${RUST_IMAGE} AS builder
ARG RACER_NATIVE_RDMA=true
# Build the CUDA shim (libracer_gpu_cuda.so.1) and the `cuda` feature. On by
# default so one image serves GPU and CPU nodes. The shim dlopens the driver at
# runtime, so only nvcc (for the decrypt kernel PTX) is installed here; the
# runtime image gets the driver from the NVIDIA runtime. With
# RACER_ENABLE_GPU=auto (the default), the dataplane touches no GPU until the
# first gpu-read, and turns GPU reads off then if no GPU is usable. Set false
# for a smaller image without GPU reads.
ARG RACER_NATIVE_CUDA=true
# nvcc comes from NVIDIA's distribution-neutral redist archives rather than the
# debian12 apt repo: that repo has no CUDA 12 packages for sbsa (arm64), so the
# arm64 build could not install cuda-nvcc-12-9. The archives are pinned by
# sha256 per architecture and match the runtime stage's CUDA 12.9 release
# (redistrib_12.9.1.json). nvcc implicitly includes cuda_runtime.h, which
# comes from cuda_cudart.
ARG CUDA_REDIST_URL=https://developer.download.nvidia.com/compute/cuda/redist
ARG CUDA_NVCC_VERSION=12.9.86
ARG CUDA_NVCC_SHA256_X86_64=7a1a5b652e5ef85c82b721d10672fc9a2dbaab44e9bd3c65a69517bf53998c35
ARG CUDA_NVCC_SHA256_SBSA=0aa1fce92dbae76c059c27eefb9d0ffb58e1291151e44ff7c7f1fc2dd9376c0d
ARG CUDA_CUDART_VERSION=12.9.79
ARG CUDA_CUDART_SHA256_X86_64=1f6ad42d4f530b24bfa35894ccf6b7209d2354f59101fd62ec4a6192a184ce99
ARG CUDA_CUDART_SHA256_SBSA=8b422a3b2cb8452cb678181b0bf9d7aa7342df168b5319c5488ae3b8514101fc
ENV RUSTFLAGS="-C force-frame-pointers=yes"
WORKDIR /src

# rdma-core from source: distribution releases predate RC QP support for
# Azure MANA (rdma-core 54). The verbs adapter builds against it and the
# runtime stage ships its libraries and providers under /usr/local.
ARG RDMA_CORE_VERSION=v65.0
ARG RDMA_CORE_COMMIT=58e40801bfed5a8befc0881594820fa0a0baa4a1
RUN case "$RACER_NATIVE_RDMA" in \
        true) apt-get update && apt-get install -y --no-install-recommends \
            cmake ninja-build pkg-config libnl-3-dev libnl-route-3-dev python3 \
            && rm -rf /var/lib/apt/lists/* \
            && git clone --depth 1 --branch "$RDMA_CORE_VERSION" \
                https://github.com/linux-rdma/rdma-core.git /tmp/rdma-core \
            && test "$(git -C /tmp/rdma-core rev-parse HEAD)" = "$RDMA_CORE_COMMIT" \
            && cmake -S /tmp/rdma-core -B /tmp/rdma-core/build -G Ninja \
                -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
                -DNO_PYVERBS=1 -DNO_MAN_PAGES=1 -DENABLE_STATIC=0 \
            && ninja -C /tmp/rdma-core/build install \
            && DESTDIR=/out ninja -C /tmp/rdma-core/build install \
            && rm -rf /out/usr/local/include /out/usr/local/share /out/usr/local/bin \
                /out/usr/local/sbin /out/usr/local/libexec /out/usr/local/lib/pkgconfig \
            && rm -rf /tmp/rdma-core && ldconfig ;; \
        false) ;; \
        *) echo "RACER_NATIVE_RDMA must be true or false" >&2; exit 1 ;; \
    esac

RUN set -eu; \
    case "$RACER_NATIVE_CUDA" in \
        true) \
            case "$(uname -m)" in \
                x86_64) arch=x86_64; \
                    nvcc_sha=$CUDA_NVCC_SHA256_X86_64; cudart_sha=$CUDA_CUDART_SHA256_X86_64 ;; \
                aarch64) arch=sbsa; \
                    nvcc_sha=$CUDA_NVCC_SHA256_SBSA; cudart_sha=$CUDA_CUDART_SHA256_SBSA ;; \
                *) echo "unsupported CUDA architecture $(uname -m)" >&2; exit 1 ;; \
            esac; \
            mkdir -p /usr/local/cuda/targets; \
            for component in "cuda_nvcc $CUDA_NVCC_VERSION $nvcc_sha" \
                "cuda_cudart $CUDA_CUDART_VERSION $cudart_sha"; do \
                set -- $component; \
                archive="$1-linux-$arch-$2-archive.tar.xz"; \
                curl -fsSL -o "/tmp/$archive" "$CUDA_REDIST_URL/$1/linux-$arch/$archive"; \
                echo "$3  /tmp/$archive" | sha256sum -c -; \
                tar -xJf "/tmp/$archive" -C /usr/local/cuda --strip-components=1; \
                rm "/tmp/$archive"; \
            done; \
            ln -s .. "/usr/local/cuda/targets/$arch-linux"; \
            /usr/local/cuda/bin/nvcc --version ;; \
        false) ;; \
        *) echo "RACER_NATIVE_CUDA must be true or false" >&2; exit 1 ;; \
    esac
ENV PATH="${PATH}:/usr/local/cuda/bin"

# Copy only build inputs, never host target trees or deployment credentials.
COPY cmd/racer/Cargo.toml cmd/racer/Cargo.lock ./
COPY cmd/racer/src ./src
COPY cmd/racer/wire/Cargo.toml ./wire/Cargo.toml
COPY cmd/racer/wire/src ./wire/src
COPY cmd/racer/authority/Cargo.toml ./authority/Cargo.toml
COPY cmd/racer/authority/src ./authority/src
COPY cmd/racer/core/Cargo.toml ./core/Cargo.toml
COPY cmd/racer/core/src ./core/src
COPY cmd/racer/peer-wire/Cargo.toml ./peer-wire/Cargo.toml
COPY cmd/racer/peer-wire/src ./peer-wire/src
COPY cmd/racer/alloc/Cargo.toml ./alloc/Cargo.toml
COPY cmd/racer/alloc/src ./alloc/src
COPY cmd/racer/flow/Cargo.toml ./flow/Cargo.toml
COPY cmd/racer/flow/src ./flow/src
COPY cmd/racer/flow-core/Cargo.toml ./flow-core/Cargo.toml
COPY cmd/racer/flow-core/src ./flow-core/src
COPY cmd/racer/crypto/Cargo.toml ./crypto/Cargo.toml
COPY cmd/racer/crypto/src ./crypto/src
COPY cmd/racer/verbs/Cargo.toml ./verbs/Cargo.toml
COPY cmd/racer/verbs/src ./verbs/src
COPY cmd/racer/verbs/native/verbs.c ./verbs/native/verbs.c
COPY cmd/racer/gpu/Cargo.toml cmd/racer/gpu/build.rs ./gpu/
COPY cmd/racer/gpu/src ./gpu/src
COPY cmd/racer/gpu/native ./gpu/native
COPY cmd/racer/http/Cargo.toml ./http/Cargo.toml
COPY cmd/racer/http/src ./http/src
COPY cmd/racer/http/tests ./http/tests
COPY cmd/racer/topology/Cargo.toml ./topology/Cargo.toml
COPY cmd/racer/topology/src ./topology/src
COPY cmd/racer/dst/Cargo.toml ./dst/Cargo.toml
COPY cmd/racer/dst/src ./dst/src
COPY images/racer/build-native.sh ./build-native.sh
COPY images/racer/build-native-cuda.sh ./build-native-cuda.sh
COPY images/racer/check-debug-info.sh ./check-debug-info.sh
RUN set -eu; \
    mkdir -p /out/unbounded/bin /out/usr/local/lib; \
    features=; \
    if [ "$RACER_NATIVE_RDMA" = true ]; then features=rdma; fi; \
    if [ "$RACER_NATIVE_CUDA" = true ]; then features="${features:+$features,}cuda"; fi; \
    cargo build --locked --release --bin racer --no-default-features ${features:+--features "$features"}; \
    if [ "$RACER_NATIVE_RDMA" = true ]; then \
        sh ./build-native.sh verbs/native/verbs.c /out/usr/local/lib/librdma_verbs.so.1; \
    fi; \
    if [ "$RACER_NATIVE_CUDA" = true ]; then \
        RACER_GPU_REQUIRE_PTX=1 sh ./build-native-cuda.sh gpu/native /out/usr/local/lib/libracer_gpu_cuda.so.1; \
    fi; \
    sh ./check-debug-info.sh target/release/racer; \
    install -m 0755 target/release/racer /out/unbounded/bin/racer

# Runtime stage
# ubuntu:noble like the other component images. The Debian bookworm builder
# links against an older glibc and libibverbs, and both keep backward-compatible
# symbol versions, so the binary and verbs adapter run on noble's newer ones.
FROM ${RUNTIME_IMAGE}
ARG RACER_NATIVE_RDMA=true
ARG RACER_NATIVE_CUDA=true
# cuFile user-space library for GPUDirect Storage. The NVIDIA container runtime
# injects driver libraries only, not the toolkit's libcufile.so.0, so the CUDA
# image ships it. The repo matches RUNTIME_IMAGE (ubuntu:noble). cuFile loads
# libnuma.so.1.0.0 at runtime to place its buffers; it is not a package
# dependency.
ARG CUDA_CUFILE_PACKAGE=libcufile-12-9
ARG CUDA_RUNTIME_REPO=ubuntu2404
RUN set -eu; \
    case "$RACER_NATIVE_CUDA" in \
        true) \
            case "$(uname -m)" in \
                x86_64) repo=x86_64 ;; \
                aarch64) repo=sbsa ;; \
                *) echo "unsupported CUDA architecture $(uname -m)" >&2; exit 1 ;; \
            esac; \
            apt-get update; \
            apt-get install -y --no-install-recommends ca-certificates curl; \
            curl -fsSL -o /tmp/cuda-keyring.deb \
                "https://developer.download.nvidia.com/compute/cuda/repos/$CUDA_RUNTIME_REPO/$repo/cuda-keyring_1.1-1_all.deb"; \
            dpkg -i /tmp/cuda-keyring.deb; \
            rm /tmp/cuda-keyring.deb; \
            apt-get update; \
            apt-get install -y --no-install-recommends "$CUDA_CUFILE_PACKAGE" libnuma1; \
            test -e /usr/lib/"$(uname -m)"-linux-gnu/libnuma.so.1.0.0; \
            apt-get purge -y --auto-remove curl; \
            lib=$(dirname "$(find /usr/local -name 'libcufile.so.0' | head -n 1)"); \
            test -n "$lib" && test "$lib" != .; \
            echo "$lib" > /etc/ld.so.conf.d/racer-cufile.conf; \
            ldconfig; \
            ldconfig -p | grep -q 'libcufile.so.0'; \
            apt-get clean; \
            rm -rf /var/lib/apt/lists/* ;; \
        false) ;; \
        *) echo "RACER_NATIVE_CUDA must be true or false" >&2; exit 1 ;; \
    esac
# ca-certificates provides the default origin trust bundle
# (/etc/ssl/certs/ca-certificates.crt, override with RACER_ORIGIN_TRUST_BUNDLE).
# Kernel TLS (the `tls` module) is optional: without it origin HTTPS falls back
# to userspace rustls.
RUN set -eu; \
    case "$RACER_NATIVE_RDMA" in \
        true) set -- libnl-3-200 libnl-route-3-200 ;; \
        false) set -- ;; \
        *) echo "RACER_NATIVE_RDMA must be true or false" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends ca-certificates libgcc-s1 "$@"; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /run/racer /var/lib/racer/identity /var/lib/racer/slabs; \
    chown -R 65532:65532 /run/racer /var/lib/racer; \
    chmod 0700 /var/lib/racer/identity /var/lib/racer/slabs

# Install /unbounded/bin/racer and, with RDMA or CUDA, the verbs
# adapter and CUDA shim under /usr/local/lib where the dynamic loader finds it by soname.
COPY --from=builder /out/ /
# Pick up rdma-core and the verbs adapter under /usr/local/lib.
RUN ldconfig
COPY LICENSE NOTICE /unbounded/licenses/
# cuFile reads its configuration from CUFILE_ENV_PATH_JSON. Images built
# without CUDA never load cuFile, so the file and variable are inert there.
COPY images/racer/cufile.json /etc/racer/cufile.json
RUN ldconfig

ENV CUFILE_ENV_PATH_JSON=/etc/racer/cufile.json
ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

USER 65532:65532

# Peer HTTP, diagnostics, and elected control listeners. Clients use mounted UDS paths.
EXPOSE 7443 8082 8443 9443 9090
STOPSIGNAL SIGTERM

ENTRYPOINT ["/unbounded/bin/racer"]
