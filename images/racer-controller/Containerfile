# Build stage
# Pin the builder to BUILDPLATFORM so the Go toolchain runs natively on the
# host even when targeting a foreign TARGETPLATFORM.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.3-trixie AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY ../../ .

ARG TARGETOS
ARG TARGETARCH

ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make racer-controller-build VERSION=${VERSION} ${GIT_COMMIT:+GIT_COMMIT=${GIT_COMMIT}} ${BUILD_TIME:+BUILD_TIME=${BUILD_TIME}}

# Runtime stage
FROM ubuntu:noble

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /unbounded/bin

COPY --from=builder /src/bin/racer-controller /unbounded/bin/racer-controller
COPY LICENSE NOTICE /unbounded/licenses/

ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

# The controller runs unprivileged. deploy/racer also pins runAsUser 65532 so
# kubelet can hand it ownership of the projected replication token.
USER 65532:65532

# 8443 = control and replication API (HTTPS), 8081 = health probes, 8080 = metrics
EXPOSE 8443 8081 8080

ENTRYPOINT ["/unbounded/bin/racer-controller"]
