FROM golang:1.26.6 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY e2e/racer/fixture ./e2e/racer/fixture
RUN CGO_ENABLED=0 go build -trimpath -o /fixture ./e2e/racer/fixture/cmd
FROM scratch
COPY --from=build /fixture /fixture
ENTRYPOINT ["/fixture"]
