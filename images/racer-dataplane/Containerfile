ARG RUST_IMAGE=docker.io/library/rust:1.96.0-bookworm
ARG RUNTIME_IMAGE=ubuntu:noble
# Build stage
# Build on the target platform: both Rust and the verbs adapter use its ABI.
FROM ${RUST_IMAGE} AS builder
ARG RACER_NATIVE_RDMA=true
# Build the CUDA shim (libracer_gpu_cuda.so.1) and the `cuda` feature. The
# shim dlopens the driver at runtime, so only nvcc (for the decrypt kernel PTX)
# is installed here; the runtime image gets the driver from the NVIDIA runtime.
ARG RACER_NATIVE_CUDA=false
ARG CUDA_NVCC_PACKAGE=cuda-nvcc-12-9
ENV RUSTFLAGS="-C force-frame-pointers=yes"
WORKDIR /src

RUN case "$RACER_NATIVE_RDMA" in \
        true) apt-get update && apt-get install -y --no-install-recommends \
            libibverbs-dev pkg-config && rm -rf /var/lib/apt/lists/* ;; \
        false) ;; \
        *) echo "RACER_NATIVE_RDMA must be true or false" >&2; exit 1 ;; \
    esac

RUN set -eu; \
    case "$RACER_NATIVE_CUDA" in \
        true) \
            case "$(uname -m)" in \
                x86_64) repo=x86_64 ;; \
                aarch64) repo=sbsa ;; \
                *) echo "unsupported CUDA architecture $(uname -m)" >&2; exit 1 ;; \
            esac; \
            curl -fsSL -o /tmp/cuda-keyring.deb \
                "https://developer.download.nvidia.com/compute/cuda/repos/debian12/$repo/cuda-keyring_1.1-1_all.deb"; \
            dpkg -i /tmp/cuda-keyring.deb; \
            rm /tmp/cuda-keyring.deb; \
            apt-get update; \
            apt-get install -y --no-install-recommends "$CUDA_NVCC_PACKAGE"; \
            rm -rf /var/lib/apt/lists/* ;; \
        false) ;; \
        *) echo "RACER_NATIVE_CUDA must be true or false" >&2; exit 1 ;; \
    esac
ENV PATH="${PATH}:/usr/local/cuda/bin"

# Copy only build inputs, never host target trees or deployment credentials.
COPY cmd/racer-dataplane/Cargo.toml cmd/racer-dataplane/Cargo.lock ./
COPY cmd/racer-dataplane/src ./src
COPY cmd/racer-dataplane/control-wire/Cargo.toml ./control-wire/Cargo.toml
COPY cmd/racer-dataplane/control-wire/src ./control-wire/src
COPY cmd/racer-dataplane/controlplane/Cargo.toml ./controlplane/Cargo.toml
COPY cmd/racer-dataplane/controlplane/src ./controlplane/src
COPY cmd/racer-dataplane/peer-wire/Cargo.toml ./peer-wire/Cargo.toml
COPY cmd/racer-dataplane/peer-wire/src ./peer-wire/src
COPY cmd/racer-dataplane/object-wire/Cargo.toml ./object-wire/Cargo.toml
COPY cmd/racer-dataplane/object-wire/src ./object-wire/src
COPY cmd/racer-dataplane/runtime/Cargo.toml ./runtime/Cargo.toml
COPY cmd/racer-dataplane/runtime/src ./runtime/src
COPY cmd/racer-dataplane/alloc/Cargo.toml ./alloc/Cargo.toml
COPY cmd/racer-dataplane/alloc/src ./alloc/src
COPY cmd/racer-dataplane/flow/Cargo.toml ./flow/Cargo.toml
COPY cmd/racer-dataplane/flow/src ./flow/src
COPY cmd/racer-dataplane/crypto/Cargo.toml ./crypto/Cargo.toml
COPY cmd/racer-dataplane/crypto/src ./crypto/src
COPY cmd/racer-dataplane/verbs/Cargo.toml ./verbs/Cargo.toml
COPY cmd/racer-dataplane/verbs/src ./verbs/src
COPY cmd/racer-dataplane/verbs/native/verbs.c ./verbs/native/verbs.c
COPY cmd/racer-dataplane/gpu/Cargo.toml cmd/racer-dataplane/gpu/build.rs ./gpu/
COPY cmd/racer-dataplane/gpu/src ./gpu/src
COPY cmd/racer-dataplane/gpu/native ./gpu/native
COPY cmd/racer-dataplane/http/Cargo.toml ./http/Cargo.toml
COPY cmd/racer-dataplane/http/src ./http/src
COPY cmd/racer-dataplane/http/tests ./http/tests
COPY cmd/racer-dataplane/topology/Cargo.toml ./topology/Cargo.toml
COPY cmd/racer-dataplane/topology/src ./topology/src
COPY cmd/racer-dataplane/telemetry/Cargo.toml ./telemetry/Cargo.toml
COPY cmd/racer-dataplane/telemetry/src ./telemetry/src
COPY cmd/racer-dataplane/uds-endpoint/Cargo.toml ./uds-endpoint/Cargo.toml
COPY cmd/racer-dataplane/uds-endpoint/src ./uds-endpoint/src
COPY cmd/racer-dataplane/wire-codec/Cargo.toml ./wire-codec/Cargo.toml
COPY cmd/racer-dataplane/wire-codec/src ./wire-codec/src
COPY cmd/racer-dataplane/wire-codec/tests ./wire-codec/tests
COPY images/racer-dataplane/build-native.sh ./build-native.sh
COPY images/racer-dataplane/build-native-cuda.sh ./build-native-cuda.sh
COPY images/racer-dataplane/check-debug-info.sh ./check-debug-info.sh
RUN set -eu; \
    mkdir -p /out/unbounded/bin /out/usr/local/lib; \
    features=; \
    if [ "$RACER_NATIVE_RDMA" = true ]; then features=rdma; fi; \
    if [ "$RACER_NATIVE_CUDA" = true ]; then features="${features:+$features,}cuda"; fi; \
    cargo build --locked --release --bin racer-dataplane --no-default-features ${features:+--features "$features"}; \
    if [ "$RACER_NATIVE_RDMA" = true ]; then \
        sh ./build-native.sh verbs/native/verbs.c /out/usr/local/lib/librdma_verbs.so.1; \
    fi; \
    if [ "$RACER_NATIVE_CUDA" = true ]; then \
        RACER_GPU_REQUIRE_PTX=1 sh ./build-native-cuda.sh gpu/native /out/usr/local/lib/libracer_gpu_cuda.so.1; \
    fi; \
    sh ./check-debug-info.sh target/release/racer-dataplane; \
    install -m 0755 target/release/racer-dataplane /out/unbounded/bin/racer-dataplane

# Runtime stage
# ubuntu:noble like the other component images. The Debian bookworm builder
# links against an older glibc and libibverbs, and both keep backward-compatible
# symbol versions, so the binary and verbs adapter run on noble's newer ones.
FROM ${RUNTIME_IMAGE}
ARG RACER_NATIVE_RDMA=true
RUN set -eu; \
    case "$RACER_NATIVE_RDMA" in \
        true) set -- libibverbs1 ibverbs-providers ;; \
        false) set -- ;; \
        *) echo "RACER_NATIVE_RDMA must be true or false" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends libgcc-s1 "$@"; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /run/racer /var/lib/racer/identity /var/lib/racer/slabs; \
    chown -R 65532:65532 /run/racer /var/lib/racer; \
    chmod 0700 /var/lib/racer/identity /var/lib/racer/slabs

# Install /unbounded/bin/racer-dataplane and, with RDMA or CUDA, the verbs
# adapter and CUDA shim under /usr/local/lib where the dynamic loader finds it by soname.
COPY --from=builder /out/ /
COPY LICENSE NOTICE /unbounded/licenses/
RUN ldconfig

ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

USER 65532:65532

# Peer HTTP and loopback diagnostics. Client/origin traffic uses mounted UDS paths.
EXPOSE 7443 9090
STOPSIGNAL SIGTERM

ENTRYPOINT ["/unbounded/bin/racer-dataplane"]
