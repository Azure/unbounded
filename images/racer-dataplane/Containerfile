# Root context preserves build.rs's ../../api/racer schema path. Compile for the
# target platform so the C shim and libibverbs ABI match the Rust executable.
FROM docker.io/library/rust:1.96.0-trixie AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential perl libibverbs-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY api/racer/control.proto api/racer/control.proto
COPY cmd/racer-dataplane/Cargo.toml cmd/racer-dataplane/Cargo.lock cmd/racer-dataplane/build.rs cmd/racer-dataplane/
COPY cmd/racer-dataplane/src/ cmd/racer-dataplane/src/
COPY cmd/racer-dataplane/bench/ cmd/racer-dataplane/bench/
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME
ENV VERSION=${VERSION} GIT_COMMIT=${GIT_COMMIT}
RUN BUILD_TIME="${BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" \
    cargo build --manifest-path cmd/racer-dataplane/Cargo.toml --release --locked \
    --bin racer-dataplane

FROM docker.io/library/debian:trixie-slim
# Providers are loaded dynamically by libibverbs, even though HTTP is the default.
# /bin/sh is required by the operator's memlock/bootstrap/exec command.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates libibverbs1 ibverbs-providers \
    && rm -rf /var/lib/apt/lists/*
ARG VERSION=dev
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}"
COPY --from=builder /src/cmd/racer-dataplane/target/release/racer-dataplane /racer-dataplane
RUN ln -s /racer-dataplane /usr/local/bin/racer-dataplane
COPY LICENSE NOTICE /unbounded/licenses/
EXPOSE 9090 9443
ENTRYPOINT ["/racer-dataplane"]
