# Metalman machine image for Azure Linux 3.0 with the NVIDIA open GPU driver.
# ARM64 contains both kernel tracks and defaults unconditionally to kernel-hwe
# plus the Grace boot arguments. AMD64 keeps the existing single-HWE-kernel
# behavior.

FROM mcr.microsoft.com/azurelinux/base/core:3.0 AS rootfs
ARG TARGETARCH
ARG KERNEL_PACKAGE=kernel-hwe
ARG NVIDIA=1
ARG IMAGE_VARIANT=nvidia
COPY images/host-azurelinux3/assets/rootfs.sh /usr/local/bin/build-rootfs
COPY images/host-azurelinux3/assets/10_azure_nvidia /usr/local/share/unbounded/10_azure_nvidia
COPY images/host-azurelinux3/assets/51-azure-nvidia.cfg /usr/local/share/unbounded/51-azure-nvidia.cfg
COPY images/host-azurelinux3-nvidia/versions.env /usr/local/share/unbounded/versions.env
RUN set -a && . /usr/local/share/unbounded/versions.env && set +a && \
    TARGETARCH="${TARGETARCH}" KERNEL_PACKAGE="${KERNEL_PACKAGE}" NVIDIA="${NVIDIA}" \
    IMAGE_VARIANT="${IMAGE_VARIANT}" \
    sh /usr/local/bin/build-rootfs install
RUN set -a && . /usr/local/share/unbounded/versions.env && set +a && \
    TARGETARCH="${TARGETARCH}" KERNEL_PACKAGE="${KERNEL_PACKAGE}" NVIDIA="${NVIDIA}" \
    IMAGE_VARIANT="${IMAGE_VARIANT}" \
    sh /usr/local/bin/build-rootfs finish

FROM --platform=$BUILDPLATFORM docker.io/library/ubuntu:24.04 AS build
ARG TARGETARCH
ARG IMAGE_VARIANT=nvidia
RUN apt-get update && \
    ok=false && \
    for attempt in 1 2 3 4 5; do \
      if apt-get install -y --no-install-recommends \
           dosfstools e2fsprogs fdisk mtools pigz; then \
        ok=true; break; \
      fi; \
      echo "apt-get install failed (attempt $attempt/5), retrying in 30s..."; \
      sleep 30; \
      apt-get update; \
    done && $ok && \
    rm -rf /var/lib/apt/lists/*
COPY --from=rootfs /rootfs.tar /rootfs.kernels /
COPY images/host-azurelinux3/assets/disk.sh /usr/local/bin/build-disk
COPY images/host-azurelinux3/assets/grub-config.sh /usr/local/bin/write-grub-config
RUN TARGETARCH="${TARGETARCH}" IMAGE_VARIANT="${IMAGE_VARIANT}" \
    sh /usr/local/bin/build-disk && rm /rootfs.tar

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/Azure/unbounded" \
      org.opencontainers.image.description="Metalman machine image for Azure Linux 3.0 with NVIDIA GPU driver"
COPY --from=build /disk /disk
COPY LICENSE NOTICE /unbounded/licenses/
