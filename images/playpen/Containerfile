# Build stage
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.5-trixie AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY ../../ .

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make playpen-build VERSION=${VERSION} ${GIT_COMMIT:+GIT_COMMIT=${GIT_COMMIT}} ${BUILD_TIME:+BUILD_TIME=${BUILD_TIME}}

# Runtime stage
FROM ubuntu:noble

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    iproute2 \
    iputils-ping \
    ovmf \
    procps \
    qemu-efi-aarch64 \
    qemu-system-arm \
    qemu-system-x86 \
    qemu-utils \
    seabios \
    swtpm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Avoid host path-based AppArmor profiles intended for the host swtpm service.
RUN mkdir -p /unbounded/bin /run/playpen /var/lib/playpen \
    && cp /usr/bin/swtpm /unbounded/bin/swtpm

COPY --from=builder /src/bin/playpen /unbounded/bin/playpen

ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

ENTRYPOINT ["/unbounded/bin/playpen"]
