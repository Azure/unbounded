# Build stage
# Pin the builder to BUILDPLATFORM so the Go toolchain runs natively on the
# host even when targeting a foreign TARGETPLATFORM. Without this, buildkit
# would emulate the entire builder under QEMU when producing arm64 images on
# an amd64 runner, which makes "go build" painfully slow.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.6-trixie AS builder

# Install build dependencies. The base image already provides the Go
# toolchain at /usr/local/go/bin, so we don't install the apt golang package.
RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

# Set up Go environment.
# CGO is disabled because the inventory commands have no cgo imports; this also
# keeps cross-compilation simple (no cross C toolchain required).
ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

# Set working directory
WORKDIR /src

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY ../../ .

# TARGETOS/TARGETARCH are populated by buildkit from the requested
# --platform; threading them into go via GOOS/GOARCH lets the builder run
# natively on the host while still producing target-arch binaries.
ARG TARGETOS
ARG TARGETARCH

# VERSION/GIT_COMMIT/BUILD_TIME inject version metadata via ldflags.
#
# The defaults mirror internal/version's own defaults, and all three are passed
# to make unconditionally. A conditional ${VAR:+...} guard does not work here:
# an ARG declared with an empty default still enters the RUN environment as a
# set-but-empty variable, and make's ?= leaves it alone, stamping an empty
# string instead of falling back. The Makefile's git and date detection cannot
# rescue that either, since .dockerignore keeps .git out of the build context.
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make inventory-agent-build VERSION=${VERSION} GIT_COMMIT=${GIT_COMMIT} BUILD_TIME=${BUILD_TIME}

# Runtime stage
FROM ubuntu:noble

# Runtime dependencies.
#
# Unlike the other inventory images, the agent is not self-contained: its
# collectors shell out to host tooling, and a collector whose binary is absent
# reports nothing rather than failing. Each package below backs a specific
# collector, so removing one silently empties part of the inventory:
#
#   dmidecode  internal/inventory/agent/cpu.go, memory.go  (DMI processor/memory tables)
#   pciutils   internal/inventory/agent/gpu.go             (lspci device enumeration)
#   ethtool    internal/inventory/agent/network.go         (NIC driver and firmware)
#   kmod       internal/inventory/agent/disk.go, gpu.go    (modinfo driver versions)
#   udev       internal/inventory/agent/disk.go            (udevadm disk properties)
#   lldpd      internal/inventory/agent/lldp.go            (lldpctl switch neighbours)
#
# Two dependencies are deliberately not installed because they cannot be:
#
#   - The NVIDIA tools (nvidia-smi, nvidia-imex-ctl) ship with the host driver
#     and must be injected by the NVIDIA container runtime or a hostPath mount.
#     They are version-locked to the kernel driver, so bundling them here would
#     be wrong on every node whose driver did not match.
#   - lldpctl and udevadm are clients that talk to daemons over unix sockets
#     (/run/lldpd.socket and /run/udev). The pod needs those host paths mounted;
#     the package alone only supplies the client binary.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    dmidecode \
    ethtool \
    kmod \
    lldpd \
    pciutils \
    udev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create unbounded directory
RUN mkdir -p /unbounded/bin

# Copy the built binaries from the builder stage
COPY --from=builder /src/bin/inventory-agent /unbounded/bin/inventory-agent

# Add unbounded bin to PATH
ENV PATH="/unbounded/bin:${PATH}"

# Set working directory
WORKDIR /unbounded

# Default entrypoint
ENTRYPOINT ["/unbounded/bin/inventory-agent"]
