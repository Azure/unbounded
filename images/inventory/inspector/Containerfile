# Build stage
FROM docker.io/library/golang:1.26.5-trixie AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    git \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set up Go environment
ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

# Set working directory
WORKDIR /src

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy the rest of the source code
COPY . .

# VERSION is passed from the release workflow to inject version metadata via ldflags.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p bin && \
    go build -o bin/inventory-inspector ./cmd/inventory/inventory-inspector/main.go

# Runtime stage
FROM ubuntu:noble

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create unbounded directory
RUN mkdir -p /unbounded/bin

# Copy the built binaries from the builder stage
COPY --from=builder /src/bin/inventory-inspector /unbounded/bin/inventory-inspector

# Add unbounded bin to PATH
ENV PATH="/unbounded/bin:${PATH}"

# Set working directory
WORKDIR /unbounded

# Default entrypoint
ENTRYPOINT ["/unbounded/bin/inventory-inspector"]
