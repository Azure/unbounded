FROM docker.io/library/ubuntu:24.04 AS build

ARG TARGETARCH
ARG AZHPC_VHD_URL
ARG AZHPC_VHD_URL_AMD64
ARG AZHPC_VHD_URL_ARM64
ARG AZHPC_VHD_SHA256
ARG AZHPC_VHD_DESCRIPTION="Azure HPC VHD"

RUN apt-get update && \
    ok=false && \
    for attempt in 1 2 3 4 5; do \
      if apt-get install -y --no-install-recommends \
           ca-certificates curl pigz qemu-utils; then \
        ok=true; break; \
      fi; \
      echo "apt-get install failed (attempt $attempt/5), retrying in 30s..."; \
      sleep 30; \
      apt-get update; \
    done && $ok && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /disk && \
    set -eux; \
    vhd_url="${AZHPC_VHD_URL}"; \
    if [ -z "$vhd_url" ] && [ "${TARGETARCH}" = "amd64" ]; then vhd_url="${AZHPC_VHD_URL_AMD64}"; fi; \
    if [ -z "$vhd_url" ] && [ "${TARGETARCH}" = "arm64" ]; then vhd_url="${AZHPC_VHD_URL_ARM64}"; fi; \
    if [ -z "$vhd_url" ]; then \
        echo "AZHPC_VHD_URL, or AZHPC_VHD_URL_${TARGETARCH}, must point to an ${AZHPC_VHD_DESCRIPTION}" >&2; \
        exit 1; \
    fi; \
    curl -fSL --connect-timeout 10 --retry 3 --retry-delay 2 -o /tmp/azhpc.vhd "$vhd_url"; \
    if [ -n "${AZHPC_VHD_SHA256}" ]; then echo "${AZHPC_VHD_SHA256}  /tmp/azhpc.vhd" | sha256sum -c -; fi; \
    qemu-img convert -O raw /tmp/azhpc.vhd /tmp/disk.img; \
    rm /tmp/azhpc.vhd; \
    pigz -1 /tmp/disk.img; \
    mv /tmp/disk.img.gz /disk/disk.img.gz

FROM scratch
ARG AZHPC_IMAGE_DESCRIPTION="Metalman machine image for Azure HPC VHDs"
LABEL org.opencontainers.image.source="https://github.com/Azure/azhpc-images" \
      org.opencontainers.image.description="${AZHPC_IMAGE_DESCRIPTION}"
COPY --from=build /disk /disk
