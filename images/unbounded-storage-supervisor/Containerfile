# Supervisor build stage
# Pin the builder to BUILDPLATFORM so the Go toolchain runs natively on the
# host even when targeting a foreign TARGETPLATFORM. Without this, buildkit
# would emulate the entire builder under QEMU when producing arm64 images on
# an amd64 runner, which makes "go build" painfully slow.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.4-trixie AS builder

# Install build dependencies. The base image already provides the Go
# toolchain at /usr/local/go/bin, so we don't install the apt golang package.
RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

# Set up Go environment.
# CGO is disabled because the supervisor has no cgo imports; this also keeps
# cross-compilation simple (no cross C toolchain required).
ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

# Set working directory
WORKDIR /src

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY ../../ .

# TARGETOS/TARGETARCH are populated by buildkit from the requested
# --platform; threading them into go via GOOS/GOARCH lets the builder run
# natively on the host while still producing target-arch binaries.
ARG TARGETOS
ARG TARGETARCH

# VERSION/GIT_COMMIT/BUILD_TIME are passed in to inject version metadata via ldflags.
# Empty defaults let the Makefile fall back to its own git/date detection when callers
# don't supply explicit values; ${VAR:+...} forwards only when the caller set them.
ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make unbounded-storage-supervisor-build VERSION=${VERSION} ${GIT_COMMIT:+GIT_COMMIT=${GIT_COMMIT}} ${BUILD_TIME:+BUILD_TIME=${BUILD_TIME}}

# Storage release stage. This runs on TARGETPLATFORM so the tarball bundled
# into the runtime image matches the node architecture.
FROM --platform=$TARGETPLATFORM docker.io/library/golang:1.26.4-trixie AS storage-release

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    curl \
    bzip2 \
    perl \
    pkg-config \
    liburing-dev \
    libibverbs-dev \
    librdmacm-dev \
    && apt-get clean

ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=/root/.cargo/bin:$PATH:/go/bin

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

WORKDIR /src
COPY ../../ .

ARG TARGETARCH
ARG VERSION=dev
RUN make unbounded-storage-tarball STORAGE_TARBALL_ARCH=${TARGETARCH} VERSION=${VERSION}

# Runtime stage
FROM ubuntu:noble

ARG TARGETARCH

# Install runtime dependencies. The install workflow is implemented natively in
# Go (download, checksum, extract, systemd unit), so only ca-certificates is
# needed for verifying TLS when fetching release tarballs.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create unbounded directories
RUN mkdir -p /unbounded/bin /unbounded/releases

# Copy the built binary and default storage release tarball from the builder stages.
COPY --from=builder /src/bin/unbounded-storage-supervisor /unbounded/bin/unbounded-storage-supervisor
COPY --from=storage-release /src/dist/unbounded-storage-linux-${TARGETARCH}.tar.gz /unbounded/releases/unbounded-storage-linux-${TARGETARCH}.tar.gz

# Add unbounded bin to PATH
ENV PATH="/unbounded/bin:${PATH}"

# Set working directory
WORKDIR /unbounded

# The daemonset selects the install vs run role via the container args.
ENTRYPOINT ["/unbounded/bin/unbounded-storage-supervisor"]
