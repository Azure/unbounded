# Build stage
# Pin the builder to BUILDPLATFORM so the Go toolchain runs natively on the
# host even when targeting a foreign TARGETPLATFORM.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.3-trixie AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    make \
    gcc \
    git \
    ca-certificates \
    && apt-get clean

ENV CGO_ENABLED=0
ENV GOPATH=/go
ENV GOTOOLCHAIN=auto
ENV PATH=$PATH:/go/bin

WORKDIR /src

# Cache mount IDs match images/net/Containerfile so builds that share a
# BuildKit instance (such as the CI build-images job) reuse each other's
# module and build caches.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY ../../ .

ARG TARGETOS
ARG TARGETARCH

ARG VERSION=dev
ARG GIT_COMMIT=
ARG BUILD_TIME=
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build,id=go-build-${TARGETARCH} \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    make racer-object-build VERSION=${VERSION} ${GIT_COMMIT:+GIT_COMMIT=${GIT_COMMIT}} ${BUILD_TIME:+BUILD_TIME=${BUILD_TIME}}

# Runtime stage
FROM ubuntu:noble

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /unbounded/bin

COPY --from=builder /src/bin/racer-object /unbounded/bin/racer-object
COPY LICENSE NOTICE /unbounded/licenses/

ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

# The sidecar needs no root: Racer client sockets are mode 0666 and access is
# controlled by which hostPath directory the pod mounts.
USER 65532:65532

ENTRYPOINT ["/unbounded/bin/racer-object"]
