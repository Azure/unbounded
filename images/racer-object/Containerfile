ARG RUST_IMAGE=docker.io/library/rust:1.96.0-bookworm
ARG RUNTIME_IMAGE=ubuntu:noble

# Build stage
# Build on the target platform (no --platform=$BUILDPLATFORM): Cargo then
# compiles natively for the image architecture without a cross toolchain.
FROM ${RUST_IMAGE} AS builder
# Frame pointers keep perf and other stack samplers usable in production.
ENV RUSTFLAGS="-C force-frame-pointers=yes"
WORKDIR /src/cmd/racer-object

# Copy only the standalone crate so unrelated repository changes do not
# invalidate the build cache.
COPY cmd/racer-object/Cargo.toml cmd/racer-object/Cargo.lock ./
COPY cmd/racer-object/src ./src
RUN cargo build --locked --release && \
    install -D -m 0755 target/release/racer-object /out/racer-object

# Runtime stage
FROM ${RUNTIME_IMAGE}

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /unbounded/bin

COPY --from=builder /out/racer-object /unbounded/bin/racer-object
COPY LICENSE NOTICE /unbounded/licenses/

ENV PATH="/unbounded/bin:${PATH}"

WORKDIR /unbounded

# The sidecar needs no root: Racer client sockets are mode 0666 and access is
# controlled by which hostPath directory the pod mounts.
USER 65532:65532

ENTRYPOINT ["/unbounded/bin/racer-object"]
