---
apiVersion: v1
kind: ConfigMap
metadata:
  name: unbounded-storage-config
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: unbounded-storage-supervisor
    app.kubernetes.io/component: storage
# Cluster-wide daemon configuration. The single config.yaml key is the full
# unbounded-storage Config schema expressed as YAML (see
# api/unbounded-storage/config.proto and src/config/schema.rs); field names use
# the proto snake_case paths. The run supervisor unmarshals it into protobuf
# and renders the host config (binary protobuf at config.binpb). Unknown fields
# are rejected, so a typo fails the render loudly. Any field left unset keeps
# its proto3 zero value, which the daemon promotes to the documented default.
#
# Per-node sections are supervisor-injected when a storage ring is active:
# startup.fabric.binds.tcp.addr is overridden per node, self is set to the local
# Kubernetes node name, and label-discovered peers are merged into peers
# (discovered peers win name collisions). Declare caches here when this
# deployment should participate in P2P caching; the supervisor only supplies the
# ring roster.
#
# Choose either explicit disks[] or disk_discovery. Discovery selects only
# completely unused whole block devices: mounted, swap, partitioned, held,
# read-only, removable, virtual, or signature-bearing devices are excluded.
# deny_paths are exact block-device identities, so /dev symlinks are supported.
# The daemon continuously rescans /dev and falls back to the configured file
# while no safe device exists. Disk-set changes rehash cached stripes and are
# not data preserving.
#
# Without disk_discovery, explicit disks are preserved. When disks[] is absent
# or empty, block disks are allocated only from the opt-in
# storage.unbounded-cloud.io/allocated-disks annotation. Its value is a
# comma-separated list of item?query entries such as
# /dev/nvme1n1?queue_depth=256&page_size_bytes=4096&numa=0. When that annotation
# is absent or has no valid disks, the supervisor uses one file-backed disk at
# /var/lib/unbounded-storage/cache.disk sized by
# unbounded-cloud.io/storage-file-size-bytes, defaulting to 2 GiB. The daemon
# publishes broad inventory to storage.unbounded-cloud.io/block-devices as
# entries like /dev/sdb?name=sdb&size_bytes=1234. The shared disk set is
# available to every cache; the supervisor does not invent caches, backends, or
# frontends.
data:
  config.yaml: |
    # Operator-assigned config version (opaque counter; 0 means unversioned).
    version: 0

    # Opt-in discovery of all completely unused whole block devices. Populate
    # deny_paths to exclude exact device identities. The fallback parent must
    # already exist; /var/lib/unbounded-storage is created by the installer.
    # disk_discovery:
    #   deny_paths:
    #     - /dev/disk/by-id/example
    #   fallback:
    #     path: /var/lib/unbounded-storage/cache.disk
    #     size: 2147483648

    # Optional automatic P2P finger weighting. Omit topology_weighting to keep
    # historical hard-locality selection. When set, weight 0.0 is neutral,
    # positive values favor matching peers, and negative values penalize them.
    # tag_index 0 is the coarsest peer tag (region or datacenter); tag_index 1
    # is the next tag (zone or AZ). Successor and predecessor remain ring-nearest.
    # topology_weighting:
    #   prefix_weights:
    #     - tag_index: 0
    #       weight: 0.25
    #     - tag_index: 1
    #       weight: -0.5

    startup:
      memory:
        # Allocate per-shard backing from the heap instead of 2 MiB hugepages.
        no_hugepages: false
        # Node-wide shard data pool in bytes (128 MiB). Partial 2 MiB pages are
        # unused; RPC scratch adds 8 pages per fabric unit outside this pool.
        memory_total_bytes: 134217728
      fabric:
        tcp:
          # Per-shard TCP fabric listen address (":0" picks a free port).
          addr: "0.0.0.0:0"
        # libfabric progress threads per shard.
        progress_threads: 2
        # Progress-thread busy-poll budget in microseconds.
        progress_poll_us: 10
        # Fabric RPC worker threads per shard.
        rpc_worker_threads: 4
        # Max in-flight fabric operations per shard (back-pressure limit).
        max_inflight: 1024
      topology:
        # Place shards on SMT sibling CPUs as well as physical cores.
        use_smt_siblings: false
        # Schedule shards onto isolcpus-isolated CPUs too.
        ignore_isolated: false
        # Allow placing a shard on each NUMA node's CPU 0.
        include_node_cpu0: false
        # Use HCA ports that are not in the active state.
        allow_inactive_port: false
        # Disable RDMA and force the libfabric tcp provider.
        disable_rdma: false
        # Cap serving shards to fit the default data and RPC scratch budgets.
        serving_cores: 8
        # NIC-worker CPUs to pin per active HCA.
        nic_workers: 4
      metrics:
        # Prometheus exporter and device inventory listen address.
        addr: "127.0.0.1:9100"
