apiVersion: apps/v1
kind: Deployment
metadata:
  name: unbounded-karpenter-provider
  namespace: {{ default "unbounded-system" .Namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: unbounded-karpenter-provider
  template:
    metadata:
      labels:
        app: unbounded-karpenter-provider
    spec:
      serviceAccountName: unbounded-karpenter-provider
      containers:
        - name: controller
          image: {{ default "ghcr.io/azure/unbounded-karpenter-provider:latest" .Image }}
          imagePullPolicy: Always
          env:
            - name: KUBERNETES_MIN_VERSION
              value: "1.19.0-0"
            - name: KARPENTER_SERVICE
              value: unbounded-karpenter-provider
            - name: SYSTEM_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: METRICS_PORT
              value: "8080"
            - name: HEALTH_PROBE_PORT
              value: "8081"
            - name: MEMORY_LIMIT
              valueFrom:
                resourceFieldRef:
                  containerName: controller
                  resource: limits.memory
                  divisor: "1"
            - name: FEATURE_GATES
              value: "StaticCapacity=false,SpotToSpotConsolidation=false,NodeRepair=false,CapacityBuffer=false,PodDeletionCostManagement=false"
          ports:
            - name: metrics
              containerPort: 8080
            - name: health
              containerPort: 8081
          resources:
            requests:
              cpu: 200m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
