# ServiceAccount + RBAC for the gantry-snapshotter node agent.
#
# The snapshotter needs Kubernetes access for exactly one thing: the
# rendezvous election that decides which node converts a freshly pulled
# layer into an EROFS image and writes it into RACER. That election needs
# a view of the peer set, which is the same informer gantry already runs:
#   - pods (list/watch) in its own namespace, filtered by a label
#     selector, to enumerate peer agents.
#   - nodes (list/watch) cluster-wide for the zone label.
#
# Everything else the snapshotter does is node-local (block devices,
# device-mapper, mounts, the containerd socket) and needs no API access.
# An agent that loses its API credentials degrades to "every node is an
# eager ingester", which is correct but wastes work, so this RBAC is
# about efficiency rather than function.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry-snapshotter
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gantry-snapshotter
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry-snapshotter
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: gantry-snapshotter
  labels:
    app.kubernetes.io/name: gantry-snapshotter
rules:
  # Nodes - list/watch for the zone label, which scopes the rendezvous
  # election when it is configured with a zone scope.
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: gantry-snapshotter
  labels:
    app.kubernetes.io/name: gantry-snapshotter
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: gantry-snapshotter
subjects:
  - kind: ServiceAccount
    name: gantry-snapshotter
    namespace: {{ default "unbounded-system" .Namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: gantry-snapshotter
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry-snapshotter
rules:
  # Pods - list/watch only. Unlike the gantry agent, the snapshotter
  # never patches its own Pod: it advertises nothing, because peers do
  # not talk to it. The peer set exists purely to rank ingest work.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: gantry-snapshotter
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry-snapshotter
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: gantry-snapshotter
subjects:
  - kind: ServiceAccount
    name: gantry-snapshotter
    namespace: {{ default "unbounded-system" .Namespace }}
---
# Once containerd is pointed at this snapshotter, a node without the
# agent cannot start any pod that uses it: the snapshot API is a hard
# dependency of container creation, with no fallback path. That makes
# the agent node-critical in the same sense as a CSI node plugin, so it
# must never be preempted by the workloads that depend on it.
#
# This is a project-owned class rather than the built-in
# system-node-critical because the built-in names are reserved for
# cluster components and some admission configurations restrict where
# they may be used.
#
# The value is the highest a user-defined class may take: the API server
# rejects anything above 1000000000 (HighestUserDefinablePriority), so
# the two system classes cannot be reached from here. That ordering is
# the one we want anyway - kubelet, CNI, CSI and racer itself are this
# agent's dependencies and should win a tie against it - but it does
# mean the agent outranks every ordinary workload and nothing else.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: gantry-snapshotter-node-critical
value: 1000000000
globalDefault: false
description: "gantry-snapshotter node agent (pods cannot start without it)."
