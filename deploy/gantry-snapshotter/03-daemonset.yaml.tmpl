# gantry-snapshotter - Kubernetes DaemonSet (one agent per worker node).
#
# The snapshotter serves containerd's snapshot API over a unix socket and
# turns a RACER-backed shared image device into container rootfs mounts.
# See designs/gantry-snapshotter-design.md for the full picture.
#
# Deployment notes, all of them load bearing:
#
#   - privileged: true. The agent creates device-mapper linear targets
#     over the shared image device, calls mount(2) directly, and does
#     O_DIRECT block I/O on /dev/ublkb*. There is no capability subset
#     that covers this honestly: DM plus mount plus raw block access is
#     effectively root on the node. Treat this DaemonSet with the same
#     suspicion as a CSI node plugin.
#
#   - mountPropagation: Bidirectional on both hostPaths. Every image
#     layer is mounted by this container at
#     /var/lib/gantry-snapshotter/l/<name>. runc assembles container
#     rootfs in the host mount namespace, so those mounts MUST propagate
#     back out. Without Bidirectional the overlay lowerdirs resolve to
#     empty directories on the host and containers start with a rootfs
#     that is missing every cluster-supplied layer. This is the single
#     most common way to misconfigure this DaemonSet.
#
#   - The socket lives under the same hostPath, which is why containerd
#     can reach it at /run/gantry-snapshotter/snapshotter.sock.
#
#   - /run/racer is mounted read-only. It holds image-devices.json, the
#     operator-rendered description of which segment lives on which
#     /dev/ublkb* node. The agent only reads it, and re-reads it on a
#     timer, so an operator can grow the image volume without a
#     restart. If the file is absent the agent still serves: every
#     Prepare misses, containerd unpacks locally, and nothing is
#     ingested. That degradation is deliberate.
#
#   - The image needs mkfs.erofs (erofs-utils) and dmsetup (lvm2) on
#     PATH, so it cannot be distroless. It also needs a kernel with
#     CONFIG_EROFS_FS and CONFIG_BLK_DEV_DM. Nodes without them will
#     fail every mount; check before rolling this out.
#
#   - priorityClassName: gantry-snapshotter-node-critical. Once
#     containerd is configured to use this snapshotter, a node without
#     the agent cannot start any pod that uses it. Unlike the gantry
#     mirror, there is no graceful fallback, so the agent must not be
#     preemptible.
#
#   - runtimeClassName: gantry-bootstrap. The most load bearing line in
#     the file. It selects a containerd runtime handler pinned to
#     overlayfs, so this pod is the one pod on the node that does not
#     ask the gantry snapshotter to start it. Without it the agent
#     depends on a socket only the agent creates: survivable at install
#     time, fatal at the first reboot, because /run is tmpfs and the
#     socket is gone while the CRI default still points at it. kubelet
#     then asks an absent snapshotter to create the pod that would
#     provide it, and the node cannot start any pod again.
#
#     The handler must exist in /etc/containerd/config.toml on every
#     node before this DaemonSet is applied. See phase 1a of
#     deploy/gantry-snapshotter/containerd-config.toml.
#
#   - GANTRY_SNAPSHOTTER_MEMBERS_SELECTOR turns on the peer view that
#     ranks ingest work. With it unset every node is an eager ingester:
#     correct, but every node converts every layer, which wastes CPU
#     and burns catalog space on duplicate blobs that the segment
#     cleaner then has to reclaim.
#
# Apply with:
#   kubectl apply -f deploy/gantry-snapshotter/rendered/00-serviceaccount.yaml
#   kubectl apply -f deploy/gantry-snapshotter/rendered/01-runtimeclass.yaml
#   kubectl apply -f deploy/gantry-snapshotter/rendered/02-node-config.yaml
#   kubectl apply -f deploy/gantry-snapshotter/rendered/03-daemonset.yaml
#
# The containerd runtime handler the RuntimeClass names has to be in
# place first, and the CRI snapshotter default has to be flipped after
# the agent is running. 02-node-config.yaml is what does both, in that
# order, on every node; deploy/gantry-snapshotter/containerd-config.toml
# documents the same edits for anyone doing it by hand.
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: gantry-snapshotter
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry-snapshotter
    app.kubernetes.io/component: snapshotter
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: gantry-snapshotter
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      # Restarting the agent breaks the snapshot API for as long as the
      # socket is unbound, which stalls pod creation on that node. Keep
      # the blast radius small and the restart fast.
      maxUnavailable: 10%
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gantry-snapshotter
        app.kubernetes.io/component: snapshotter
    spec:
      serviceAccountName: gantry-snapshotter
      # Pins this pod to a containerd runtime handler backed by
      # overlayfs, so the agent is never started through the
      # snapshotter it provides. See the header.
      runtimeClassName: gantry-bootstrap
      # The agent talks to the API server for the peer view only. It
      # uses the Pod network for that; nothing dials the agent.
      hostNetwork: false
      dnsPolicy: ClusterFirst
      priorityClassName: gantry-snapshotter-node-critical
      tolerations:
        - operator: Exists
      # The snapshotter's whole value is the RACER-backed image device, which
      # only exists on a node running racer. Gating this on the same label the
      # racer DaemonSet uses also keeps it on exactly the set of nodes whose
      # containerd is reconfigured to require it, which is the property that
      # matters: a node pointed at a snapshotter that will never be scheduled
      # there cannot start pods at all.
      nodeSelector:
        racer.unbounded-cloud.io/active: "true"
      # Layer mounts and device-mapper targets are torn down lazily by
      # the next Cleanup sweep, not on shutdown, so the agent has
      # nothing slow to do on the way out. It only needs long enough to
      # drain in-flight snapshot RPCs.
      terminationGracePeriodSeconds: 30
      containers:
        - name: gantry-snapshotter
          image: {{ .Image }}
          imagePullPolicy: IfNotPresent
          args:
            - --socket=/run/gantry-snapshotter/snapshotter.sock
            - --root=/var/lib/gantry-snapshotter
            - --work-dir=/var/lib/gantry-snapshotter/ingest
            # Free bytes on the work filesystem an ingest refuses to
            # spend. Converting a layer needs about twice its own size
            # on disk at once, and the work directory is a hostPath on
            # the node's root filesystem, so an unbounded ingest evicts
            # pods that have nothing to do with it. Raise this above the
            # kubelet's nodefs eviction threshold on nodes with small
            # root disks; a node that refuses is not broken, it just
            # lets some other node ingest that layer.
            - --work-headroom={{ .WorkHeadroom | default "8589934592" }}
            - --devices=/run/racer/image-devices.json
            # Layer mounts sit under --root on purpose. containerd
            # shortens a long overlay lowerdir list by chdir-ing to the
            # directory every lower shares and passing the rest
            # relative; layer mounts parked under /run would share
            # nothing but / with the local snapshot directories, so a
            # stack that mixes cluster layers with locally unpacked ones
            # could not be shortened at all.
            - --map-root=/var/lib/gantry-snapshotter/l
            - --containerd-socket=/run/containerd/containerd.sock
            - --metrics-addr=:9096
          env:
            # Ranks this node in the per-layer ingest election.
            - name: GANTRY_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            # Scope the peer informer to wherever this DaemonSet was
            # actually installed, so a renamed namespace needs no
            # further edits.
            - name: GANTRY_SNAPSHOTTER_MEMBERS_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            # The component label is load-bearing, not decoration. The
            # node-config DaemonSet carries the same name label, and a
            # selector that matched it too would put every node in the
            # peer view twice. RankOf skips self and counts everyone
            # else, so a duplicated view does not lose a node, it
            # doubles every node's rank and therefore doubles every
            # ingest delay.
            - name: GANTRY_SNAPSHOTTER_MEMBERS_SELECTOR
              value: app.kubernetes.io/name=gantry-snapshotter,app.kubernetes.io/component=snapshotter
            # Only one node in the cluster needs to lay down the
            # catalog superblock, and the write is a compare-and-swap
            # on block zero, so it is safe to let every node try.
            - name: GANTRY_SNAPSHOTTER_FORMAT_CATALOG
              value: "true"
          ports:
            - name: metrics
              containerPort: 9096
              protocol: TCP
          # No readiness probe on purpose. A Pod that is not Ready is
          # still routed no traffic, which is meaningless here because
          # containerd reaches the agent over a hostPath socket, not a
          # Service. A liveness probe is what actually matters: pods on a
          # node whose snapshotter is wedged sit in ContainerCreating
          # forever, and nothing else notices.
          #
          # /healthz does not answer for itself. It dials the snapshotter
          # socket and asks for a snapshot that cannot exist, so it fails
          # if the listener stopped accepting, if the gRPC handlers are all
          # blocked, or if a bbolt transaction is never going to commit.
          # timeoutSeconds is above the agent's own 5s probe deadline so
          # the agent gets to report the failure rather than the kubelet
          # guessing at it.
          livenessProbe:
            httpGet:
              path: /healthz
              port: metrics
            initialDelaySeconds: 15
            periodSeconds: 30
            timeoutSeconds: 8
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
              # Scratch space for one layer conversion. This is a
              # request rather than a limit on purpose: the work
              # directory is a hostPath, and the kubelet charges local
              # ephemeral storage for emptyDir volumes, container
              # writable layers and logs, not for hostPath. A limit here
              # would never fire. The request is still worth setting,
              # because it takes the space out of the node's allocatable
              # pool so other pods do not plan on using it. The bound
              # that actually holds is --work-headroom above.
              ephemeral-storage: 16Gi
            limits:
              # An erofs build of a large layer is CPU and memory
              # hungry, and it runs while the node is also unpacking.
              # Being OOM killed mid-ingest is harmless (nothing is
              # published until the blob verifies) but it wastes the
              # work, so leave real headroom.
              cpu: "4"
              memory: 4Gi
          securityContext:
            privileged: true
            runAsUser: 0
            runAsGroup: 0
            # Everything the agent writes goes to a mounted volume.
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          volumeMounts:
            # Bidirectional: layer mounts made here must be visible on
            # the host, because runc builds container rootfs there.
            - name: run
              mountPath: /run/gantry-snapshotter
              mountPropagation: Bidirectional
            # Bidirectional for the same reason: --map-root lives here.
            - name: state
              mountPath: /var/lib/gantry-snapshotter
              mountPropagation: Bidirectional
            # The operator-rendered image device description.
            - name: racer
              mountPath: /run/racer
              readOnly: true
            # Block device nodes (/dev/ublkb*) and the device-mapper
            # control node.
            - name: dev
              mountPath: /dev
            # Read layer blobs from the content store so a node can
            # ingest a layer it never unpacked itself. The directory is
            # mounted rather than the socket itself: containerd unlinks
            # and recreates the socket when it restarts, and a bind mount
            # of the file would still resolve to the deleted inode, so
            # every later dial would be refused until this pod restarted.
            # node-config restarts containerd twice during install, so
            # mounting the file guarantees the agent can never ingest.
            - name: containerd-socket
              mountPath: /run/containerd
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: run
          hostPath:
            path: /run/gantry-snapshotter
            type: DirectoryOrCreate
        - name: state
          hostPath:
            path: /var/lib/gantry-snapshotter
            type: DirectoryOrCreate
        - name: racer
          hostPath:
            path: /run/racer
            type: DirectoryOrCreate
        - name: dev
          hostPath:
            path: /dev
            type: Directory
        - name: containerd-socket
          hostPath:
            path: /run/containerd
            type: Directory
        - name: tmp
          emptyDir: {}
