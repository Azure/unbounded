---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: metalman-controller
  namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: metalman-bootstrap
  namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: metalman-controller
  namespace: {{ default "unbounded-system" .Namespace }}
rules:
  # Leader election
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "create", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  # Bootstrap token creation (scoped to metalman-bootstrap SA)
  - apiGroups: [""]
    resources: ["serviceaccounts/token"]
    resourceNames: ["metalman-bootstrap"]
    verbs: ["create"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: metalman-controller
  namespace: {{ default "unbounded-system" .Namespace }}
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
# Allow metalman-controller to read cluster metadata ConfigMaps from kube-public.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: metalman-controller
  namespace: kube-public
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["cluster-info", "aks-cluster-metadata"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: metalman-controller
  namespace: kube-public
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
# Allow metalman-controller to read the kube-dns Service from kube-system.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: metalman-controller
  namespace: kube-system
rules:
  - apiGroups: [""]
    resources: ["services"]
    resourceNames: ["kube-dns"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: metalman-controller
  namespace: kube-system
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: metalman-controller
rules:
  # Machine controller
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines"]
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines/status"]
    verbs: ["get", "update"]
  # MachineOperation controller
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations"]
    verbs: ["get", "list", "watch", "delete", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations/finalizers"]
    verbs: ["update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations/status"]
    verbs: ["get", "update", "patch"]
  # Secrets (Redfish passwords)
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "watch"]
  # ConfigMaps (cloud-init user-data)
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch"]
  # Nodes (cloud provider detection and host replacement completion)
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman-controller
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: ClusterRole
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
# Allow bootstrap tokens issued for the metalman-bootstrap SA to create
# certificate signing requests (kubelet TLS bootstrap).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman:node-bootstrapper
subjects:
  - kind: ServiceAccount
    name: metalman-bootstrap
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: ClusterRole
  name: system:node-bootstrapper
  apiGroup: rbac.authorization.k8s.io

---
# Allow the metalman-bootstrap SA to read Machine CRs and publish initial agent
# bootstrap status. Metalman only issues these tokens to attested, pre-existing
# Machines, so the agent's register-machine phase never needs to create one.
#
# Kubelet client certificates requested with these tokens are NOT
# auto-approved. Machina approves them only for the node name of the single
# Machine whose status.bootstrap.credentialID matches the requesting token.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: metalman-bootstrap
rules:
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines"]
    verbs: ["get"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines/status"]
    verbs: ["get", "update", "patch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman:bootstrap-machine
subjects:
  - kind: ServiceAccount
    name: metalman-bootstrap
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: ClusterRole
  name: metalman-bootstrap
  apiGroup: rbac.authorization.k8s.io

---
# Restrict tokens minted for the metalman-bootstrap SA to their own Machine.
# RBAC cannot scope machines/status by name, so without this policy one
# attested node's token could rewrite any Machine's status, including the TPM
# endorsement key pinned on first attestation. Metalman records the token's
# credential ID (KEP-4193, "JTI=<jti>") in status.bootstrap.credentialID of
# the Machine it attested; only a request carrying that credential ID may
# update that Machine's status, and it may not change status.tpm or
# status.bootstrap. Writes to the main machines resource are denied outright.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: metalman-bootstrap-machine-restriction
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["unbounded-cloud.io"]
        apiVersions: ["*"]
        operations: ["CREATE", "UPDATE", "DELETE"]
        resources: ["machines", "machines/status"]
  matchConditions:
    - name: is-metalman-bootstrap-sa
      expression: "request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:metalman-bootstrap'"
  validations:
    - expression: "request.subResource == 'status'"
      message: "metalman-bootstrap tokens may not create, update, or delete Machines"
      reason: Forbidden
    - expression: >-
        request.subResource != 'status' ||
        (has(oldObject.status) && has(oldObject.status.bootstrap) &&
        has(oldObject.status.bootstrap.credentialID) &&
        oldObject.status.bootstrap.credentialID != '' &&
        'authentication.kubernetes.io/credential-id' in request.userInfo.extra &&
        oldObject.status.bootstrap.credentialID in request.userInfo.extra['authentication.kubernetes.io/credential-id'])
      message: "metalman-bootstrap tokens may only update the status of the Machine they were issued for"
      reason: Forbidden
    - expression: >-
        request.subResource != 'status' ||
        ((has(oldObject.status) && has(oldObject.status.tpm)) ?
        (has(object.status) && has(object.status.tpm) && object.status.tpm == oldObject.status.tpm) :
        !(has(object.status) && has(object.status.tpm)))
      message: "metalman-bootstrap tokens may not modify status.tpm"
      reason: Forbidden
    - expression: >-
        request.subResource != 'status' ||
        ((has(oldObject.status) && has(oldObject.status.bootstrap)) ?
        (has(object.status) && has(object.status.bootstrap) && object.status.bootstrap == oldObject.status.bootstrap) :
        !(has(object.status) && has(object.status.bootstrap)))
      message: "metalman-bootstrap tokens may not modify status.bootstrap"
      reason: Forbidden

---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: metalman-bootstrap-machine-restriction
spec:
  policyName: metalman-bootstrap-machine-restriction
  validationActions: ["Deny"]
