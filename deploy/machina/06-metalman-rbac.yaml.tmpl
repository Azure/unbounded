---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: metalman-controller
  namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: metalman-controller
  namespace: {{ default "unbounded-system" .Namespace }}
rules:
  # Leader election
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "create", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: metalman-controller
  namespace: {{ default "unbounded-system" .Namespace }}
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
# Allow metalman-controller to read cluster metadata ConfigMaps from kube-public.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: metalman-controller
  namespace: kube-public
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["cluster-info", "aks-cluster-metadata"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: metalman-controller
  namespace: kube-public
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
# Allow metalman-controller to read kube-dns and create short-lived,
# Machine-bound bootstrap tokens in kube-system.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: metalman-controller
  namespace: kube-system
rules:
  - apiGroups: [""]
    resources: ["services"]
    resourceNames: ["kube-dns"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["create"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: metalman-controller
  namespace: kube-system
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: metalman-controller
rules:
  # Machine controller
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines"]
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines/status"]
    verbs: ["get", "update"]
  # MachineOperation controller
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations"]
    verbs: ["get", "list", "watch", "delete", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations/finalizers"]
    verbs: ["update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations/status"]
    verbs: ["get", "update", "patch"]
  # Secrets (Redfish passwords)
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "watch"]
  # ConfigMaps (cloud-init user-data)
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch"]
  # Nodes (cloud provider detection and host replacement completion)
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman-controller
subjects:
  - kind: ServiceAccount
    name: metalman-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: ClusterRole
  name: metalman-controller
  apiGroup: rbac.authorization.k8s.io

---
# Replace the legacy shared bootstrap ServiceAccount subject with Metalman's
# dedicated bootstrap-token group.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman:node-bootstrapper
subjects:
  - kind: Group
    name: system:bootstrappers:metalman
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: ClusterRole
  name: system:node-bootstrapper
  apiGroup: rbac.authorization.k8s.io

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman:node-autoapprove-bootstrap
subjects: []
roleRef:
  kind: ClusterRole
  name: system:certificates.k8s.io:certificatesigningrequests:nodeclient
  apiGroup: rbac.authorization.k8s.io

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: metalman:bootstrap-machine
subjects: []
roleRef:
  kind: ClusterRole
  name: metalman-bootstrap
  apiGroup: rbac.authorization.k8s.io
