---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: machina-controller
  namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: machina-controller
  namespace: {{ default "unbounded-system" .Namespace }}
rules:
  # No ConfigMap rule here on purpose. The machina controller reads exactly one
  # ConfigMap, kube-root-ca.crt in kube-public (cluster_info.go), through the
  # uncached clientset, and that is covered by the cluster-wide configmaps get
  # in the ClusterRole below. machina-config reaches the pod as a volume mount,
  # which needs no RBAC, and leader election uses Leases. Granting namespaced
  # ConfigMap write here would let a compromised machina controller write
  # operator-owned ConfigMaps in this namespace.
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: machina-controller
  namespace: {{ default "unbounded-system" .Namespace }}
subjects:
  - kind: ServiceAccount
    name: machina-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: Role
  name: machina-controller
  apiGroup: rbac.authorization.k8s.io

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: machina-controller
rules:
  # Machine controller
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines/status"]
    verbs: ["get", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines/finalizers"]
    verbs: ["update"]
  # MachineConfiguration controller
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineconfigurations"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineconfigurations/status"]
    verbs: ["get", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineconfigurationversions"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineconfigurationversions/status"]
    verbs: ["get", "update", "patch"]
  # Secrets (SSH keys, bootstrap tokens)
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get", "list", "watch"]
  # Nodes
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch", "delete"]
  # ConfigMaps (kube-root-ca.crt in kube-public for CA cert resolution, cluster-info)
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get"]
  # Services (kube-dns in kube-system for cluster DNS resolution)
  - apiGroups: [""]
    resources: ["services"]
    verbs: ["get"]
  - apiGroups: ["certificates.k8s.io"]
    resources: ["certificatesigningrequests"]
    verbs: ["get", "list", "watch", "update"]
  - apiGroups: ["certificates.k8s.io"]
    resources: ["certificatesigningrequests/approval"]
    verbs: ["update"]
  # Approve daemon controller CSRs signed by the standard client signer.
  - apiGroups: ["certificates.k8s.io"]
    resources: ["signers"]
    resourceNames: ["kubernetes.io/kube-apiserver-client"]
    verbs: ["approve"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: machina-controller
subjects:
  - kind: ServiceAccount
    name: machina-controller
    namespace: {{ default "unbounded-system" .Namespace }}
roleRef:
  kind: ClusterRole
  name: machina-controller
  apiGroup: rbac.authorization.k8s.io
