# User-managed Gantry backing cache. Apply exactly one annotated cache to select
# Racer for operator-managed Gantry. The operator never creates or edits it.
apiVersion: racer.unbounded-cloud.io/v1alpha1
kind: ClusterCache
metadata:
  name: gantry
  annotations:
    unbounded-cloud.io/gantry-backing: "true"
spec:
  # Empty is required: every live Site participates, with Gantry on every node.
  siteSelector: {}
  cacheGeneration: 1
  maxCandidateAttempts: 3
