# Optional standalone Gantry/Racer integration. The operator creates this cache
# automatically from gantry-config; do not apply this example for other origins.
apiVersion: racer.unbounded-cloud.io/v1alpha1
kind: P2PCache
metadata:
  name: gantry
  labels:
    unbounded-cloud.io/gantry-cache: "true"
spec:
  # Every Racer-enabled Site must run Gantry on all its participating nodes.
  siteSelector: {}
  cacheGeneration: 1
  maxCandidateAttempts: 3
