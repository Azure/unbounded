# User-managed Gantry backing cache. The name gantry selects Racer for
# operator-managed Gantry. The operator never creates or edits this cache.
# Standalone installs may customize the name with --set RacerCacheName=<name>.
apiVersion: racer.unbounded-cloud.io/v1alpha1
kind: ClusterCache
metadata:
  name: {{ default "gantry" .RacerCacheName | quote }}
spec:
  # Empty is required: every live Site participates, with Gantry on every node.
  siteSelector: {}
  cacheGeneration: 1
  maxCandidateAttempts: 3
