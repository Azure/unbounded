# Strategic merge patch, not a standalone Kubernetes resource.
# Standalone only: render with --set RacerCacheUID=$(kubectl get clustercache gantry -o jsonpath='{.metadata.uid}').
# Without a UID this optional patch is empty. Operator-managed deployments use
# the ClusterCache gantry-backing annotation and generate the whole pod atomically.
{{ if .RacerCacheUID -}}
{{ if not (regexMatch "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$" .RacerCacheUID) -}}
{{ fail "RacerCacheUID must be the selected ClusterCache metadata.uid (1..63 lowercase alphanumeric/hyphen characters, alphanumeric edges)" }}
{{ end -}}
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: gantry
  namespace: {{ default "unbounded-system" .Namespace }}
spec:
  template:
    metadata:
      annotations:
        unbounded-cloud.io/gantry-cache-uid: {{ .RacerCacheUID | quote }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        supplementalGroups: [65532]
      initContainers:
        - name: chown-hostpaths
          command:
            - sh
            - -ec
            - |
              chown -R 65532:65532 /var/lib/gantry/libp2p
              chmod 0700 /var/lib/gantry/libp2p
              mkdir -p /run/racer/{{ .RacerCacheUID }}
              chgrp 65532 /run/racer /run/racer/{{ .RacerCacheUID }}
              chmod 2770 /run/racer /run/racer/{{ .RacerCacheUID }}
          volumeMounts:
            - name: racer-sockets
              mountPath: /run/racer
      containers:
        - name: gantry
          args:
            - agent
            - --config=/etc/gantry/config.yaml
            - --content-backend=racer
            - --racer-cache-uid={{ .RacerCacheUID }}
          ports:
            - containerPort: 5001
              $patch: delete
            - containerPort: 5002
              $patch: delete
          volumeMounts:
            - name: racer-sockets
              mountPath: /run/racer
      volumes:
        - name: racer-sockets
          hostPath:
            path: /run/racer
            type: DirectoryOrCreate
{{ end -}}
