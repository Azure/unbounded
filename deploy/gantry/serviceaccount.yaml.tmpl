# ServiceAccount + RBAC for the gantry agent.
#
# The agent's only Kubernetes access is the 64 fixed Lease chairs. It opens no
# watches and reads no Pods or Nodes.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gantry
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: gantry-agent
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
rules:
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "create", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: gantry-agent
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: gantry-agent
subjects:
  - kind: ServiceAccount
    name: gantry
    namespace: {{ default "unbounded-system" .Namespace }}
---
# Low priority class so the agent never displaces workload pods under
# cluster pressure. Containerd falls back to origin if the agent is
# absent, so a brief outage is workload-visible only as elevated
# origin pull rate.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: gantry-low
value: -1000
globalDefault: false
description: "gantry P2P distribution agent (preemptible under cluster pressure)."
