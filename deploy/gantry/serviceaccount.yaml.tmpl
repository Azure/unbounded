# ServiceAccount + RBAC for the gantry agent.
#
# The agent performs exact GET/update operations against a fixed Lease key space.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gantry
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: gantry-agent
  labels:
    app.kubernetes.io/name: gantry
# Intentionally empty. The name and binding are retained so that applying
# these manifests revokes the Node list/watch grant a previous release held,
# rather than leaving it in place because the object vanished from the
# desired set.
rules:
  []
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: gantry-agent
  labels:
    app.kubernetes.io/name: gantry
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: gantry-agent
subjects:
  - kind: ServiceAccount
    name: gantry
    namespace: {{ default "unbounded-system" .Namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: gantry-agent
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
rules:
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    resourceNames:
{{- range $slot := until (int (default 64 $.RendezvousSlotCount)) }}
      - {{ printf "gantry-rendezvous-%04d" $slot }}
{{- end }}
    verbs: ["get", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: gantry-agent
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: gantry-agent
subjects:
  - kind: ServiceAccount
    name: gantry
    namespace: {{ default "unbounded-system" .Namespace }}
---
# Low priority class so the agent never displaces workload pods under
# cluster pressure. Containerd falls back to origin if the agent is
# absent, so a brief outage is workload-visible only as elevated
# origin pull rate.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: gantry-low
value: -1000
globalDefault: false
description: "gantry P2P distribution agent (preemptible under cluster pressure)."
