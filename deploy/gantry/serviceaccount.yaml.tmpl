# ServiceAccount + RBAC for the gantry agent.
#
# The agent lists and updates the 64 fixed Lease chairs. It patches only its
# own pod metadata during rolling upgrades so older membership-based agents
# can continue to discover upgraded peers.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gantry
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: gantry-agent
  labels:
    app.kubernetes.io/name: gantry
rules:
  # Retained for old pods during a rolling upgrade. The Lease-chair binary
  # does not list or watch Nodes.
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: gantry-agent
  labels:
    app.kubernetes.io/name: gantry
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: gantry-agent
subjects:
  - kind: ServiceAccount
    name: gantry
    namespace: {{ default "unbounded-system" .Namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: gantry-agent
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
rules:
  # Retained for old pods during a rolling upgrade. The Lease-chair binary
  # only patches its own pod and does not list or watch Pods.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["list", "watch"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "create", "update"]
  # Self-announce: patch our own Pod's annotations with libp2p
  # peer.ID and transfer endpoint so peer agents can discover us
  # without operator-supplied bootstrap_peers config (§7.2, §7.3).
  # `patch` is namespace-scoped here so a compromised agent cannot
  # mutate cluster-wide resources.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: gantry-agent
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: gantry-agent
subjects:
  - kind: ServiceAccount
    name: gantry
    namespace: {{ default "unbounded-system" .Namespace }}
---
# Low priority class so the agent never displaces workload pods under
# cluster pressure. Containerd falls back to origin if the agent is
# absent, so a brief outage is workload-visible only as elevated
# origin pull rate.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: gantry-low
value: -1000
globalDefault: false
description: "gantry P2P distribution agent (preemptible under cluster pressure)."
