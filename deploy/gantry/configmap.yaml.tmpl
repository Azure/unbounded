# ConfigMap carrying the agent's runtime config.yaml.
#
# Field reference: internal/config/config.go. The values below are
# the defaults from config.NewDefault() with operator-friendly
# placeholders for the registry list.
#
# Mount: /etc/gantry/config.yaml in the agent container.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: gantry-config
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
data:
  config.yaml: |
    # ---------- Listeners ----------
    # Gantry owns no HTTP TCP listeners. The DaemonSet's narrowly scoped
    # proxy sidecars expose only the compatibility ports required by
    # containerd, peers, Prometheus, and kubelet probes.
    mirror_listen: "unix:///run/gantry/mirror.sock"
    mirror_bind_allow_non_loopback: false
    transfer_listen: "unix:///run/gantry/transfer.sock"
    transfer_advertise: "0.0.0.0:5001"
    metrics_listen: "unix:///run/gantry/ops.sock"

    # ---------- libp2p ----------
    # IPv4 wildcard listeners. The pods/patch self-announce only
    # publishes multiaddrs whose wildcard family matches the Pod IP
    # family - a /ip4/0.0.0.0 listener with a v6 Pod IP is silently
    # skipped because the kernel has no v6 socket to dial. For
    # dual-stack or v6-only clusters, append /ip6/::/ listeners
    # below; the agent will then publish /ip6/<podIP>/ multiaddrs
    # too. Example:
    #   libp2p_listen:
    #     - "/ip4/0.0.0.0/tcp/4001"
    #     - "/ip4/0.0.0.0/udp/4001/quic-v1"
    #     - "/ip6/::/tcp/4001"
    #     - "/ip6/::/udp/4001/quic-v1"
    libp2p_listen:
      - "/ip4/0.0.0.0/tcp/4001"
      - "/ip4/0.0.0.0/udp/4001/quic-v1"
    libp2p_identity_path: "/var/lib/gantry/libp2p/identity.key"

    # ---------- Members (k8s informer) ----------
    # node_name and members_namespace are filled from downward-API
    # env vars (GANTRY_NODE_NAME, GANTRY_MEMBERS_NAMESPACE) in the
    # DaemonSet manifest; YAML defaults keep them empty so the env
    # vars take precedence.
    members_label_selector: "app.kubernetes.io/name=gantry"

    # ---------- Storage backend (Plan §Phase 8) ----------
    # Containerd is the only supported backend; the legacy hostPath
    # cache was removed in Phase 8. Setting storage_mode: "gantry-cache"
    # produces a hard validation error pointing to the migration steps.
    storage_mode: "containerd"

    # ---------- containerd integration (cdsub, §5.4) ----------
    # Path to the host's containerd gRPC socket. Required: the agent
    # uses the containerd content store as the source of truth for
    # blobs (read + write).
    containerd_socket: "/run/containerd/containerd.sock"
    # Containerd namespace cdsub watches AND containerdstore reads/
    # writes from. "k8s.io" is what kubelet uses; switch to "moby"
    # for Docker-managed images.
    containerd_namespace: "k8s.io"
    # TTL of containerd content-store leases attached by Gantry on
    # ingest. Plan-recommended range: 30m–120m. Default 60m. Leases
    # protect newly-ingested blobs from containerd's garbage
    # collector until kubelet's own Image reference takes over.
    containerd_lease_ttl: "60m"
    # Period of the expired-lease sweep loop. Default 30m.
    containerd_lease_cleanup_interval: "30m"

    # ---------- Upstream registries (§7.1) ----------
    # Edit this list for each operator deployment. At least one
    # entry is required: origin.New fails fast on an empty list.
    #
    # Gantry discovers and relays the configured HTTPS registry's Basic or
    # Bearer challenge so containerd can authenticate with the pull credential
    # supplied by kubelet/CRI. credentials_path is OPTIONAL legacy
    # shared-identity mode; setting it skips requester challenge negotiation.
    # When you explicitly need shared Gantry credentials:
    #   1. copy deploy/gantry/examples/registry-secret.example.yaml
    #      to a private location, fill in your "username:password"
    #      pair keyed by the registry's `name:` field below, and
    #      apply the resulting Secret;
    #   2. add `credentials_path: "/etc/gantry/registry/<name>"`
    #      to the matching entry here.
    # The agent reads each credentials_path EAGERLY at startup
    # (origin.New); if the file is missing it returns a hard error,
    # which crashloops the pod. The DaemonSet's registry-creds
    # volume is `optional: true`, so a default ConfigMap that
    # references a non-existent credentials_path would let
    # Kubernetes start the pod and then crash the agent - the
    # default below is therefore credentials-free on purpose.
    upstream_registries:
      - name: "registry.example.com"
        endpoint: "https://registry.example.com"
        # credentials_path: "/etc/gantry/registry/registry.example.com"
      # - name: "ghcr.io"
      #   endpoint: "https://ghcr.io"
      #   credentials_path: "/etc/gantry/registry/ghcr.io"

    # ---------- HRW / coordination (§5.2) ----------
    hrw_k: 3
    hrw_topology_scope: "cluster"
    zone_label_key: "topology.kubernetes.io/zone"

    # Number of HRW-ranked pullers each prefetched layer digest is pulled by.
    # 1 designates a single origin puller (tightest dedup) but makes the whole
    # swarm fan out from ONE initial seed, which bottlenecks a cold
    # thundering-herd (peer transfers pile onto the lone seed and stall at the
    # peer_fetch_timeout). N>1 seeds the layer on the top-N pullers in
    # parallel, so peer transfers fan out N-fold, at the cost of up to N origin
    # copies of each layer. At 300 nodes N=8 keeps origin ~= N GiB per 1 GiB
    # layer (still >95% saved) while widening the initial fan-out 8x.
    prefetch_puller_replicas: 8
    # Coord peer authorization. Default false ships observe-only: an
    # inbound coord request from a peer not in the membership view only
    # increments p2p_coord_unauthorized_peer_total and is still served.
    # Flip to true to reject such requests only after peer-id
    # annotations are visible for every ready Gantry pod and the metric
    # stays at zero across a full DaemonSet rollout.
    coord_peer_authz_enforce: false
    # Max digests accepted in one please_pull batch. 256 is far above
    # normal manifest child counts while staying well below the 1 MiB
    # coord envelope limit.
    coord_max_digests_per_request: 256
    # Max background origin pulls an inbound please_pull can start on
    # one node. Each pull holds an HTTP body, containerd writer,
    # goroutine, and lease.
    coord_max_concurrent_pulls: 16
    # Deliberately SHORT. A requester stuck on a lockstep-saturated seed must
    # bail at this deadline and re-select a fresher finisher-seed rather than
    # ride the slow stream to completion; that bail-and-re-select (with the
    # strict containerd hosts.toml) drives the cold-start cascade. Too high
    # (e.g. 1h) removes re-selection and collapses to single-seed bandwidth
    # (the ~12min lockstep). Matches upstream gantry's hardcoded 60s.
    peer_fetch_timeout: "60s"
    # Peer re-discovery loop. On a cache miss the mirror repeatedly re-runs DHT
    # FindProviders and retries peer fetches for up to peer_rediscover_budget to
    # pick up finisher-seeds that advertise mid-swarm (the cold-start cascade),
    # instead of exhausting a fixed provider set and going to origin. "0"
    # disables re-discovery (single-shot attempt). Default 5m.
    # This IS a working cascade with the strict containerd hosts.toml shipped in
    # deploy/gantry/node-config.yaml (mirror-only, no origin fall-through): a
    # 429-shed request re-selects a fresher finisher-seed and, if exhausted,
    # retries Gantry rather than falling through to origin, so dedup holds.
    # Validated at 300 nodes: 99.67% (1 GiB) / 97.58% (8 GiB) origin reduction
    # with zero containerd origin bypass.
    peer_rediscover_budget: "5m"
    peer_rediscover_backoff: "1s"
    # Cap on concurrent peer blob-body serves; over the cap returns 429 with a
    # Retry-After hint so the requester re-selects a fresher finisher-seed
    # instead of queueing behind a saturated seed. This load-shedding is what
    # lets the first finishers complete early and seed the swarm ("leaders make
    # leaders"). "0" means unlimited. Default 100. Requires the strict
    # containerd hosts.toml (shipped in deploy/gantry/node-config.yaml) so a
    # shed request retries Gantry rather than falling through to origin.
    transfer_max_concurrent_serves: 100
    # Cadence of the background DHT advertiser inventory reconcile. Eager
    # per-digest advertise on stream completion is the fast path that makes
    # finishers discoverable within milliseconds; this reconcile is the
    # backstop for missed events and withdraws.
    advertise_reconcile_interval: "1m"

    # ---------- DHT / NF5 (§7.7) ----------
    nf5_jitter_base: "3s"
    nf5_per_node_rate_limit: 2
    bootstrap_window: "30s"
    bootstrap_routing_table_pct: 25
    topk_expansion_factor_degraded: 2

    # ---------- Origin-failure circuit breaker (§5.8) ----------
    origin_failure_cooldown_initial: "5s"
    origin_failure_cooldown_max: "5m"
    origin_failure_cooldown_multiplier: 2
    origin_failure_honor_window_cap: "30s"
    origin_failure_classes_trusted_cluster_wide:
      - "auth"
      - "not_found"
      - "rate_limited"

    # ---------- Logging ----------
    log_level: "debug"
    log_format: "json"
