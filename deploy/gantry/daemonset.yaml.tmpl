# gantry - Kubernetes DaemonSet (one agent per worker node).
#
# §Phase 6 design notes:
#   - hostNetwork: false (§7.5) - pods use the cluster Pod network and
#     dial each other directly via Pod IPs. peering ports (5001 +
#     libp2p) are restricted by the optional hardening overlay in
#     deploy/gantry/examples/networkpolicy.yaml (see the Production
#     Security section of docs/content/guides/gantry.md - the overlay
#     is NOT part of the default install).
#   - hostPath mounts:
#       /var/lib/gantry/libp2p  - persistent libp2p identity key, so
#                                  the same peer ID survives restarts
#                                  and DHT routing tables don't churn.
#       /run/containerd/containerd.sock - containerd CRI socket; the
#                                  agent reads and writes the content
#                                  store directly (Plan §Phase 8).
#                                  The hostPath /var/lib/gantry/cache
#                                  volume was REMOVED in Phase 8 - the
#                                  agent no longer maintains its own
#                                  blob cache; containerd is the
#                                  source of truth.
#   - Mirror port (5000) is exposed via a hostPort with
#     hostIP: 127.0.0.1, so the host-side endpoint is loopback-only;
#     containerd reaches it through the hosts.toml entry. Inside the
#     pod the agent binds 0.0.0.0:5000 (configmap.yaml has
#     mirror_bind_allow_non_loopback: true) because kube-proxy /
#     portmap DNAT delivers the traffic to <podIP>:5000, not the
#     pod's loopback. If you apply the optional NetworkPolicy
#     hardening overlay, the operator MUST allow ingress on TCP/5000
#     from the node CIDR (the overlay's default 127.0.0.1/32
#     placeholder will drop mirror traffic on most CNIs because
#     after DNAT the pod observes source = node IP, not 127.0.0.1).
#   - Resource requests are placeholders (NF6 validation pending).
#     Size them after observing real workload pressure:
#       * CPU/memory: `kubectl top pod -l app.kubernetes.io/name=gantry`.
#       * Network throughput: peer-fetch + origin-pull bandwidth via
#         `p2p_peer_fetch_total`, `p2p_origin_pull_success_total`,
#         and your CNI's per-pod byte counters.
#       * In-flight pull concurrency: `p2p_in_flight_pulls`
#         (high water mark drives the file-descriptor / goroutine
#         budget; one streaming origin pull holds an open HTTP body
#         and one containerd ingest writer).
#       * Containerd content-store pressure: `gantry_containerd_lease_active`
#         and `gantry_containerd_lease_released_total` track how many
#         blobs Gantry is keeping pinned at any one time; cross-check
#         with node disk pressure / containerd GC logs to ensure the
#         configured `containerd_lease_ttl` is not over-retaining.
#       * Storage backend health: `gantry_containerd_unavailable_total`
#         and `gantry_containerd_open_error_total` flag containerd-side
#         saturation independently of Gantry's CPU/memory.
#   - The optional fallback registry-credentials Secret is mounted read-only
#     into /etc/gantry/registry; CredentialsPath in the agent config points at
#     files inside it. Request-scoped Basic/Bearer challenge negotiation does
#     not use this Secret; mounting it opts into legacy shared-identity mode.
#
# Apply with:
#   kubectl apply -f deploy/gantry/serviceaccount.yaml
#   kubectl apply -f deploy/gantry/configmap.yaml
#   # Optional shared identity: apply an edited private copy of
#   # deploy/gantry/examples/registry-secret.example.yaml first.
#   kubectl apply -f deploy/gantry/daemonset.yaml
#
# After verifying rollout, optionally harden with:
#   # 1. Copy deploy/gantry/examples/networkpolicy.yaml into your own overlay
#   # 2. Edit every "OPERATOR ACTION REQUIRED" ipBlock
#   # 3. kubectl apply -f <your-overlay>/networkpolicy.yaml
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: gantry
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: gantry
    app.kubernetes.io/component: agent
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: gantry
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      # Limit blast radius: at most 10% of nodes lose their agent at
      # any one time during an update. The mirror endpoint is per-node
      # and containerd falls back to origin on connection failure, so
      # a node losing its agent only affects pulls happening during
      # the window.
      maxUnavailable: 10%
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gantry
        app.kubernetes.io/component: agent
    spec:
      serviceAccountName: gantry
      # Disabling hostNetwork is a deliberate §7.5 decision: the agent
      # is reached on its Pod IP by other agents (libp2p) and on
      # 127.0.0.1 by the local containerd via hosts.toml.
      hostNetwork: false
      dnsPolicy: ClusterFirst
      # Run as low priority so workload pods can preempt during
      # cluster pressure. The agent's failure mode (containerd falls
      # back to origin) is graceful.
      priorityClassName: gantry-low
      tolerations:
        - operator: Exists
      terminationGracePeriodSeconds: 30
      # initContainer: hostPath volumes are created as root:root by the
      # kubelet (DirectoryOrCreate) and we run the agent as a non-root
      # user (UID/GID 65532). Without this step the agent fails on its
      # first write to /var/lib/gantry/libp2p.
      # fsGroup doesn't help here because hostPath volumes don't honour
      # it, so we chown explicitly.
      #
      # We use busybox (not the gantry distroless image) because the
      # production image is built FROM gcr.io/distroless/static-debian12
      # which intentionally has no shell, no `chown`, and no `chmod`.
      # Pinning to a fixed busybox tag keeps this step reproducible.
      initContainers:
        - name: chown-hostpaths
          image: mcr.microsoft.com/cbl-mariner/busybox:2.0
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -eu
              chown -R 65532:65532 /var/lib/gantry/libp2p
              chmod 0700 /var/lib/gantry/libp2p
          securityContext:
            runAsNonRoot: false
            runAsUser: 0
            runAsGroup: 0
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
              add: ["CHOWN", "FOWNER", "DAC_OVERRIDE"]
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 32Mi
          volumeMounts:
            - name: libp2p
              mountPath: /var/lib/gantry/libp2p
      containers:
        - name: gantry
          image: ghcr.io/vpatelsj/gantry:latest   # override via make image-gantry-local/push (GANTRY_IMAGE)
          imagePullPolicy: IfNotPresent
          args:
            - agent
            - --config=/etc/gantry/config.yaml
          env:
            # NODE_NAME -> membership informer's "self" lookup (§7.3).
            - name: GANTRY_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            # POD_NAME -> self-patch annotations with libp2p peer.ID
            # and transfer endpoint so peers discover us via members
            # informer (§7.2, §7.3).
            - name: GANTRY_POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            # POD_IP -> used by self-announce to rewrite the 0.0.0.0
            # listeners into routable advertised addresses. Without
            # this, peers see /ip4/0.0.0.0/tcp/4001 in our
            # gantry.io/p2p-addrs annotation and cannot dial back.
            - name: GANTRY_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            # MEMBERS_NAMESPACE -> scope the pod informer that
            # enumerates peer agents. Sourced from the downward API
            # (metadata.namespace) rather than hard-coded to the
            # install namespace so an overlay that renames the namespace
            # (Kustomize, Helm, separate dev/prod installs) only has
            # to patch metadata.namespace on the DaemonSet - the env
            # var follows automatically. Default install behaviour
            # is identical because the DaemonSet ships in
            # unbounded-system.
            - name: GANTRY_MEMBERS_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          ports:
            # mirror (loopback only) - listed here for documentation.
            - name: mirror
              containerPort: 5000
              hostPort: 5000
              hostIP: 127.0.0.1
              protocol: TCP
            - name: transfer
              containerPort: 5001
              protocol: TCP
            - name: libp2p-tcp
              containerPort: 4001
              protocol: TCP
            - name: metrics
              containerPort: 9095
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /readyz
              port: metrics
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /livez
              port: metrics
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "2"
              memory: 1Gi
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            # Most Linux nodes expose /run/containerd/containerd.sock as
            # root:root 0660. Gantry still runs with non-root UID 65532,
            # but uses primary GID 0 so the mounted socket is accessible
            # on those default nodes. Clusters with a dedicated containerd
            # socket group should patch runAsGroup/fsGroup accordingly.
            runAsGroup: 0
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
            seccompProfile:
              type: RuntimeDefault
          volumeMounts:
            - name: libp2p
              mountPath: /var/lib/gantry/libp2p
            - name: config
              mountPath: /etc/gantry
              readOnly: true
            - name: registry-creds
              mountPath: /etc/gantry/registry
              readOnly: true
            - name: tmp
              mountPath: /tmp
            # containerd socket is consumed as Gantry's node-local
            # source of truth. Gantry reads content/images for
            # inventory, serves peer transfer from the content store,
            # writes background please_pull content, and creates
            # Gantry-managed leases. Treat this mount as privileged
            # read/write access to the node's containerd API; UNIX
            # socket mounts cannot provide Kubernetes-style read-only
            # API scoping, so protection lives at the host/network
            # boundary instead.
            # Operators whose node uses a non-default socket path can
            # override via GANTRY_CONTAINERD_SOCKET or in the ConfigMap.
            #
            # Permissions caveat: containerd.sock is typically owned
            # by root:root mode 0660. Because the pod runs as
            # nonroot (UID 65532), operators must either:
            #   (a) set spec.template.spec.securityContext.fsGroup
            #       to a group that has access (e.g. the host
            #       containerd group); the default deploy uses
            #       primary GID 0, which works with the common
            #       root:root 0660 socket layout, or
            #   (b) relax socket perms on the node.
            # Disabling the socket is NOT supported: storage_mode=
            # containerd is the only accepted mode and readyz pings
            # the containerd content store, so an unreachable socket
            # keeps the pod permanently 503.
            - name: containerd-socket
              mountPath: /run/containerd/containerd.sock
      volumes:
        - name: libp2p
          hostPath:
            path: /var/lib/gantry/libp2p
            type: DirectoryOrCreate
        - name: config
          configMap:
            name: gantry-config
        - name: registry-creds
          secret:
            secretName: gantry-registry-credentials
            optional: true
        - name: tmp
          emptyDir: {}
        - name: containerd-socket
          hostPath:
            path: /run/containerd/containerd.sock
            type: Socket
