{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "namespace",
    "manager",
    "nodeSelector",
    "tolerations",
    "containerd",
    "nodeConfig",
    "overlaybdConfig",
    "registryCredentials",
    "resources",
    "gantry"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "const": false
        }
      }
    },
    "manager": {
      "type": "string",
      "enum": [
        "helm"
      ]
    },
    "nodeSelector": {
      "type": "object",
      "required": [
        "kubernetes.io/os"
      ],
      "properties": {
        "kubernetes.io/os": {
          "const": "linux"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "containerd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPath",
        "mountPath",
        "socketPath",
        "namespace",
        "socketGroup"
      ],
      "properties": {
        "hostPath": {
          "type": "string",
          "pattern": "^/"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "socketPath": {
          "type": "string",
          "pattern": "^/"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "socketGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nodeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hostPath",
        "reconcileIntervalSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostPath": {
          "type": "string",
          "pattern": "^/"
        },
        "reconcileIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "overlaybdConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "address",
        "logLevel",
        "image",
        "nodeSelector",
        "tolerations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "address": {
          "type": "string",
          "pattern": "^http://localhost:[0-9]+/blobs$"
        },
        "logLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "reference": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[0-9a-f]{64})$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "registryCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "init",
        "nodeConfig",
        "overlaybdConfig"
      ],
      "properties": {
        "agent": {
          "type": "object"
        },
        "init": {
          "type": "object"
        },
        "nodeConfig": {
          "type": "object"
        },
        "overlaybdConfig": {
          "type": "object"
        }
      }
    },
    "gantry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "pprofListen",
        "artifactStreaming",
        "upstreamRegistries"
      ],
      "properties": {
        "config": {
          "type": "string"
        },
        "pprofListen": {
          "type": "string"
        },
        "artifactStreaming": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "allowedHostSuffixes",
            "peerLookupTimeout",
            "maxPeerAttempts",
            "maxConcurrentOriginReads",
            "originResponseHeaderTimeout"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowedHostSuffixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "peerLookupTimeout": {
              "type": "string",
              "minLength": 1
            },
            "maxPeerAttempts": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrentOriginReads": {
              "type": "integer",
              "minimum": 1
            },
            "originResponseHeaderTimeout": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "upstreamRegistries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "endpoint"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "pattern": "^https?://"
              },
              "credentialsPath": {
                "type": "string"
              },
              "namespaceAlias": {
                "type": "string"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "config": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "upstreamRegistries": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
