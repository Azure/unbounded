{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "namespace",
    "manager",
    "updateStrategy",
    "nodeSelector",
    "tolerations",
    "containerd",
    "nodeConfig",
    "metricsService",
    "registryCredentials",
    "resources",
    "gantry"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "const": false
        }
      }
    },
    "manager": {
      "type": "string",
      "enum": [
        "helm"
      ]
    },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollingUpdate"
      ],
      "properties": {
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxUnavailable"
          ],
          "properties": {
            "maxUnavailable": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^([1-9][0-9]?|100)%$"
                }
              ]
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "required": [
        "kubernetes.io/os"
      ],
      "properties": {
        "kubernetes.io/os": {
          "const": "linux"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "containerd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPath",
        "mountPath",
        "socketPath",
        "namespace",
        "socketGroup"
      ],
      "properties": {
        "hostPath": {
          "type": "string",
          "pattern": "^/"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "socketPath": {
          "type": "string",
          "pattern": "^/"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "socketGroup": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nodeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hostPath",
        "reconcileIntervalSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostPath": {
          "type": "string",
          "pattern": "^/"
        },
        "reconcileIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metricsService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "registryCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "init",
        "nodeConfig"
      ],
      "properties": {
        "agent": {
          "type": "object"
        },
        "init": {
          "type": "object"
        },
        "nodeConfig": {
          "type": "object"
        }
      }
    },
    "gantry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "pprofListen",
        "chairCount",
        "chairSeedCount",
        "peerFetchTimeout",
        "transferMaxConcurrentServes",
        "upstreamRegistries"
      ],
      "properties": {
        "config": {
          "type": "string"
        },
        "pprofListen": {
          "type": "string"
        },
        "chairCount": {
          "type": "integer",
          "minimum": 1
        },
        "chairSeedCount": {
          "type": "integer",
          "minimum": 1
        },
        "peerFetchTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "transferMaxConcurrentServes": {
          "type": "integer",
          "minimum": 0
        },
        "cachemesh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "expectedSize": {
              "type": "integer",
              "minimum": 0
            },
            "maxNeighbors": {
              "type": "integer",
              "minimum": 0
            },
            "cellSize": {
              "type": "integer",
              "minimum": 0
            },
            "partitionBits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "chunkSize": {
              "type": "integer",
              "minimum": 0
            },
            "diskCacheBytes": {
              "type": "integer",
              "minimum": 0
            },
            "chunkDirSizeLimit": {
              "type": "string"
            },
            "memoryCacheBytes": {
              "type": "integer",
              "minimum": 0
            },
            "pageSize": {
              "type": "integer",
              "minimum": 0
            },
            "fillPages": {
              "type": "integer",
              "minimum": 0
            },
            "pageCache": {
              "type": "string",
              "enum": ["", "bypass", "drop", "keep"]
            },
            "persist": {
              "type": "string",
              "enum": ["", "all", "shared"]
            },
            "lookahead": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "maxConcurrentChunkFills": {
              "type": "integer",
              "minimum": 0
            },
            "maxConcurrentChunkServes": {
              "type": "integer",
              "minimum": 0
            },
            "chunkTimeout": {
              "type": "string",
              "pattern": "^(|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
            },
            "chunkStallTimeout": {
              "type": "string",
              "pattern": "^(|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
            },
            "chunkAttempts": {
              "type": "integer",
              "minimum": 0
            },
            "metadataTTL": {
              "type": "string",
              "pattern": "^(|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
            },
            "cacheTags": {
              "type": "boolean"
            },
            "verifyDigest": {
              "type": "boolean"
            },
            "hedge": {
              "type": "boolean"
            },
            "leaseName": {
              "type": "string"
            }
          }
        },
        "upstreamRegistries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "endpoint"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "pattern": "^https?://"
              },
              "credentialsPath": {
                "type": "string"
              },
              "namespaceAlias": {
                "type": "string"
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "config": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "upstreamRegistries": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
