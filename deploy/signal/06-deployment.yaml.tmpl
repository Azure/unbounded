apiVersion: apps/v1
kind: Deployment
metadata:
  name: project-signal-controller
  namespace: {{ default "project-signal" .Namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: project-signal-controller
  template:
    metadata:
      labels:
        app.kubernetes.io/name: project-signal-controller
    spec:
      serviceAccountName: project-signal-controller
      containers:
        - name: controller
          image: {{ default "example.invalid/project-signal-controller:replace-me" .ControllerImage }}
          imagePullPolicy: IfNotPresent
          args:
            - --namespace={{ default "project-signal" .Namespace }}
            - --script-namespace={{ default "project-signal" .Namespace }}
            - --leader-elect=true
{{- if .RecoveryVerifierSecret }}
            - --recovery-verifier-public-key-file=/var/run/project-signal-recovery/public-key
{{- end }}
          ports:
            - name: metrics
              containerPort: 8080
            - name: health
              containerPort: 8081
          resources:
            requests:
              cpu: 50m
              memory: 96Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: [ALL]
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
{{- if .RecoveryVerifierSecret }}
          volumeMounts:
            - name: recovery-verifier-public-key
              mountPath: /var/run/project-signal-recovery
              readOnly: true
      volumes:
        - name: recovery-verifier-public-key
          secret:
            secretName: {{ .RecoveryVerifierSecret }}
            items:
              - key: public-key
                path: public-key
{{- end }}
