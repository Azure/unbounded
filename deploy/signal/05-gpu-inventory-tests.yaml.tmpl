kind: CertificationTest
metadata:
  name: project-signal-gpu-inventory-compat-v1
  labels:
    app.kubernetes.io/name: project-signal-gpu-inventory
    app.kubernetes.io/part-of: project-signal
    signal.unbounded-cloud.io/catalog-role: compatibility-diagnostic
spec:
  displayName: GPU inventory compatibility diagnostic
  description: Compatibility-only alias for ordered legacy R01-R15 diagnostics; it must never receive qualification trust.
  owner: project-signal
  version: "1"
  tags: [gpu, inventory, compatibility, diagnostic]
  metrics:
    - name: nvidiaSmiAvailable
      displayName: nvidia-smi available
      type: Boolean
      required: true
    - name: observedGpuCount
      displayName: Observed GPU count
      type: Count
      unit: devices
      required: true
    - name: driverVersionSet
      displayName: Driver version consistency
      type: Status
      required: true
  topology:
    minParticipants: 1
    maxParticipants: 1
  driver:
    type: Script
    script:
      language: Shell
      source:
        type: ConfigMap
        configMap:
          name: project-signal-gpu-inventory-v1
          key: gpu-inventory.sh
          digest: {{ $scriptDigest }}
      runnerImage: {{ $runnerImage }}
      resources:
        requests:
          cpu: 100m
          memory: 64Mi
          nvidia.com/gpu: "8"
        limits:
          cpu: 500m
          memory: 128Mi
          nvidia.com/gpu: "8"
