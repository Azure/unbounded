apiVersion: apps/v1
kind: Deployment
metadata:
  name: project-signal-dashboard
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-dashboard
    app.kubernetes.io/part-of: project-signal
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: project-signal-dashboard
  template:
    metadata:
      labels:
        app.kubernetes.io/name: project-signal-dashboard
        app.kubernetes.io/part-of: project-signal
    spec:
      serviceAccountName: project-signal-dashboard
      containers:
        - name: dashboard
          image: {{ default "example.invalid/project-signal-dashboard:replace-me" .DashboardImage }}
          imagePullPolicy: IfNotPresent
          args:
            - --namespace={{ default "project-signal" .Namespace }}
            - --address=:8080
          ports:
            - name: http
              containerPort: 8080
          resources:
            requests:
              cpu: 25m
              memory: 48Mi
            limits:
              cpu: 250m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: [ALL]
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
      securityContext:
        seccompProfile:
          type: RuntimeDefault
---
apiVersion: v1
kind: Service
metadata:
  name: project-signal-dashboard
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-dashboard
    app.kubernetes.io/part-of: project-signal
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: project-signal-dashboard
  ports:
    - name: http
      port: 8080
      targetPort: http
