apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: project-signal-gpu-full-node-certification
  namespace: {{ default "project-signal" .Namespace }}
spec:
  serviceAccountName: project-signal-runner
  entrypoint: certification
  ttlStrategy:
    secondsAfterCompletion: 21600
    secondsAfterSuccess: 21600
    secondsAfterFailure: 21600
  podGC:
    strategy: OnWorkflowCompletion
    deleteDelayDuration: 2h
  arguments:
    parameters:
      - name: run-name
      - name: run-uid
      - name: participants
      - name: participant-plan
      - name: test-plan
      - name: script-configmap
      - name: script-key
      - name: script-digest
      - name: backend-api-version
      - name: backend-kind
      - name: queue
      - name: runner-image
      - name: tolerations
        value: >-
          [{"key":"nvidia.com/gpu","operator":"Exists","effect":"NoSchedule"}]
      - name: expected-gpu-product-regex
      - name: expected-gpu-count
      - name: observed-gpu-capacity
      - name: observed-gpu-allocatable
      - name: attempt
  volumes:
    - name: scripts
      configMap:
        name: "{{`{{workflow.parameters.script-configmap}}`}}"
        defaultMode: 0555
  templates:
    - name: certification
      steps:
        - - name: node
            template: node-tests
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{workflow.parameters.participants}}`}}"
                - name: node-uid
                  value: "{{`{{=jsonpath(workflow.parameters['participant-plan'], '$[0].nodeUID')}}`}}"
                - name: observed-gpu-capacity
                  value: "{{`{{workflow.parameters.observed-gpu-capacity}}`}}"
                - name: observed-gpu-allocatable
                  value: "{{`{{workflow.parameters.observed-gpu-allocatable}}`}}"

    - name: node-tests
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
          - name: observed-gpu-capacity
          - name: observed-gpu-allocatable
      dag:
        failFast: false
        tasks:
          - name: node-health
            template: full-node-stage
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{inputs.parameters.node-name}}`}}"
                - name: node-uid
                  value: "{{`{{inputs.parameters.node-uid}}`}}"
                - name: observed-gpu-capacity
                  value: "{{`{{inputs.parameters.observed-gpu-capacity}}`}}"
                - name: observed-gpu-allocatable
                  value: "{{`{{inputs.parameters.observed-gpu-allocatable}}`}}"
                - name: test-id
                  value: preflight
                - name: stage-name
                  value: preflight
                - name: gpu-count
                  value: "1"
          - name: gpu-health
            depends: node-health.Succeeded
            when: "{{`{{tasks.node-health.outputs.parameters.verdict}}`}} == Pass"
            template: full-node-stage
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{inputs.parameters.node-name}}`}}"
                - name: node-uid
                  value: "{{`{{inputs.parameters.node-uid}}`}}"
                - name: observed-gpu-capacity
                  value: "{{`{{inputs.parameters.observed-gpu-capacity}}`}}"
                - name: observed-gpu-allocatable
                  value: "{{`{{inputs.parameters.observed-gpu-allocatable}}`}}"
                - name: test-id
                  value: gpu-health
                - name: stage-name
                  value: workload
                - name: gpu-count
                  value: "{{`{{workflow.parameters.expected-gpu-count}}`}}"
          - name: workload-skipped
            depends: node-health.Succeeded
            when: "{{`{{tasks.node-health.outputs.parameters.verdict}}`}} != Pass"
            template: skipped-workload
          - name: mpi-backend
            depends: gpu-health.Succeeded
            when: "{{`{{tasks.gpu-health.outputs.parameters.verdict}}`}} == Pass"
            template: full-node-mpi-backend
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{inputs.parameters.node-name}}`}}"
                - name: node-uid
                  value: "{{`{{inputs.parameters.node-uid}}`}}"
                - name: device-inventory
                  value: "{{`{{tasks.gpu-health.outputs.parameters.measurements}}`}}"
                - name: gpu-count
                  value: "{{`{{workflow.parameters.expected-gpu-count}}`}}"
            hooks:
              exit:
                template: cleanup-mpi
                arguments:
                  parameters:
                    - name: node-name
                      value: "{{`{{inputs.parameters.node-name}}`}}"
          - name: health-after
            depends: >-
              (node-health.Succeeded || node-health.Failed || node-health.Errored) &&
              (gpu-health.Succeeded || gpu-health.Failed || gpu-health.Errored || gpu-health.Skipped || gpu-health.Omitted) &&
              (mpi-backend.Succeeded || mpi-backend.Failed || mpi-backend.Errored || mpi-backend.Skipped || mpi-backend.Omitted)
            template: full-node-stage
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{inputs.parameters.node-name}}`}}"
                - name: node-uid
                  value: "{{`{{inputs.parameters.node-uid}}`}}"
                - name: observed-gpu-capacity
                  value: "{{`{{inputs.parameters.observed-gpu-capacity}}`}}"
                - name: observed-gpu-allocatable
                  value: "{{`{{inputs.parameters.observed-gpu-allocatable}}`}}"
                - name: test-id
                  value: health-after
                - name: stage-name
                  value: health-after
                - name: gpu-count
                  value: "1"

    - name: full-node-stage
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
          - name: observed-gpu-capacity
          - name: observed-gpu-allocatable
          - name: test-id
          - name: stage-name
          - name: gpu-count
          - name: expected-gpu-product-regex
            default: "{{`{{workflow.parameters.expected-gpu-product-regex}}`}}"
          - name: expected-gpu-count
            default: "{{`{{workflow.parameters.expected-gpu-count}}`}}"
      nodeSelector:
        kubernetes.io/hostname: "{{`{{inputs.parameters.node-name}}`}}"
      podSpecPatch: >-
        {"tolerations": {{`{{workflow.parameters.tolerations}}`}},
        "containers":[{"name":"main","resources":{"limits":{"nvidia.com/gpu":"{{`{{inputs.parameters.gpu-count}}`}}"}}}]}
      container:
        image: "{{`{{workflow.parameters.runner-image}}`}}"
        imagePullPolicy: IfNotPresent
        command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
        env:
          - name: PROJECT_SIGNAL_STAGE_NAME
            value: "{{`{{inputs.parameters.stage-name}}`}}"
          - name: EXPECTED_GPU_PRODUCT_REGEX
            value: "{{`{{inputs.parameters.expected-gpu-product-regex}}`}}"
          - name: EXPECTED_GPU_COUNT
            value: "{{`{{inputs.parameters.expected-gpu-count}}`}}"
          - name: OBSERVED_GPU_CAPACITY
            value: "{{`{{inputs.parameters.observed-gpu-capacity}}`}}"
          - name: OBSERVED_GPU_ALLOCATABLE
            value: "{{`{{inputs.parameters.observed-gpu-allocatable}}`}}"
        volumeMounts:
          - name: scripts
            mountPath: /scripts
            readOnly: true
          - name: results
            mountPath: /results
      volumes:
        - name: results
          emptyDir: {}
      outputs:
        parameters:
          - name: test-id
            value: "{{`{{inputs.parameters.test-id}}`}}"
          - name: run-uid
            value: "{{`{{workflow.parameters.run-uid}}`}}"
          - name: node-name
            value: "{{`{{inputs.parameters.node-name}}`}}"
          - name: node-uid
            value: "{{`{{inputs.parameters.node-uid}}`}}"
          - name: attempt
            value: "{{`{{workflow.parameters.attempt}}`}}"
          - name: script-digest
            value: "{{`{{workflow.parameters.script-digest}}`}}"
          - name: verdict
            valueFrom:
              path: /results/verdict
              default: Inconclusive
          - name: reason
            valueFrom:
              path: /results/reason
              default: MissingTestResult
          - name: measurements
            valueFrom:
              path: /results/measurements.txt
              default: ""

    - name: skipped-workload
      container:
        image: "{{`{{workflow.parameters.runner-image}}`}}"
        imagePullPolicy: IfNotPresent
        command: ["/bin/bash", "-lc"]
        args:
          - >-
            printf 'PROJECT_SIGNAL_STAGE {"name":"workload","status":"skipped","at_epoch":%s,"reason":"PreflightFailed","message":"Full-node GPU allocation was not attempted because inventory preflight failed."}\n'
            "$(date +%s)"

    - name: full-node-mpi-backend
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
          - name: test-id
            default: mpi-rank-access
          - name: device-inventory
          - name: gpu-count
      resource:
        action: create
        setOwnerReference: true
        successCondition: status.replicaStatuses.Launcher.succeeded == 1
        failureCondition: status.replicaStatuses.Launcher.failed == 1
        manifest: |
          apiVersion: kubeflow.org/v2beta1
          kind: MPIJob
          metadata:
            name: "{{`{{=sprig.trunc(40, workflow.name)}}`}}-{{`{{=sprig.trunc(12, sprig.sha256sum(inputs.parameters['node-name']))}}`}}"
            labels:
              signal.unbounded-cloud.io/run: "{{`{{workflow.parameters.run-name}}`}}"
          spec:
            launcherCreationPolicy: WaitForWorkersReady
            mpiImplementation: OpenMPI
            runLauncherAsWorker: false
            runPolicy:
              backoffLimit: 0
              cleanPodPolicy: All
              ttlSecondsAfterFinished: 3600
            slotsPerWorker: {{`{{inputs.parameters.gpu-count}}`}}
            mpiReplicaSpecs:
              Launcher:
                replicas: 1
                template:
                  spec:
                    restartPolicy: Never
                    containers:
                      - name: launcher
                        image: "{{`{{workflow.parameters.runner-image}}`}}"
                        command: ["/bin/bash", "-lc"]
                        args:
                          - >-
                            mpirun --allow-run-as-root
                            -np {{`{{inputs.parameters.gpu-count}}`}}
                            --bind-to none --map-by slot
                            -mca plm_rsh_no_tree_spawn 1
                            -mca plm_rsh_args
                            "-o ConnectionAttempts=10 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/project-signal-known-hosts"
                            /bin/bash -lc
                            'nvidia-smi -i "${OMPI_COMM_WORLD_LOCAL_RANK}"
                            --query-gpu=index,uuid,name,pci.bus_id,pstate,temperature.gpu
                            --format=csv,noheader,nounits'
              Worker:
                replicas: 1
                template:
                  spec:
                    restartPolicy: Never
                    nodeSelector:
                      kubernetes.io/hostname: "{{`{{inputs.parameters.node-name}}`}}"
                    tolerations: {{`{{workflow.parameters.tolerations}}`}}
                    containers:
                      - name: worker
                        image: "{{`{{workflow.parameters.runner-image}}`}}"
                        command:
                          - /bin/bash
                          - -lc
                          - >-
                            install -d -m 0700 /run/project-signal-ssh &&
                            install -m 0600 /root/.ssh/authorized_keys /run/project-signal-ssh/authorized_keys &&
                            mkdir -p /run/sshd &&
                            ssh-keygen -A &&
                            exec /usr/sbin/sshd -D -e
                            -o AuthorizedKeysFile=/run/project-signal-ssh/authorized_keys
                        resources:
                          limits:
                            nvidia.com/gpu: "{{`{{inputs.parameters.gpu-count}}`}}"
      outputs:
        parameters:
          - name: test-id
            value: "{{`{{inputs.parameters.test-id}}`}}"
          - name: run-uid
            value: "{{`{{workflow.parameters.run-uid}}`}}"
          - name: node-name
            value: "{{`{{inputs.parameters.node-name}}`}}"
          - name: node-uid
            value: "{{`{{inputs.parameters.node-uid}}`}}"
          - name: attempt
            value: "{{`{{workflow.parameters.attempt}}`}}"
          - name: script-digest
            value: "{{`{{workflow.parameters.script-digest}}`}}"
          - name: verdict
            value: Pass
          - name: reason
            value: MPIRankAccessPassed
          - name: measurements
            valueFrom:
              jsonPath: "{.status}"
          - name: device-inventory
            value: "{{`{{inputs.parameters.device-inventory}}`}}"

    - name: cleanup-mpi
      inputs:
        parameters:
          - name: node-name
      resource:
        action: delete
        flags: ["--ignore-not-found=true", "--wait=true", "--cascade=foreground"]
        manifest: |
          apiVersion: kubeflow.org/v2beta1
          kind: MPIJob
          metadata:
            name: "{{`{{=sprig.trunc(40, workflow.name)}}`}}-{{`{{=sprig.trunc(12, sprig.sha256sum(inputs.parameters['node-name']))}}`}}"
