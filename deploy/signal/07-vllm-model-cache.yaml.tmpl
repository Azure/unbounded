{{- if eq (default "false" .VLLMModelCacheSeedEnabled) "true" }}
{{- if ne (default "false" .VLLMCanaryEnabled) "true" }}
{{- fail "VLLMModelCacheSeedEnabled requires VLLMCanaryEnabled=true" }}
{{- end }}
{{- if not (regexMatch "^[^@[:space:]]+@sha256:[0-9a-f]{64}$" .VLLMModelCacheImage) }}
{{- fail "VLLMModelCacheImage must be an immutable sha256 digest reference" }}
{{- end }}
{{- if not (regexMatch "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" .VLLMModelCacheSeedID) }}
{{- fail "VLLMModelCacheSeedID must be a DNS-compatible lowercase identity" }}
{{- end }}
{{- if not (regexMatch "^sha256:[0-9a-f]{64}$" .VLLMModelCacheManifestDigest) }}
{{- fail "VLLMModelCacheManifestDigest must be an algorithm-qualified sha256 digest" }}
{{- end }}
{{- if not (regexMatch "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*(/[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*)*$" .VLLMModelCacheSubPath) }}
{{- fail "VLLMModelCacheSubPath must be a safe relative path" }}
{{- end }}
{{- if empty .VLLMModelCacheCapacity }}
{{- fail "VLLMModelCacheCapacity is required when cache seeding is enabled" }}
{{- end }}
{{- if empty .VLLMModelCacheStorageClass }}
{{- fail "VLLMModelCacheStorageClass is required when cache seeding is enabled" }}
{{- end }}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ .VLLMModelCachePVC }}
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-vllm-model-cache
    app.kubernetes.io/part-of: project-signal
  annotations:
    signal.unbounded-cloud.io/model-manifest-digest: {{ .VLLMModelCacheManifestDigest }}
    signal.unbounded-cloud.io/model-revision: e93a9faa9c77e5d09219f6c868bfc7a1bd65593c
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: {{ .VLLMModelCacheStorageClass }}
  resources:
    requests:
      storage: {{ .VLLMModelCacheCapacity }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: project-signal-vllm-cache-{{ .VLLMModelCacheSeedID }}
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-vllm-model-cache
    app.kubernetes.io/part-of: project-signal
    signal.unbounded-cloud.io/cache-seed-id: {{ .VLLMModelCacheSeedID }}
  annotations:
    signal.unbounded-cloud.io/model-manifest-digest: {{ .VLLMModelCacheManifestDigest }}
    signal.unbounded-cloud.io/model-revision: e93a9faa9c77e5d09219f6c868bfc7a1bd65593c
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 600
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: project-signal-vllm-model-cache
        app.kubernetes.io/part-of: project-signal
        signal.unbounded-cloud.io/cache-seed-id: {{ .VLLMModelCacheSeedID }}
    spec:
      serviceAccountName: project-signal-vllm-cache-seeder
      automountServiceAccountToken: false
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: seed
          image: {{ .VLLMModelCacheImage }}
          imagePullPolicy: IfNotPresent
          args:
            - seed
            - --source-dir=/model
            - --target-dir=/cache/{{ .VLLMModelCacheSubPath }}
            - --manifest-digest={{ .VLLMModelCacheManifestDigest }}
            - --seed-uid=$(POD_UID)
          env:
            - name: POD_UID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: model-cache
              mountPath: /cache
      volumes:
        - name: model-cache
          persistentVolumeClaim:
            claimName: {{ .VLLMModelCachePVC }}
{{- end }}
