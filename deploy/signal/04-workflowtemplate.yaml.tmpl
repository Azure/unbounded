apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: project-signal-gpu-certification
  namespace: {{ default "project-signal" .Namespace }}
spec:
  serviceAccountName: project-signal-runner
  entrypoint: certification
  ttlStrategy:
    secondsAfterCompletion: 21600
    secondsAfterSuccess: 21600
    secondsAfterFailure: 21600
  podGC:
    strategy: OnWorkflowCompletion
    deleteDelayDuration: 2h
  arguments:
    parameters:
      - name: run-name
      - name: run-uid
      - name: participants
      - name: participant-plan
        value: "[]"
      - name: test-plan
        value: "[]"
      - name: script-configmap
      - name: script-key
      - name: script-digest
      - name: backend-api-version
      - name: backend-kind
      - name: queue
      - name: runner-image
      - name: tolerations
        value: >-
          [{"key":"nvidia.com/gpu","operator":"Exists","effect":"NoSchedule"}]
      - name: expected-gpu-product-regex
        value: "^$"
      - name: expected-gpu-count
        value: "0"
      - name: attempt
  volumes:
    - name: scripts
      configMap:
        name: "{{`{{workflow.parameters.script-configmap}}`}}"
        defaultMode: 0555
  templates:
    - name: certification
      steps:
        - - name: legacy
            when: "{{`{{=workflow.parameters['test-plan'] == '[]'}}`}}"
            template: legacy-certification
          - name: planned
            when: "{{`{{=workflow.parameters['test-plan'] != '[]'}}`}}"
            template: planned-certification
      outputs:
        parameters:
          - name: verdict
            valueFrom:
              expression: >-
                {{`workflow.parameters['test-plan'] == '[]'
                ? (steps.legacy.status == 'Succeeded' ? steps.legacy.outputs.parameters.verdict : 'Inconclusive')
                : (steps.planned.status == 'Succeeded' ? steps.planned.outputs.parameters.verdict : 'Inconclusive')`}}
          - name: reason
            valueFrom:
              expression: >-
                {{`workflow.parameters['test-plan'] == '[]'
                ? (steps.legacy.status == 'Succeeded' ? steps.legacy.outputs.parameters.reason : 'RequiredTestCoverageMissing')
                : (steps.planned.status == 'Succeeded' ? steps.planned.outputs.parameters.reason : 'RequiredTestCoverageMissing')`}}

    - name: planned-certification
      steps:
        - - name: node
            template: node-tests
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{workflow.parameters.participants}}`}}"
                - name: node-uid
                  value: "{{`{{=jsonpath(workflow.parameters['participant-plan'], '$[0].nodeUID')}}`}}"
      outputs:
        parameters:
          - name: verdict
            valueFrom:
              parameter: "{{`{{steps.node.outputs.parameters.verdict}}`}}"
          - name: reason
            valueFrom:
              parameter: "{{`{{steps.node.outputs.parameters.reason}}`}}"

    - name: node-tests
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
      dag:
        failFast: false
        tasks:
          - name: node-health
            template: node-health
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{inputs.parameters.node-name}}`}}"
                - name: node-uid
                  value: "{{`{{inputs.parameters.node-uid}}`}}"
          - name: mpi-backend
            dependencies: [node-health]
            when: "{{`{{tasks.node-health.outputs.parameters.verdict}}`}} == Pass"
            template: mpi-backend
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{inputs.parameters.node-name}}`}}"
                - name: node-uid
                  value: "{{`{{inputs.parameters.node-uid}}`}}"
                - name: device-inventory
                  value: "{{`{{tasks.node-health.outputs.parameters.measurements}}`}}"
            hooks:
              exit:
                template: cleanup-mpi
                arguments:
                  parameters:
                    - name: node-name
                      value: "{{`{{inputs.parameters.node-name}}`}}"
      outputs:
        parameters:
          - name: verdict
            valueFrom:
              expression: >-
                {{`((tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Fail')
                || (tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Fail'))
                ? 'Fail'
                : (tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Pass'
                && tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Pass'
                ? 'Pass' : 'Inconclusive')`}}
          - name: reason
            valueFrom:
              expression: >-
                {{`tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Fail'
                ? tasks['node-health'].outputs.parameters.reason
                : (tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Fail'
                ? tasks['mpi-backend'].outputs.parameters.reason
                : (tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Pass'
                && tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Pass'
                ? 'NodeTestsPassed' : 'RequiredTestCoverageMissing'))`}}

    - name: node-health
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
          - name: test-id
            default: gpu-identity
          - name: expected-gpu-product-regex
            default: "{{`{{workflow.parameters.expected-gpu-product-regex}}`}}"
          - name: expected-gpu-count
            default: "{{`{{workflow.parameters.expected-gpu-count}}`}}"
      nodeSelector:
        kubernetes.io/hostname: "{{`{{inputs.parameters.node-name}}`}}"
      podSpecPatch: >-
        {"tolerations": {{`{{workflow.parameters.tolerations}}`}}}
      container:
        image: "{{`{{workflow.parameters.runner-image}}`}}"
        imagePullPolicy: IfNotPresent
        command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
        env:
          - name: EXPECTED_GPU_PRODUCT_REGEX
            value: "{{`{{inputs.parameters.expected-gpu-product-regex}}`}}"
          - name: EXPECTED_GPU_COUNT
            value: "{{`{{inputs.parameters.expected-gpu-count}}`}}"
        resources:
          limits:
            nvidia.com/gpu: "1"
        volumeMounts:
          - name: scripts
            mountPath: /scripts
            readOnly: true
          - name: results
            mountPath: /results
      volumes:
        - name: results
          emptyDir: {}
      outputs:
        parameters:
          - name: test-id
            value: "{{`{{inputs.parameters.test-id}}`}}"
          - name: run-uid
            value: "{{`{{workflow.parameters.run-uid}}`}}"
          - name: node-name
            value: "{{`{{inputs.parameters.node-name}}`}}"
          - name: node-uid
            value: "{{`{{inputs.parameters.node-uid}}`}}"
          - name: attempt
            value: "{{`{{workflow.parameters.attempt}}`}}"
          - name: script-digest
            value: "{{`{{workflow.parameters.script-digest}}`}}"
          - name: verdict
            valueFrom:
              path: /results/verdict
              default: Inconclusive
          - name: reason
            valueFrom:
              path: /results/reason
              default: MissingTestResult
          - name: measurements
            valueFrom:
              path: /results/measurements.txt
              default: ""

    - name: mpi-backend
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
          - name: test-id
            default: mpi-backend
          - name: device-inventory
          - name: gpu-count
            default: "1"
      resource:
        action: create
        setOwnerReference: true
        successCondition: status.replicaStatuses.Launcher.succeeded == 1
        failureCondition: status.replicaStatuses.Launcher.failed == 1
        manifest: |
          apiVersion: kubeflow.org/v2beta1
          kind: MPIJob
          metadata:
            name: "{{`{{=sprig.trunc(40, workflow.name)}}`}}-{{`{{=sprig.trunc(12, sprig.sha256sum(inputs.parameters['node-name']))}}`}}"
            labels:
              signal.unbounded-cloud.io/run: "{{`{{workflow.parameters.run-name}}`}}"
          spec:
            launcherCreationPolicy: WaitForWorkersReady
            mpiImplementation: OpenMPI
            runLauncherAsWorker: false
            runPolicy:
              backoffLimit: 0
              cleanPodPolicy: All
              ttlSecondsAfterFinished: 3600
            slotsPerWorker: 1
            mpiReplicaSpecs:
              Launcher:
                replicas: 1
                template:
                  spec:
                    restartPolicy: Never
                    containers:
                      - name: launcher
                        image: "{{`{{workflow.parameters.runner-image}}`}}"
                        command: ["/bin/bash", "-lc"]
                        args:
                          - >-
                            mpirun --allow-run-as-root -np 1 --bind-to none
                            --map-by slot -mca plm_rsh_no_tree_spawn 1
                            -mca plm_rsh_args
                            "-o ConnectionAttempts=10 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/project-signal-known-hosts"
                            /bin/true
              Worker:
                replicas: 1
                template:
                  spec:
                    restartPolicy: Never
                    nodeSelector:
                      kubernetes.io/hostname: "{{`{{inputs.parameters.node-name}}`}}"
                    tolerations: {{`{{workflow.parameters.tolerations}}`}}
                    containers:
                      - name: worker
                        image: "{{`{{workflow.parameters.runner-image}}`}}"
                        command:
                          - /bin/bash
                          - -lc
                          - >-
                            install -d -m 0700 /run/project-signal-ssh &&
                            install -m 0600 /root/.ssh/authorized_keys /run/project-signal-ssh/authorized_keys &&
                            mkdir -p /run/sshd &&
                            ssh-keygen -A &&
                            exec /usr/sbin/sshd -D -e
                            -o AuthorizedKeysFile=/run/project-signal-ssh/authorized_keys
                        resources:
                          limits:
                            nvidia.com/gpu: "1"
      outputs:
        parameters:
          - name: test-id
            value: "{{`{{inputs.parameters.test-id}}`}}"
          - name: run-uid
            value: "{{`{{workflow.parameters.run-uid}}`}}"
          - name: node-name
            value: "{{`{{inputs.parameters.node-name}}`}}"
          - name: node-uid
            value: "{{`{{inputs.parameters.node-uid}}`}}"
          - name: attempt
            value: "{{`{{workflow.parameters.attempt}}`}}"
          - name: script-digest
            value: "{{`{{workflow.parameters.script-digest}}`}}"
          - name: verdict
            value: Pass
          - name: reason
            value: MPIBackendPassed
          - name: measurements
            valueFrom:
              jsonPath: "{.status}"
          - name: device-inventory
            value: "{{`{{inputs.parameters.device-inventory}}`}}"

    - name: cleanup-mpi
      inputs:
        parameters:
          - name: node-name
      resource:
        action: delete
        flags: ["--ignore-not-found=true", "--wait=true", "--cascade=foreground"]
        manifest: |
          apiVersion: kubeflow.org/v2beta1
          kind: MPIJob
          metadata:
            name: "{{`{{=sprig.trunc(40, workflow.name)}}`}}-{{`{{=sprig.trunc(12, sprig.sha256sum(inputs.parameters['node-name']))}}`}}"

    - name: legacy-certification
      dag:
        tasks:
          - name: node-health
            template: legacy-node-health
          - name: mpi-backend
            dependencies: [node-health]
            when: "{{`{{tasks.node-health.outputs.parameters.verdict}}`}} == Pass"
            template: mpi-backend
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{workflow.parameters.participants}}`}}"
                - name: node-uid
                  value: ""
                - name: device-inventory
                  value: ""
            hooks:
              exit:
                template: cleanup-mpi
                arguments:
                  parameters:
                    - name: node-name
                      value: "{{`{{workflow.parameters.participants}}`}}"
      outputs:
        parameters:
          - name: verdict
            valueFrom:
              expression: >-
                {{`((tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Fail')
                || (tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Fail'))
                ? 'Fail'
                : (tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Pass'
                && tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Pass'
                ? 'Pass' : 'Inconclusive')`}}
          - name: reason
            valueFrom:
              expression: >-
                {{`tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Fail'
                ? tasks['node-health'].outputs.parameters.reason
                : (tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Fail'
                ? tasks['mpi-backend'].outputs.parameters.reason
                : (tasks['node-health'].status == 'Succeeded' && tasks['node-health'].outputs.parameters.verdict == 'Pass'
                && tasks['mpi-backend'].status == 'Succeeded' && tasks['mpi-backend'].outputs.parameters.verdict == 'Pass'
                ? tasks['node-health'].outputs.parameters.reason : 'RequiredTestCoverageMissing'))`}}

    - name: legacy-node-health
      nodeSelector:
        kubernetes.io/hostname: "{{`{{workflow.parameters.participants}}`}}"
      podSpecPatch: >-
        {"tolerations": {{`{{workflow.parameters.tolerations}}`}}}
      container:
        image: "{{`{{workflow.parameters.runner-image}}`}}"
        imagePullPolicy: IfNotPresent
        command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
        env:
          - name: EXPECTED_GPU_PRODUCT_REGEX
            value: "{{`{{workflow.parameters.expected-gpu-product-regex}}`}}"
          - name: EXPECTED_GPU_COUNT
            value: "{{`{{workflow.parameters.expected-gpu-count}}`}}"
        resources:
          limits:
            nvidia.com/gpu: "1"
        volumeMounts:
          - name: scripts
            mountPath: /scripts
            readOnly: true
          - name: results
            mountPath: /results
      volumes:
        - name: results
          emptyDir: {}
      outputs:
        parameters:
          - name: verdict
            valueFrom:
              path: /results/verdict
          - name: reason
            valueFrom:
              path: /results/reason
