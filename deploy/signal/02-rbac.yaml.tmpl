apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: project-signal-controller
rules:
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch", "patch"]
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationprofiles"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationprofiles/status"]
    verbs: ["get", "update", "patch"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationruns"]
    verbs: ["get", "list", "watch", "create", "update", "patch"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationruns/status"]
    verbs: ["get", "update", "patch"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationruns/finalizers"]
    verbs: ["update"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines", "machineoperations"]
    verbs: ["get", "list"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: project-signal-controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: project-signal-controller
subjects:
  - kind: ServiceAccount
    name: project-signal-controller
    namespace: {{ default "project-signal" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: project-signal-controller
  namespace: {{ default "project-signal" .Namespace }}
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  - apiGroups: ["events.k8s.io"]
    resources: ["events"]
    verbs: ["create", "patch"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflows"]
    verbs: ["get", "list", "watch", "create", "delete"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: project-signal-controller
  namespace: {{ default "project-signal" .Namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: project-signal-controller
subjects:
  - kind: ServiceAccount
    name: project-signal-controller
    namespace: {{ default "project-signal" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: project-signal-script-reader
  namespace: {{ default (default "project-signal" .Namespace) .ScriptNamespace }}
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: project-signal-script-reader
  namespace: {{ default (default "project-signal" .Namespace) .ScriptNamespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: project-signal-script-reader
subjects:
  - kind: ServiceAccount
    name: project-signal-controller
    namespace: {{ default "project-signal" .Namespace }}
