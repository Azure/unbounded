apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: project-signal-gpu-burn-canary
  namespace: {{ default "project-signal" .Namespace }}
spec:
  serviceAccountName: project-signal-runner
  entrypoint: certification
  ttlStrategy:
    secondsAfterCompletion: 21600
    secondsAfterSuccess: 21600
    secondsAfterFailure: 21600
  podGC:
    strategy: OnWorkflowCompletion
    deleteDelayDuration: 2h
  arguments:
    parameters:
      - name: run-name
      - name: run-uid
      - name: participants
      - name: participant-plan
      - name: test-plan
      - name: script-configmap
      - name: script-key
      - name: script-digest
      - name: backend-api-version
      - name: backend-kind
      - name: queue
      - name: runner-image
      - name: tolerations
        value: >-
          [{"key":"nvidia.com/gpu","operator":"Exists","effect":"NoSchedule"}]
      - name: expected-gpu-product-regex
      - name: expected-gpu-count
      - name: observed-gpu-capacity
      - name: observed-gpu-allocatable
      - name: burn-duration-seconds
      - name: sample-interval-seconds
      - name: power-limit-tolerance-percent
      - name: power-limit-consecutive-samples
      - name: cpu-workers
      - name: memory-mib
      - name: storage-mib
      - name: attempt
  volumes:
    - name: scripts
      configMap:
        name: "{{`{{workflow.parameters.script-configmap}}`}}"
        defaultMode: 0555
  templates:
    - name: certification
      steps:
        - - name: node
            template: node-tests
            arguments:
              parameters:
                - name: node-name
                  value: "{{`{{workflow.parameters.participants}}`}}"
                - name: node-uid
                  value: "{{`{{=jsonpath(workflow.parameters['participant-plan'], '$[0].nodeUID')}}`}}"
                - name: observed-gpu-capacity
                  value: "{{`{{workflow.parameters.observed-gpu-capacity}}`}}"
                - name: observed-gpu-allocatable
                  value: "{{`{{workflow.parameters.observed-gpu-allocatable}}`}}"

    - name: node-tests
      inputs:
        parameters:
          - name: node-name
          - name: node-uid
          - name: test-id
            default: mixed-burn
          - name: observed-gpu-capacity
          - name: observed-gpu-allocatable
          - name: expected-gpu-product-regex
            default: "{{`{{workflow.parameters.expected-gpu-product-regex}}`}}"
          - name: expected-gpu-count
            default: "{{`{{workflow.parameters.expected-gpu-count}}`}}"
          - name: burn-duration-seconds
            default: "{{`{{workflow.parameters.burn-duration-seconds}}`}}"
          - name: sample-interval-seconds
            default: "{{`{{workflow.parameters.sample-interval-seconds}}`}}"
          - name: power-limit-tolerance-percent
            default: "{{`{{workflow.parameters.power-limit-tolerance-percent}}`}}"
          - name: power-limit-consecutive-samples
            default: "{{`{{workflow.parameters.power-limit-consecutive-samples}}`}}"
          - name: cpu-workers
            default: "{{`{{workflow.parameters.cpu-workers}}`}}"
          - name: memory-mib
            default: "{{`{{workflow.parameters.memory-mib}}`}}"
          - name: storage-mib
            default: "{{`{{workflow.parameters.storage-mib}}`}}"
      nodeSelector:
        kubernetes.io/hostname: "{{`{{inputs.parameters.node-name}}`}}"
      podSpecPatch: >-
        {"hostPID":true,
        "terminationGracePeriodSeconds":60,
        "tolerations": {{`{{workflow.parameters.tolerations}}`}},
        "containers":[{"name":"main","resources":{"limits":{
        "nvidia.com/gpu":"{{`{{inputs.parameters.expected-gpu-count}}`}}"}}}]}
      containerSet:
        volumeMounts:
          - name: scripts
            mountPath: /scripts
            readOnly: true
          - name: results
            mountPath: /results
          - name: work
            mountPath: /work
        containers:
          - name: main
            image: "{{`{{workflow.parameters.runner-image}}`}}"
            imagePullPolicy: IfNotPresent
            command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
            args: [gpu-burn]
            securityContext:
              privileged: true
              allowPrivilegeEscalation: true
            resources:
              requests: {cpu: "2", memory: 8Gi, ephemeral-storage: 2Gi}
              limits:
                cpu: "2"
                memory: 8Gi
                ephemeral-storage: 2Gi
            env: &burn-env
              - name: EXPECTED_GPU_PRODUCT_REGEX
                value: "{{`{{inputs.parameters.expected-gpu-product-regex}}`}}"
              - name: EXPECTED_GPU_COUNT
                value: "{{`{{inputs.parameters.expected-gpu-count}}`}}"
              - name: OBSERVED_GPU_CAPACITY
                value: "{{`{{inputs.parameters.observed-gpu-capacity}}`}}"
              - name: OBSERVED_GPU_ALLOCATABLE
                value: "{{`{{inputs.parameters.observed-gpu-allocatable}}`}}"
              - name: BURN_DURATION_SECONDS
                value: "{{`{{inputs.parameters.burn-duration-seconds}}`}}"
              - name: SAMPLE_INTERVAL_SECONDS
                value: "{{`{{inputs.parameters.sample-interval-seconds}}`}}"
              - name: POWER_LIMIT_TOLERANCE_PERCENT
                value: "{{`{{inputs.parameters.power-limit-tolerance-percent}}`}}"
              - name: POWER_LIMIT_CONSECUTIVE_SAMPLES
                value: "{{`{{inputs.parameters.power-limit-consecutive-samples}}`}}"
              - name: CPU_WORKERS
                value: "{{`{{inputs.parameters.cpu-workers}}`}}"
              - name: MEMORY_MIB
                value: "{{`{{inputs.parameters.memory-mib}}`}}"
              - name: STORAGE_MIB
                value: "{{`{{inputs.parameters.storage-mib}}`}}"
          - name: cpu-stress
            image: "{{`{{workflow.parameters.runner-image}}`}}"
            imagePullPolicy: IfNotPresent
            command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
            args: [cpu-stress]
            env: *burn-env
            resources:
              requests: {cpu: "4", memory: 1Gi, ephemeral-storage: 1Gi}
              limits: {cpu: "4", memory: 1Gi, ephemeral-storage: 1Gi}
          - name: memory-integrity
            image: "{{`{{workflow.parameters.runner-image}}`}}"
            imagePullPolicy: IfNotPresent
            command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
            args: [memory-integrity]
            env: *burn-env
            resources:
              requests: {cpu: "1", memory: 4Gi, ephemeral-storage: 1Gi}
              limits: {cpu: "1", memory: 4Gi, ephemeral-storage: 1Gi}
            volumeMounts:
              - name: memory-work
                mountPath: /work/memory
          - name: storage-integrity
            image: "{{`{{workflow.parameters.runner-image}}`}}"
            imagePullPolicy: IfNotPresent
            command: ["/bin/bash", "/scripts/{{`{{workflow.parameters.script-key}}`}}"]
            args: [storage-integrity]
            env: *burn-env
            resources:
              requests: {cpu: "1", memory: 3Gi, ephemeral-storage: 4Gi}
              limits: {cpu: "1", memory: 3Gi, ephemeral-storage: 4Gi}
      volumes:
        - name: results
          emptyDir: {}
        - name: work
          emptyDir:
            sizeLimit: 8Gi
        - name: memory-work
          emptyDir:
            medium: Memory
            sizeLimit: 4Gi
      outputs:
        parameters:
          - name: test-id
            value: "{{`{{inputs.parameters.test-id}}`}}"
          - name: run-uid
            value: "{{`{{workflow.parameters.run-uid}}`}}"
          - name: node-name
            value: "{{`{{inputs.parameters.node-name}}`}}"
          - name: node-uid
            value: "{{`{{inputs.parameters.node-uid}}`}}"
          - name: attempt
            value: "{{`{{workflow.parameters.attempt}}`}}"
          - name: script-digest
            value: "{{`{{workflow.parameters.script-digest}}`}}"
          - name: verdict
            valueFrom:
              path: /results/verdict
              default: Inconclusive
          - name: reason
            valueFrom:
              path: /results/reason
              default: MissingTestResult
          - name: measurements
            valueFrom:
              path: /results/measurements.txt
              default: ""
          - name: gpu-burn-verdict
            valueFrom:
              path: /results/gpu-burn-verdict
              default: Inconclusive
          - name: gpu-burn-reason
            valueFrom:
              path: /results/gpu-burn-reason
              default: MissingTestResult
          - name: gpu-burn-measurements
            valueFrom:
              path: /results/gpu-burn-measurements.txt
              default: ""
          - name: cpu-stress-verdict
            valueFrom:
              path: /results/cpu-stress-verdict
              default: Inconclusive
          - name: cpu-stress-reason
            valueFrom:
              path: /results/cpu-stress-reason
              default: MissingTestResult
          - name: cpu-stress-measurements
            valueFrom:
              path: /results/cpu-stress-measurements.txt
              default: ""
          - name: memory-integrity-verdict
            valueFrom:
              path: /results/memory-integrity-verdict
              default: Inconclusive
          - name: memory-integrity-reason
            valueFrom:
              path: /results/memory-integrity-reason
              default: MissingTestResult
          - name: memory-integrity-measurements
            valueFrom:
              path: /results/memory-integrity-measurements.txt
              default: ""
          - name: storage-integrity-verdict
            valueFrom:
              path: /results/storage-integrity-verdict
              default: Inconclusive
          - name: storage-integrity-reason
            valueFrom:
              path: /results/storage-integrity-reason
              default: MissingTestResult
          - name: storage-integrity-measurements
            valueFrom:
              path: /results/storage-integrity-measurements.txt
              default: ""
