{
  "annotations": {
    "list": []
  },
  "description": "Cluster-scale Project Signal certification status. One current series per participant supports 5,000-node fleets without repeated panels.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Current participant totals. Yellow is actively certifying, red is failed or inconclusive, and green is passed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixedColor"
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixedColor"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "certifying"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixedColor"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixedColor"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status) (project_signal_node_certification_status{cluster=~\"${cluster:regex}\", namespace=~\"${namespace:regex}\", status=~\"${status:regex}\", stage=~\"${stage:regex}\"})",
          "instant": true,
          "legendFormat": "{{status}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Fleet state",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Active participants grouped by their current stage.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 15,
        "x": 9,
        "y": 0
      },
      "id": 2,
      "options": {
        "displayMode": "basic",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (stage, stage_index, stage_total) (project_signal_node_certification_status{cluster=~\"${cluster:regex}\", namespace=~\"${namespace:regex}\", status=\"certifying\", stage=~\"${stage:regex}\"})",
          "instant": true,
          "legendFormat": "{{stage_index}}/{{stage_total}} {{stage}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active stage distribution",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One row per participant from its newest CertificationRun. The compact status cell is the fleet square: green passed, yellow certifying, red failed.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 92
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "passed": {
                        "color": "green",
                        "index": 0,
                        "text": "PASSED"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "certifying": {
                        "color": "yellow",
                        "index": 1,
                        "text": "ACTIVE"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "failed": {
                        "color": "red",
                        "index": 2,
                        "text": "FAILED"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Step"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 58
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 58
              },
              {
                "id": "custom.align",
                "value": "center"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "enablePagination": true,
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Node"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (cluster, namespace, node, status, phase, stage, stage_index, stage_total) (project_signal_node_certification_status{cluster=~\"${cluster:regex}\", namespace=~\"${namespace:regex}\", status=~\"${status:regex}\", stage=~\"${stage:regex}\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{node}}",
          "maxDataPoints": 6000,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Node certification matrix",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "cluster": 0,
              "namespace": 1,
              "node": 2,
              "status": 3,
              "stage_index": 4,
              "stage_total": 5,
              "stage": 6,
              "phase": 7
            },
            "renameByName": {
              "cluster": "Cluster",
              "namespace": "Namespace",
              "node": "Node",
              "phase": "Phase",
              "stage": "Stage",
              "stage_index": "Step",
              "stage_total": "Total",
              "status": "Status"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "project-signal",
    "certification",
    "fleet"
  ],
