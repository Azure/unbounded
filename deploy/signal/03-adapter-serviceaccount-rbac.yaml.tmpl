{{- $vllmCanaryEnabled := default "false" .VLLMCanaryEnabled }}
{{- if not (regexMatch "^(true|false)$" $vllmCanaryEnabled) }}
{{- fail "VLLMCanaryEnabled must be true or false" }}
{{- end }}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: project-signal-adapter
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-adapter
automountServiceAccountToken: true

{{ if eq $vllmCanaryEnabled "true" }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: project-signal-vllm-workload
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-vllm-workload
    app.kubernetes.io/part-of: project-signal
automountServiceAccountToken: true
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: project-signal-vllm-cache-seeder
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-vllm-cache-seeder
    app.kubernetes.io/part-of: project-signal
automountServiceAccountToken: false
{{ end }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: project-signal-adapter
  namespace: {{ default "project-signal" .Namespace }}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch", "create", "delete"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["list"]
  - apiGroups: ["kubeflow.org"]
    resources: ["mpijobs"]
    verbs: ["get", "create", "delete"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflows"]
    verbs: ["get", "list", "watch", "create", "delete"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflowtemplates"]
    verbs: ["get"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflowtaskresults"]
    verbs: ["create", "patch"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationruns"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "create", "delete"]
{{ if eq $vllmCanaryEnabled "true" }}
  - apiGroups: [""]
    resources: ["persistentvolumeclaims"]
    verbs: ["get"]
{{ end }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: project-signal-adapter
  namespace: {{ default "project-signal" .Namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: project-signal-adapter
subjects:
  - kind: ServiceAccount
    name: project-signal-adapter
    namespace: {{ default "project-signal" .Namespace }}

{{ if eq $vllmCanaryEnabled "true" }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: project-signal-vllm-workload
  namespace: {{ default "project-signal" .Namespace }}
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["create"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflowtaskresults"]
    verbs: ["create", "patch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: project-signal-vllm-workload
  namespace: {{ default "project-signal" .Namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: project-signal-vllm-workload
subjects:
  - kind: ServiceAccount
    name: project-signal-vllm-workload
    namespace: {{ default "project-signal" .Namespace }}
{{ end }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: project-signal-adapter-infrastructure-reader
rules:
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get"]
  - apiGroups: ["signal.unbounded-cloud.io"]
    resources: ["certificationtests"]
    verbs: ["get"]
{{ if eq $vllmCanaryEnabled "true" }}
  - apiGroups: ["storage.k8s.io"]
    resources: ["volumeattachments"]
    verbs: ["list"]
{{ end }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: project-signal-adapter-infrastructure-reader
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: project-signal-adapter-infrastructure-reader
subjects:
  - kind: ServiceAccount
    name: project-signal-adapter
    namespace: {{ default "project-signal" .Namespace }}
