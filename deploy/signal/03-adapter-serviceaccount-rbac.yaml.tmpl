apiVersion: v1
kind: ServiceAccount
metadata:
  name: project-signal-adapter
  namespace: {{ default "project-signal" .Namespace }}
  labels:
    app.kubernetes.io/name: project-signal-adapter
automountServiceAccountToken: true

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: project-signal-adapter
  namespace: {{ default "project-signal" .Namespace }}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch", "create", "delete"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  - apiGroups: ["kubeflow.org"]
    resources: ["mpijobs"]
    verbs: ["get", "list", "watch", "create", "delete"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflows"]
    verbs: ["get"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflowtaskresults"]
    verbs: ["create", "patch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: project-signal-adapter
  namespace: {{ default "project-signal" .Namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: project-signal-adapter
subjects:
  - kind: ServiceAccount
    name: project-signal-adapter
    namespace: {{ default "project-signal" .Namespace }}
