{{- $controllerName := default "machine-ops-controller" .ControllerName }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ $controllerName }}
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ $controllerName }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ $controllerName }}
        app.kubernetes.io/component: controller
      annotations:
        kubernetes.azure.com/set-kube-service-host-fqdn: "true"
    spec:
      serviceAccountName: {{ $controllerName }}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: kubernetes.azure.com/mode
                    operator: In
                    values:
                      - system
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: Exists
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
        - key: node-role.kubernetes.io/master
          operator: Exists
          effect: NoSchedule
        - key: CriticalAddonsOnly
          operator: Equal
          value: "true"
          effect: NoSchedule
      containers:
        - name: controller
          image: {{ default "ghcr.io/azure/machine-ops-controller:latest" .ControllerImage }}
          imagePullPolicy: Always
          args:
            - --leader-elect=true
            - --leader-elect-namespace={{ default "unbounded-system" .Namespace }}
            - --credential-secret-namespace={{ default "unbounded-system" .Namespace }}
            - --max-concurrent-reconciles={{ default "10" .MaxConcurrentReconciles }}
            {{- if .Provider }}
            - --provider={{ .Provider }}
            {{- end }}
            {{- if .Site }}
            - --site={{ .Site }}
            {{- end }}
            {{- if .APIServerEndpoint }}
            - --api-server-endpoint={{ .APIServerEndpoint }}
            {{- end }}
            - --metrics-bind-address=:8080
            - --health-probe-bind-address=:8081
          ports:
            - containerPort: 8080
              name: metrics
              protocol: TCP
            - containerPort: 8081
              name: health
              protocol: TCP
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65534
            capabilities:
              drop:
                - ALL
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            initialDelaySeconds: 3
            periodSeconds: 5
