{{- $controllerName := default "azure-machine-ops-controller" .ControllerName }}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ $controllerName }}
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
  {{- /* Azure workload identity for the controller's Azure calls: off unless a client ID is set. */}}
  {{- if .WorkloadIdentityClientID }}
  annotations:
    azure.workload.identity/client-id: {{ .WorkloadIdentityClientID | quote }}
  {{- end }}
