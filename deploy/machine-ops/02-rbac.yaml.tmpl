{{- $controllerName := default "machine-ops-controller" .ControllerName }}
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ $controllerName }}
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
rules:
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines"]
    verbs: ["get", "list", "watch", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperationcredentials"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineconfigurationversions"]
    verbs: ["get", "list"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations"]
    verbs: ["get", "list", "watch", "delete"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations/status"]
    verbs: ["get", "update", "patch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machineoperations/finalizers"]
    verbs: ["update"]
  - apiGroups: ["azure.unbounded-cloud.io"]
    resources: ["azuremachines"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["list"]
  - nonResourceURLs: ["/version"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ $controllerName }}
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ $controllerName }}
subjects:
  - kind: ServiceAccount
    name: {{ $controllerName }}
    namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ $controllerName }}-bootstrap
  namespace: kube-public
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["kube-root-ca.crt"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ $controllerName }}-bootstrap
  namespace: kube-public
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ $controllerName }}-bootstrap
subjects:
  - kind: ServiceAccount
    name: {{ $controllerName }}
    namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ $controllerName }}-bootstrap
  namespace: kube-system
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
rules:
  - apiGroups: [""]
    resources: ["services", "secrets"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ $controllerName }}-bootstrap
  namespace: kube-system
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ $controllerName }}-bootstrap
subjects:
  - kind: ServiceAccount
    name: {{ $controllerName }}
    namespace: {{ default "unbounded-system" .Namespace }}

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ $controllerName }}
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
rules:
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["get"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ $controllerName }}
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: {{ $controllerName }}
    app.kubernetes.io/component: controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ $controllerName }}
subjects:
  - kind: ServiceAccount
    name: {{ $controllerName }}
    namespace: {{ default "unbounded-system" .Namespace }}
