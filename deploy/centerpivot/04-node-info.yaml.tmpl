# Publishes each managed node's Nebraska identity in its agent-info
# annotation, until trident-acl-agent does. Unbounded's host agent mounts the
# host's machine-id and os-release into the node's nspawn machine under
# /run/unbounded/host. It tolerates every taint, so it runs while the node
# restarts with centerpivot's updating taint.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: centerpivot-node-info
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: centerpivot-node-info
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: centerpivot-node-info
  template:
    metadata:
      labels:
        app.kubernetes.io/name: centerpivot-node-info
    spec:
      serviceAccountName: centerpivot-node-info
      nodeSelector:
        centerpivot.unbounded-cloud.io/managed: "true"
      tolerations:
        - operator: Exists
      containers:
        - name: node-info
          image: {{ default "ghcr.io/azure/centerpivot:dev" .Image }}
          imagePullPolicy: Always
          args:
            - node-info
            - --host-dir=/run/unbounded/host
            - --version-key=VERSION_ID
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: 5m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65534
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: host
              mountPath: /run/unbounded/host
              readOnly: true
      volumes:
        - name: host
          hostPath:
            path: /run/unbounded/host
            type: Directory
