# Publishes each managed node's Nebraska identity in its agent-info
# annotation, until trident-acl-agent does. Unbounded's host agent binds the
# host's /etc/machine-id into the node's nspawn machine at
# /run/unbounded/host/machine-id, and systemd-nspawn binds the host's
# os-release at /run/host/os-release. It tolerates every taint, so it runs
# while the node restarts with centerpivot's updating taint.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: centerpivot-node-info
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: centerpivot-node-info
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: centerpivot-node-info
  template:
    metadata:
      labels:
        app.kubernetes.io/name: centerpivot-node-info
    spec:
      serviceAccountName: centerpivot-node-info
      nodeSelector:
        centerpivot.unbounded-cloud.io/managed: "true"
      tolerations:
        - operator: Exists
      containers:
        - name: node-info
          image: {{ default "ghcr.io/azure/centerpivot:dev" .Image }}
          imagePullPolicy: Always
          args:
            - node-info
            - --machine-id-path=/run/unbounded/host/machine-id
            - --os-release-path=/run/host/os-release
            - --version-key=VERSION_ID
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: 5m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65534
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: machine-id
              mountPath: /run/unbounded/host/machine-id
              readOnly: true
            - name: os-release
              mountPath: /run/host/os-release
              readOnly: true
      volumes:
        - name: machine-id
          hostPath:
            path: /run/unbounded/host/machine-id
            type: File
        - name: os-release
          hostPath:
            path: /run/host/os-release
            type: File
