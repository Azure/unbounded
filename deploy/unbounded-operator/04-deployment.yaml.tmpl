---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: unbounded-operator
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: unbounded-operator
    app.kubernetes.io/component: controller
spec:
  replicas: 1
  strategy:
    type: Recreate
    rollingUpdate: null
  selector:
    matchLabels:
      app.kubernetes.io/name: unbounded-operator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: unbounded-operator
        app.kubernetes.io/component: controller
      annotations:
        # On AKS (which does not publish kube-public/cluster-info) this makes the
        # pod's KUBERNETES_SERVICE_HOST the public API FQDN, which the operator
        # uses as the last-resort source for the advertised API server endpoint.
        # AKS only honors this as a pod annotation (not a label). Inert on
        # clusters that do not honor it.
        kubernetes.azure.com/set-kube-service-host-fqdn: "true"
        # Rolls the operator when any ConfigMap data changes at render time.
        # Canonical JSON matches the `kubectl unbounded install` hash.
        unbounded-cloud.io/operator-config-hash: {{ dict "UNBOUNDED_API_SERVER_ENDPOINT" (default "" .APIServerEndpoint) "UNBOUNDED_REAP_LEGACY_RESOURCES" (default "true" .ReapLegacyResources) "UNBOUNDED_METALMAN_IMAGE" (default "" .MetalmanImage) "UNBOUNDED_NETBOOT_IMAGE" (default "" .NetbootImage) "UNBOUNDED_MACHINA_IMAGE" (default "" .MachinaImage) "UNBOUNDED_NET_CONTROLLER_IMAGE" (default "" .NetControllerImage) "UNBOUNDED_NET_NODE_IMAGE" (default "" .NetNodeImage) "UNBOUNDED_STORAGE_SUPERVISOR_IMAGE" (default "" .StorageSupervisorImage) "UNBOUNDED_MANAGED_KUBE_PROXY_IMAGE" (default "" .ManagedKubeProxyImage) "UNBOUNDED_STORAGE_VERSION" (default "" .StorageVersion) "UNBOUNDED_STORAGE_RELEASE_BASE_URL" (default "" .StorageReleaseBaseURL) | toJson | sha256sum | quote }}
    spec:
      serviceAccountName: unbounded-operator
      containers:
        - name: controller
          image: {{ .OperatorImage }}
          imagePullPolicy: Always
          args:
            - --leader-elect=true
            - --leader-elect-namespace={{ default "unbounded-system" .Namespace }}
            - --namespace={{ default "unbounded-system" .Namespace }}
          envFrom:
            # Release and environment settings. See
            # deploy/unbounded-operator/03-configmap.yaml.tmpl.
            - configMapRef:
                name: unbounded-operator-config
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          ports:
            - name: metrics
              containerPort: 8080
              protocol: TCP
            - name: health
              containerPort: 8081
              protocol: TCP
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
          startupProbe:
            # The operator applies and establishes CRDs at startup
            # (operator.BootstrapCRDs, CRDBootstrapTimeout = 4m) before the
            # manager starts and binds the health server, so /healthz is not
            # served during bootstrap. Give startup up to 270s (54 x 5s), which
            # exceeds the full bootstrap timeout, before liveness takes over.
            httpGet:
              path: /healthz
              port: health
            periodSeconds: 5
            failureThreshold: 54
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 10
            periodSeconds: 15
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 5
