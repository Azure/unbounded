{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The root accepts extra keys: AKS cluster extensions inject platform values (Azure.Cluster.*, IdentityClientId, DataBoundary, scope, ...) that this chart ignores. The chart's own objects stay strict.",
  "type": "object",
  "required": ["imageRegistry", "image", "apiServerEndpoint", "reapLegacyResources", "resources", "namespace"],
  "properties": {
    "imageRegistry": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "name", "tag", "digest", "pullPolicy"],
      "properties": {
        "reference": {"type": "string"},
        "name": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "apiServerEndpoint": {"type": "string"},
    "reapLegacyResources": {"type": "boolean"},
    "resources": {"type": "object"},
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {"create": {"const": false}}
    }
  }
}
