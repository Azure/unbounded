---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: unbounded-operator
  labels:
    app.kubernetes.io/name: unbounded-operator
    app.kubernetes.io/component: controller
rules:
  - apiGroups: ["racer.unbounded-cloud.io"]
    resources: ["clustercaches"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["sites"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["sites/status"]
    verbs: ["get", "patch", "update"]
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: [""]
    resources: ["namespaces", "services", "secrets"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: [""]
    resources: ["serviceaccounts", "configmaps"]
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete"]
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["pods", "replicationcontrollers", "persistentvolumeclaims"]
    verbs: ["get", "list", "watch"]
  # Read-only, and only ever read: a component that registers admission
  # webhooks or an aggregated API points them at a Service, and a registration
  # whose backend is not serving is worse than none. EndpointSlices answer whether
  # anything is actually behind that Service. The net controller Service has no
  # selector - its leader pod writes these itself - so there is no other way to
  # tell a running backend from a Deployment that merely exists.
  #
  # The verbs are exactly what the reads need and no more. These go through
  # Env.LiveReader, which bypasses the manager cache. The EndpointSlice uses
  # the Service's own name, so get suffices. It is not watched, which is the
  # point of reading them live.
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["get"]
  - apiGroups: ["apps"]
    resources: ["deployments", "daemonsets"]
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete"]
  - apiGroups: ["apps"]
    resources: ["statefulsets", "replicasets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["batch"]
    resources: ["jobs", "cronjobs"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["create"]
  - apiGroups: ["scheduling.k8s.io"]
    # The gantry component installs a low-priority PriorityClass (gantry-low)
    # so its agents are preemptible under cluster pressure.
    resources: ["priorityclasses"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: ["rbac.authorization.k8s.io"]
    resources: ["roles", "rolebindings", "clusterroles", "clusterrolebindings"]
    # escalate + bind let the operator install the component RBAC (net,
    # machina, metalman, storage) whose Roles/ClusterRoles grant permissions
    # the operator itself does not hold; without them the apiserver rejects the
    # role creation as a privilege escalation.
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete", "escalate", "bind"]
  - apiGroups: ["admissionregistration.k8s.io"]
    resources: ["validatingwebhookconfigurations", "mutatingwebhookconfigurations", "validatingadmissionpolicies", "validatingadmissionpolicybindings"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: ["apiregistration.k8s.io"]
    resources: ["apiservices"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  - apiGroups: ["events.k8s.io"]
    resources: ["events"]
    verbs: ["create", "patch", "update"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: unbounded-operator
  labels:
    app.kubernetes.io/name: unbounded-operator
    app.kubernetes.io/component: controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: unbounded-operator
subjects:
  - kind: ServiceAccount
    name: unbounded-operator
    namespace: {{ default "unbounded-system" .Namespace }}
