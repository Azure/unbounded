---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: unbounded-operator
  labels:
    app.kubernetes.io/name: unbounded-operator
    app.kubernetes.io/component: controller
rules:
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["sites"]
    verbs: ["get", "list", "watch", "create"]
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["sites/status"]
    verbs: ["get", "patch", "update"]
  # Legacy net-group Sites are read during migration and translated into the
  # machina-group Sites above; their finalizers are cleared (update/patch) so the
  # CRD can be deleted once drained.
  - apiGroups: ["net.unbounded-cloud.io"]
    resources: ["sites"]
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: ["net.unbounded-cloud.io"]
    resources: ["sitenodeslices"]
    verbs: ["get", "list", "watch"]
  # Cluster-scoped custom resources whose embedded secret references are
  # repointed from the legacy namespaces to unbounded-system.
  - apiGroups: ["unbounded-cloud.io"]
    resources: ["machines", "machineoperationcredentials"]
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete"]
  - apiGroups: [""]
    resources: ["namespaces", "serviceaccounts", "configmaps", "services", "secrets"]
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete", "deletecollection"]
  # The racer component assigns each node in a racer-enabled site its racer
  # identity (node id, zone and cohort) as annotations. Those three values must
  # be handed out by a single writer: two nodes self-claiming concurrently would
  # patch different Node objects and both would succeed with the same id. It
  # also owns the racer.unbounded-cloud.io/active label the node DaemonSet
  # selects on, which is how a decommissioning node keeps running racer until it
  # has shed.
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch", "patch", "update"]
  # racer volumes are PersistentVolumes. The operator stamps each one's extent
  # composition and home zone, and holds a finalizer while the extents are
  # collected, so it needs write access to the object and its metadata.
  - apiGroups: [""]
    resources: ["persistentvolumes"]
    verbs: ["get", "list", "watch", "patch", "update"]
  # A StorageClass whose provisioner is racer.unbounded-cloud.io is a racer
  # universe; the operator creates the default class and records the universe
  # id, catalog size, epoch, LBA cursor and per-zone membership on it. The
  # CSIDriver object is part of the racer manifest set.
  - apiGroups: ["storage.k8s.io"]
    resources: ["storageclasses", "csidrivers"]
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete"]
  - apiGroups: [""]
    resources: ["pods", "replicationcontrollers", "persistentvolumeclaims"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "daemonsets"]
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete", "deletecollection"]
  - apiGroups: ["apps"]
    resources: ["statefulsets", "replicasets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["batch"]
    resources: ["jobs", "cronjobs"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["scheduling.k8s.io"]
    # The gantry component installs a low-priority PriorityClass (gantry-low)
    # so its agents are preemptible under cluster pressure.
    resources: ["priorityclasses"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: ["rbac.authorization.k8s.io"]
    resources: ["roles", "rolebindings", "clusterroles", "clusterrolebindings"]
    # escalate + bind let the operator install the component RBAC (net,
    # machina, metalman, storage) whose Roles/ClusterRoles grant permissions
    # the operator itself does not hold; without them the apiserver rejects the
    # role creation as a privilege escalation. deletecollection lets the reaper
    # DeleteAllOf the legacy component RBAC by label.
    verbs: ["get", "list", "watch", "create", "patch", "update", "delete", "deletecollection", "escalate", "bind"]
  - apiGroups: ["admissionregistration.k8s.io"]
    resources: ["validatingwebhookconfigurations", "mutatingwebhookconfigurations", "validatingadmissionpolicies", "validatingadmissionpolicybindings"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: ["apiregistration.k8s.io"]
    resources: ["apiservices"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["get", "list", "watch", "create", "patch", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  - apiGroups: ["events.k8s.io"]
    resources: ["events"]
    verbs: ["create", "patch", "update"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: unbounded-operator
  labels:
    app.kubernetes.io/name: unbounded-operator
    app.kubernetes.io/component: controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: unbounded-operator
subjects:
  - kind: ServiceAccount
    name: unbounded-operator
    namespace: {{ default "unbounded-system" .Namespace }}
