---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: unbounded-operator
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: unbounded-operator
    app.kubernetes.io/component: controller
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: unbounded-operator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: unbounded-operator
        app.kubernetes.io/component: controller
    spec:
      serviceAccountName: unbounded-operator
      containers:
        - name: controller
          image: {{ .OperatorImage }}
          imagePullPolicy: Always
          args:
            - --leader-elect=true
            - --leader-elect-namespace={{ default "unbounded-system" .Namespace }}
            - --namespace={{ default "unbounded-system" .Namespace }}
            - --metalman-image={{ .MetalmanImage }}
          envFrom:
            # Environment-specific operator settings (api-server-endpoint, reaper
            # toggle). See deploy/unbounded-operator/04-configmap.yaml.tmpl.
            - configMapRef:
                name: unbounded-operator-config
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          ports:
            - name: metrics
              containerPort: 8080
              protocol: TCP
            - name: health
              containerPort: 8081
              protocol: TCP
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 10
            periodSeconds: 15
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 5
