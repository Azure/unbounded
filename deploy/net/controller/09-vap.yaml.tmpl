---
# Restrict what resources the unbounded-net controller service account may create.
# RBAC cannot scope the "create" verb by resourceNames, so this VAP ensures the
# controller can only create resources with the expected names. This prevents the
# SA from creating arbitrary Secrets, ConfigMaps, Endpoints, or EndpointSlices.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: unbounded-net-create-restriction
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["secrets", "configmaps", "endpoints"]
      - apiGroups: ["discovery.k8s.io"]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["endpointslices"]
  matchConditions:
    - name: "is-unbounded-net-controller-sa"
      expression: "request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-controller'"
  validations:
    # Secrets: only unbounded-net-serving-cert
    - expression: >-
        request.resource.resource != 'secrets' ||
        object.metadata.name == 'unbounded-net-serving-cert'
      message: "unbounded-net controller may only create the unbounded-net-serving-cert secret"
    # ConfigMaps: only unbounded-net-serving-ca
    - expression: >-
        request.resource.resource != 'configmaps' ||
        object.metadata.name == 'unbounded-net-serving-ca'
      message: "unbounded-net controller may only create the unbounded-net-serving-ca configmap"
    # Endpoints: only unbounded-net-controller
    - expression: >-
        request.resource.resource != 'endpoints' ||
        object.metadata.name == 'unbounded-net-controller'
      message: "unbounded-net controller may only create the unbounded-net-controller endpoints"
    # EndpointSlices: only unbounded-net-controller
    - expression: >-
        request.resource.resource != 'endpointslices' ||
        object.metadata.name == 'unbounded-net-controller'
      message: "unbounded-net controller may only create the unbounded-net-controller endpointslice"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: unbounded-net-create-restriction
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  policyName: unbounded-net-create-restriction
  validationActions: ["Deny"]

---
# Restrict what fields unbounded-net service accounts may modify on Node objects.
# The controller and node agent may ONLY modify:
#   - metadata.labels with the net.unbounded-cloud.io/ prefix
#   - metadata.annotations with the net.unbounded-cloud.io/ prefix
#   - spec.podCIDR and spec.podCIDRs (Kubernetes enforces immutability after initial set)
#   - the node agent's exact gateway taint on its token-bound Node
# All other node fields (spec.unschedulable, status, etc.) must remain unchanged.
# The CEL expressions iterate over map keys dynamically rather than enumerating fields,
# so new fields added to the Node spec in future Kubernetes versions are automatically protected.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: unbounded-net-node-field-restriction
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["UPDATE"]
        resources: ["nodes"]
  matchConditions:
    - name: "is-unbounded-net-sa"
      expression: >-
        request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-controller' ||
        request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node'
  validations:
    # Status must be unchanged.
    - expression: "object.status == oldObject.status"
      message: "unbounded-net may not modify node status"
    # Spec: only podCIDR and podCIDRs may change generally. The node agent may
    # additionally add or remove its exact gateway taint.
    - expression: >-
        object.spec.all(k,
          k in ['podCIDR', 'podCIDRs'] ||
          (request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node' && k == 'taints') ||
          (k in oldObject.spec && object.spec[k] == oldObject.spec[k])) &&
        oldObject.spec.all(k,
          k in ['podCIDR', 'podCIDRs'] ||
          (request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node' && k == 'taints') ||
          (k in object.spec && oldObject.spec[k] == object.spec[k]))
      message: "unbounded-net may only modify pod CIDRs and the node agent's gateway taint"
    - expression: >-
        request.userInfo.username != 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node' ||
        (request.userInfo.extra[?'authentication.kubernetes.io/node-name'][0].orValue('') == object.metadata.name &&
          request.userInfo.extra[?'authentication.kubernetes.io/node-uid'][0].orValue('') == object.metadata.uid &&
          object.spec.?taints.orValue([]).filter(t, t.key != 'net.unbounded-cloud.io/gateway-node') ==
            oldObject.spec.?taints.orValue([]).filter(t, t.key != 'net.unbounded-cloud.io/gateway-node') &&
          object.spec.?taints.orValue([]).filter(t, t.key == 'net.unbounded-cloud.io/gateway-node').size() <= 1 &&
          object.spec.?taints.orValue([]).filter(t, t.key == 'net.unbounded-cloud.io/gateway-node').all(t,
            t.value == 'true' && t.effect == 'NoSchedule'))
      message: "unbounded-net-node may only add or remove its exact gateway taint on its own Node"
    - expression: >-
        request.userInfo.username != 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node' ||
        (((!has(object.metadata.annotations) || !('net.unbounded-cloud.io/wireguard-port' in object.metadata.annotations)) &&
          (!has(oldObject.metadata.annotations) || !('net.unbounded-cloud.io/wireguard-port' in oldObject.metadata.annotations))) ||
        (has(object.metadata.annotations) && has(oldObject.metadata.annotations) &&
          'net.unbounded-cloud.io/wireguard-port' in object.metadata.annotations &&
          'net.unbounded-cloud.io/wireguard-port' in oldObject.metadata.annotations &&
          object.metadata.annotations['net.unbounded-cloud.io/wireguard-port'] == oldObject.metadata.annotations['net.unbounded-cloud.io/wireguard-port']))
      message: "unbounded-net-node may not modify the controller-owned WireGuard port annotation"
    # Labels: only net.unbounded-cloud.io/ prefix labels and the canonical
    # unbounded-cloud.io/site label may be added, changed, or removed. The
    # canonical site label is dual-written alongside the deprecated
    # net.unbounded-cloud.io/site during the label deprecation window.
    - expression: >-
        (!has(object.metadata.labels) && !has(oldObject.metadata.labels)) ||
        (!has(oldObject.metadata.labels) && object.metadata.labels.all(k, k.startsWith('net.unbounded-cloud.io/') || k == 'unbounded-cloud.io/site')) ||
        (!has(object.metadata.labels) && oldObject.metadata.labels.all(k, k.startsWith('net.unbounded-cloud.io/') || k == 'unbounded-cloud.io/site')) ||
        (has(object.metadata.labels) && has(oldObject.metadata.labels) &&
          object.metadata.labels.all(k, k.startsWith('net.unbounded-cloud.io/') || k == 'unbounded-cloud.io/site' ||
            (k in oldObject.metadata.labels && object.metadata.labels[k] == oldObject.metadata.labels[k])) &&
          oldObject.metadata.labels.all(k, k.startsWith('net.unbounded-cloud.io/') || k == 'unbounded-cloud.io/site' ||
            (k in object.metadata.labels && oldObject.metadata.labels[k] == object.metadata.labels[k])))
      message: "unbounded-net may only modify labels with the net.unbounded-cloud.io/ prefix or the unbounded-cloud.io/site label"
    # Annotations: only net.unbounded-cloud.io/ prefix annotations may be added, changed, or removed.
    - expression: >-
        (!has(object.metadata.annotations) && !has(oldObject.metadata.annotations)) ||
        (!has(oldObject.metadata.annotations) && object.metadata.annotations.all(k, k.startsWith('net.unbounded-cloud.io/'))) ||
        (!has(object.metadata.annotations) && oldObject.metadata.annotations.all(k, k.startsWith('net.unbounded-cloud.io/'))) ||
        (has(object.metadata.annotations) && has(oldObject.metadata.annotations) &&
          object.metadata.annotations.all(k, k.startsWith('net.unbounded-cloud.io/') ||
            (k in oldObject.metadata.annotations && object.metadata.annotations[k] == oldObject.metadata.annotations[k])) &&
          oldObject.metadata.annotations.all(k, k.startsWith('net.unbounded-cloud.io/') ||
            (k in object.metadata.annotations && oldObject.metadata.annotations[k] == object.metadata.annotations[k])))
      message: "unbounded-net may only modify annotations with net.unbounded-cloud.io/ prefix"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: unbounded-net-node-field-restriction
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  policyName: unbounded-net-node-field-restriction
  validationActions: ["Deny"]

---
# Protect the ownership of public IP annotations on every Node. The discovered
# address and its expiry belong to the agent running on that Node. The declared
# address belongs to an administrator whose Node update was authorized by RBAC.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: unbounded-net-public-ip-annotation-ownership
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["nodes"]
  validations:
    - expression: >-
        !has(object.metadata.annotations) ||
        (request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node' &&
          request.userInfo.extra[?'authentication.kubernetes.io/node-name'][0].orValue('') == object.metadata.name &&
          request.userInfo.extra[?'authentication.kubernetes.io/node-uid'][0].orValue('') == object.metadata.uid) ||
        ['net.unbounded-cloud.io/discovered-public-ip', 'net.unbounded-cloud.io/discovered-public-ip-expires-at'].all(annotation,
          !(annotation in object.metadata.annotations) ||
          (oldObject != null && has(oldObject.metadata.annotations) &&
            annotation in oldObject.metadata.annotations &&
            object.metadata.annotations[annotation] == oldObject.metadata.annotations[annotation]))
      message: "only the unbounded-net-node agent running on a Node may add or change its public IP discovery annotations"
    - expression: >-
        !has(object.metadata.annotations) ||
        !('net.unbounded-cloud.io/declared-public-ip' in object.metadata.annotations) ||
        (oldObject != null && has(oldObject.metadata.annotations) &&
          'net.unbounded-cloud.io/declared-public-ip' in oldObject.metadata.annotations &&
          object.metadata.annotations['net.unbounded-cloud.io/declared-public-ip'] == oldObject.metadata.annotations['net.unbounded-cloud.io/declared-public-ip']) ||
        (!request.userInfo.username.startsWith('system:serviceaccount:') &&
          !request.userInfo.username.startsWith('system:node:'))
      message: "service accounts and kubelets may not add or change the administrator-declared public IP annotation"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: unbounded-net-public-ip-annotation-ownership
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  policyName: unbounded-net-public-ip-annotation-ownership
  validationActions: ["Deny"]

---
# Restrict node-agent Pod updates to effective assignment acknowledgment by
# the service account token bound to that exact Pod.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: unbounded-net-effective-assignment-ownership
  labels:
    app.kubernetes.io/name: unbounded-net-node
    app.kubernetes.io/component: node
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["UPDATE"]
        resources: ["pods"]
  matchConditions:
    - name: "is-unbounded-net-node-sa"
      expression: "request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-node'"
  validations:
    - expression: >-
        request.userInfo.extra[?'authentication.kubernetes.io/pod-name'][0].orValue('') == object.metadata.name &&
        request.userInfo.extra[?'authentication.kubernetes.io/pod-uid'][0].orValue('') == object.metadata.uid
      message: "unbounded-net-node may only acknowledge assignment on its own bound Pod"
    - expression: >-
        object.spec == oldObject.spec &&
        has(object.status) == has(oldObject.status) &&
        (!has(object.status) || object.status == oldObject.status) &&
        has(object.metadata.labels) == has(oldObject.metadata.labels) &&
        (!has(object.metadata.labels) || object.metadata.labels == oldObject.metadata.labels) &&
        has(object.metadata.ownerReferences) == has(oldObject.metadata.ownerReferences) &&
        (!has(object.metadata.ownerReferences) || object.metadata.ownerReferences == oldObject.metadata.ownerReferences) &&
        has(object.metadata.finalizers) == has(oldObject.metadata.finalizers) &&
        (!has(object.metadata.finalizers) || object.metadata.finalizers == oldObject.metadata.finalizers)
      message: "unbounded-net-node may only modify effective assignment annotations on its own Pod"
    - expression: >-
        (!has(object.metadata.annotations) && !has(oldObject.metadata.annotations)) ||
        (!has(oldObject.metadata.annotations) && object.metadata.annotations.all(k,
          k in ['net.unbounded-cloud.io/effective-site', 'net.unbounded-cloud.io/effective-gateway-pool'])) ||
        (!has(object.metadata.annotations) && oldObject.metadata.annotations.all(k,
          k in ['net.unbounded-cloud.io/effective-site', 'net.unbounded-cloud.io/effective-gateway-pool'])) ||
        (has(object.metadata.annotations) && has(oldObject.metadata.annotations) &&
          object.metadata.annotations.all(k,
            k in ['net.unbounded-cloud.io/effective-site', 'net.unbounded-cloud.io/effective-gateway-pool'] ||
            (k in oldObject.metadata.annotations && object.metadata.annotations[k] == oldObject.metadata.annotations[k])) &&
          oldObject.metadata.annotations.all(k,
            k in ['net.unbounded-cloud.io/effective-site', 'net.unbounded-cloud.io/effective-gateway-pool'] ||
            (k in object.metadata.annotations && oldObject.metadata.annotations[k] == object.metadata.annotations[k])))
      message: "unbounded-net-node may only modify effective assignment annotations"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: unbounded-net-effective-assignment-ownership
  labels:
    app.kubernetes.io/name: unbounded-net-node
    app.kubernetes.io/component: node
spec:
  policyName: unbounded-net-effective-assignment-ownership
  validationActions: ["Deny"]

---
# Restrict controller Pod deletion to the node-agent Pods owned by the
# unbounded-net-node DaemonSet.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: unbounded-net-node-pod-delete-restriction
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["DELETE"]
        resources: ["pods"]
  matchConditions:
    - name: "is-unbounded-net-controller-sa"
      expression: "request.userInfo.username == 'system:serviceaccount:{{ default "unbounded-system" .Namespace }}:unbounded-net-controller'"
  validations:
    - expression: >-
        oldObject.metadata.namespace == '{{ default "unbounded-system" .Namespace }}' &&
        oldObject.metadata.labels['app.kubernetes.io/name'] == 'unbounded-net-node' &&
        oldObject.metadata.labels['app.kubernetes.io/component'] == 'node' &&
        oldObject.metadata.ownerReferences.exists(owner,
          owner.controller == true &&
          owner.apiVersion == 'apps/v1' &&
          owner.kind == 'DaemonSet' &&
          owner.name == 'unbounded-net-node')
      message: "unbounded-net controller may only delete DaemonSet-owned unbounded-net-node Pods"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: unbounded-net-node-pod-delete-restriction
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  policyName: unbounded-net-node-pod-delete-restriction
  validationActions: ["Deny"]
