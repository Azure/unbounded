---
apiVersion: v1
kind: Service
metadata:
  name: unbounded-net-controller
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: unbounded-net-controller
    app.kubernetes.io/component: controller
spec:
  type: ClusterIP
  # No selector - Endpoints and EndpointSlice are managed by the leader pod.
  ports:
    - name: https
      port: 9999
      targetPort: 9999
      protocol: TCP
