apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: racer-node-write-restriction
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["UPDATE"]
        resources: ["nodes", "nodes/status"]
  matchConditions:
    - name: racer-controller
      expression: >-
        request.userInfo.username == {{ printf "system:serviceaccount:%s:racer-controller" (.Namespace | default "unbounded-system") | toJson }}
  variables:
    - name: allowedAnnotations
      expression: >-
        ['racer.unbounded-cloud.io/enrolled-shares',
         'racer.unbounded-cloud.io/enrolled-rdma-nics',
         'racer.unbounded-cloud.io/last-admitted-member']
    - name: annotations
      expression: "has(object.metadata.annotations) ? object.metadata.annotations : {}"
    - name: oldAnnotations
      expression: "has(oldObject.metadata.annotations) ? oldObject.metadata.annotations : {}"
  validations:
    - expression: >-
        dyn(object).all(k, k == 'metadata' || (k in dyn(oldObject) && dyn(object)[k] == dyn(oldObject)[k])) &&
        dyn(oldObject).all(k, k == 'metadata' || (k in dyn(object) && dyn(oldObject)[k] == dyn(object)[k]))
      message: Racer may not change Node fields outside metadata
      reason: Forbidden
    # managedFields is maintained by the API server for each field manager.
    - expression: >-
        dyn(object.metadata).all(k, k in ['annotations', 'managedFields'] ||
          (k in dyn(oldObject.metadata) && dyn(object.metadata)[k] == dyn(oldObject.metadata)[k])) &&
        dyn(oldObject.metadata).all(k, k in ['annotations', 'managedFields'] ||
          (k in dyn(object.metadata) && dyn(oldObject.metadata)[k] == dyn(object.metadata)[k]))
      message: Racer may not change other Node metadata
      reason: Forbidden
    - expression: >-
        variables.annotations.all(k, k in variables.allowedAnnotations ||
          (k in variables.oldAnnotations && variables.annotations[k] == variables.oldAnnotations[k])) &&
        variables.oldAnnotations.all(k, k in variables.allowedAnnotations ||
          (k in variables.annotations && variables.oldAnnotations[k] == variables.annotations[k]))
      message: Racer may only change its three enrollment and recovery Node annotations
      reason: Forbidden
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: racer-node-write-restriction
spec:
  policyName: racer-node-write-restriction
  validationActions: [Deny]
