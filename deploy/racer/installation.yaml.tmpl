{{- if eq (.InitializationState | default "") "fresh" }}
{{- if or (not (regexMatch "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" (.ClusterID | default ""))) (eq .ClusterID "00000000-0000-0000-0000-000000000000") }}
{{- fail "fresh installation requires a new, nonzero canonical ClusterID UUID; never reuse an existing installation UUID" }}
{{- end }}
# Create once for a new cluster UUID. Preserve the controller-finalized marker;
# normal rendering omits it. Never recreate or reset committed authority.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .InstallationConfigMapName | default "racer-installation" | quote }}
  namespace: {{ .Namespace | default "unbounded-system" }}
immutable: false
data:
  cluster: {{ .ClusterID | default "" | quote }}
  version_configmap: {{ .VersionConfigMapName | default "racer-version" | quote }}
  state: fresh
  initialization_protocol: staged-v1
{{- end }}
