apiVersion: v1
kind: ConfigMap
metadata:
  name: racer-dataplane-config
  namespace: {{ .Namespace | default "unbounded-system" }}
data:
  # Defaults match the Rust runtime. Existing administrator data is preserved.
  # Native builds activate only trusted, published, NUMA-local hardware mappings.
  RACER_ENABLE_RDMA: "auto"
  RACER_MAX_THREADS: "8"
  # Proposed during authenticated enrollment; explicit Node shares take precedence.
  RACER_SHARES: "4"
  # Independent node-wide catalog, page-index and checkpoint working-set budgets.
  RACER_METADATA_ENTRIES: "4096"
  RACER_DISK_PAGE_ENTRIES: "65536"
  RACER_CHECKPOINT_BYTES: "67108864"
  RACER_PLAINTEXT_BYTES: "268435456"
  RACER_CIPHERTEXT_BYTES: "268435456"
  RACER_DIRTY_BYTES: "134217728"
  RACER_REGISTERED_BYTES: "134217728"
  RACER_REQUEST_CONTEXT_BYTES: "67108864"
  # Storage geometry is per worker; byte admission budgets above are node-wide.
  RACER_SLAB_BYTES: "1073741824"
  RACER_SEGMENT_BYTES: "67108864"
  RACER_FREE_SEGMENT_RESERVE: "2"
