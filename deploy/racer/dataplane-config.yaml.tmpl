apiVersion: v1
kind: ConfigMap
metadata:
  name: racer-settings
  namespace: {{ .Namespace | default "unbounded-system" }}
data:
  # Existing administrator data is preserved.
  # Control plane seats: "auto" picks 1 to 16 seats from the cluster size, or
  # set a fixed count from 1 to 16. The runtime defaults to auto when unset.
  RACER_CONTROL_SEATS: "auto"
  # Routing is V5 (radix32) only. RACER_ROUTING_ALGORITHM is not supported.
  # Native RDMA is included in release images. Active MW2B-capable ports are
  # reported in the Pod report annotation; published rdma-nics overrides win.
  # RDMA requires the same nonempty Site and rail on both peers. NUMA is
  # autodetected; same-rail candidates prefer local, then unknown, then remote.
  RACER_ENABLE_RDMA: "auto"
  # NVIDIA driver libraries for the dataplane: off, env (default), or cdi.
  # env sets NVIDIA_VISIBLE_DEVICES=all and NVIDIA_DRIVER_CAPABILITIES=compute,utility.
  # cdi also adds the Pod annotation cdi.k8s.io/racer: nvidia.com/gpu=all;
  # containerd then fails the Pod on any node without an NVIDIA CDI spec.
  # The operator reads this key and changes the DaemonSet accordingly.
  # RACER_NVIDIA: "env"
  # GPU reads. The racer image is built with CUDA. auto touches no
  # GPU until the first gpu-read, then turns GPU mode on if a usable GPU is
  # found; true sets up the GPUs at startup and fails startup when none is
  # found; false turns it off.
  # RACER_ENABLE_GPU: "auto"
  # Cap on ciphertext staging memory per GPU, in bytes: a nonzero multiple of
  # 2 MiB, default 256 MiB. GPU reads stage ciphertext here for decryption.
  # RACER_GPU_STAGING_BYTES: "268435456"
  # GPU memory per GPU that peers' NICs write GPU-read pages into over RDMA
  # (GPUDirect RDMA), in bytes: a multiple of 2 MiB, default 256 MiB. 0 turns
  # it off. Used only when both GPU reads and RDMA are on.
  # RACER_GPU_LANDING_BYTES: "268435456"
  # No thread cap by default: eligible physical cores, CPU quota, and resource budgets apply.
  # I/O shards share NUMA-local crypto threads at approximately 2:1, using leftovers:
  # without an explicit cap, eight eligible cores on one NUMA node give five I/O
  # plus three crypto threads when budgets permit, plus one control plane thread.
  # Budgets are divided by the final I/O shard count, not the crypto thread count.
  # RACER_ALLOW_SMT=true opts into logical CPUs; physical cores remain the default.
  # Both policies support separate I/O and crypto threads sharing one allowed CPU.
  # Optional total userspace thread cap: unsigned decimal >= 3 fitting usize,
  # with no fixed 256-thread maximum. It includes the dedicated control plane
  # thread. Kernel io_uring workers are not included.
  # RACER_MAX_THREADS: "8"
  # Omit RACER_MAX_THREADS and any workload env override for automatic sizing.
  # Optional exact split: set BOTH counts; omit both to keep automatic sizing.
  # Their sum plus the control plane thread must fit RACER_MAX_THREADS.
  # Use one known NUMA node in existing placement preference order. Insufficient
  # local CPUs, CPU quota, or per-I/O budgets fail startup instead of reducing counts.
  # Example A: IO_WORKERS=20, CRYPTO_HELPERS=10, MAX_THREADS=31.
  # Example B: IO_WORKERS=20, CRYPTO_HELPERS=20, MAX_THREADS=41.
  # RACER_IO_WORKERS: "20"
  # RACER_CRYPTO_HELPERS: "20"
  # The operator preserves administrator data and hashes edits for managed rollout.
  # These defaults are embedded in the operator and only seed a missing ConfigMap.
  # Reported by each Pod; explicit Node shares take precedence.
  RACER_SHARES: "4"
  # Independent node-wide catalog, page-index and checkpoint working-set budgets.
  # Raw-device mode can raise page-index capacity to fit full pages after reserves
  # (up to 1,000,000 entries per worker) and checkpoint working memory to 512 MiB.
  # Allow for index, heat, segment, and snapshot memory beyond admission budgets.
  # Encoded checkpoints remain capped at 64 MiB; oversized cuts are skipped.
  RACER_METADATA_ENTRIES: "4096"
  RACER_DISK_PAGE_ENTRIES: "65536"
  RACER_CHECKPOINT_BYTES: "67108864"
  # Byte admission budgets default to per-I/O-worker amounts that are multiplied
  # by the final I/O worker count, so automatic sizing works on any core count:
  # plaintext 64 MiB, ciphertext 128 MiB, dirty 160 MiB, request context 32 MiB,
  # and registered 96 MiB (native RDMA only) per worker. Setting a key below
  # makes it an authoritative node-wide value that is divided across workers;
  # startup fails if it cannot fund at least half of the planned I/O workers.
  # Each worker needs roughly 115 MiB of these byte budgets at minimum
  # (plaintext and ciphertext about 48 MiB each, dirty 16 MiB, plus request
  # context) with the default range window of two pages.
  # Budgets are admission ceilings, not reservations: resident memory grows
  # toward them under load. Unset defaults therefore scale with core count.
  # To bound memory, cap total threads with RACER_MAX_THREADS, or set
  # RACER_IO_WORKERS with RACER_CRYPTO_HELPERS, or set explicit node-wide
  # values below. RACER_METADATA_ENTRIES above is set explicitly, so it is a
  # node-wide total, not the per-worker default of 4096.
  # RACER_PLAINTEXT_BYTES: "268435456"
  # RACER_CIPHERTEXT_BYTES: "268435456"
  # RACER_DIRTY_BYTES: "134217728"
  # RACER_REGISTERED_BYTES: "134217728"
  # RACER_REQUEST_CONTEXT_BYTES: "67108864"
  # HEAD max-age requests warm exact versions; acceptance is not fill completion.
  # TTL starts at admission, including time spent filling. Both seconds limits
  # accept 1..86400. Background credentials stay charged and zeroizing in memory.
  RACER_WARM_MAX_TTL_SECS: "3600"
  RACER_WARM_FILL_TIMEOUT_SECS: "600"
  # Node-wide tracked versions (1..1024), including completed jobs until expiry;
  # in-flight pages per job (1..64). Reads cannot jump ahead of the warm pipeline.
  RACER_WARM_MAX_JOBS: "16"
  RACER_WARM_WINDOW_PAGES: "2"
  # Per-worker percentage of segments and page-index entries (1..100).
  # Charge one whole segment per page to protect hard holds under fragmentation.
  # Existing local copies are not rewritten. Free-segment reserves still apply.
  RACER_RETAINED_SEGMENT_PERCENT: "50"
  # File slab size is per worker. Byte admission budgets above are node-wide
  # only when set explicitly; unset ones are per-worker defaults scaled up.
  # Optional Node annotation racer.unbounded-cloud.io/block-devices selects raw
  # devices by regex on /host/dev/disk/by-id basenames. Use ^ and $ anchors.
  # The 1 KiB selector must compile in Rust. Invalid/no usable matches
  # fall back to slab files. Annotation changes take effect only after restart.
  # WARNING: selected devices are overwritten without a signature check.
  # Partitions are allowed, including unmounted OS partitions if matched.
  # Devices with child partitions, holders, read-only state, mounts, or failed
  # exclusive opens are skipped. These checks do not prove a device is disposable.
  # Host /dev is mounted read-only at /host/dev, but raw writes are intentional.
  # Device mode splits all whole segments across workers, subject to hard caps;
  # subsegment tails are unusable. Reserves, headers, AEAD, and alignment still apply.
  # RACER_SLAB_BYTES does not limit device capacity; keep it valid for fallback.
  # RACER_SLAB_DIRECTORY still holds checkpoints and must remain writable.
  # Cluster-bound checkpoints restore completed-page holds, not jobs or credentials.
  # Older formats and incompatible layouts start cold; no fsync crash guarantee.
  RACER_SLAB_BYTES: "1073741824"
  RACER_SEGMENT_BYTES: "67108864"
  RACER_FREE_SEGMENT_RESERVE: "2"
