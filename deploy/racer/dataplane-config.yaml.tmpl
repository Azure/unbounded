apiVersion: v1
kind: ConfigMap
metadata:
  name: racer-dataplane-config
  namespace: {{ .Namespace | default "unbounded-system" }}
data:
  # Defaults match the Rust runtime. Existing administrator data is preserved.
  # Routing is V5 (radix32) only. RACER_ROUTING_ALGORITHM is not supported.
  # Native RDMA is included in release images. Active MW2B-capable ports are
  # reported at authenticated enrollment; published rdma-nics overrides win.
  # RDMA requires the same nonempty Site and rail on both peers. NUMA is
  # autodetected; same-rail candidates prefer local, then unknown, then remote.
  RACER_ENABLE_RDMA: "auto"
  # No thread cap by default: eligible physical cores, CPU quota, and resource budgets apply.
  # I/O shards share NUMA-local crypto threads at approximately 2:1, using leftovers:
  # eight eligible cores on one NUMA node give five I/O plus three crypto threads
  # when budgets permit.
  # Budgets are divided by the final I/O shard count, not the crypto thread count.
  # RACER_ALLOW_SMT=true opts into logical CPUs; physical cores remain the default.
  # Both policies support separate I/O and crypto threads sharing one allowed CPU.
  # Optional total userspace thread cap: unsigned decimal >= 2 fitting usize,
  # with no fixed 256-thread maximum. Kernel io_uring workers are not included.
  # RACER_MAX_THREADS: "8"
  # Omit RACER_MAX_THREADS and any workload env override for automatic sizing.
  # The operator preserves administrator data and hashes edits for managed rollout.
  # Rebuild the operator to ship embedded defaults; regenerate standalone manifests
  # with make racer-manifests instead of editing generated output.
  # Proposed during authenticated enrollment; explicit Node shares take precedence.
  RACER_SHARES: "4"
  # Independent node-wide catalog, page-index and checkpoint working-set budgets.
  RACER_METADATA_ENTRIES: "4096"
  RACER_DISK_PAGE_ENTRIES: "65536"
  RACER_CHECKPOINT_BYTES: "67108864"
  RACER_PLAINTEXT_BYTES: "268435456"
  RACER_CIPHERTEXT_BYTES: "268435456"
  RACER_DIRTY_BYTES: "134217728"
  RACER_REGISTERED_BYTES: "134217728"
  RACER_REQUEST_CONTEXT_BYTES: "67108864"
  # Storage geometry is per worker; byte admission budgets above are node-wide.
  RACER_SLAB_BYTES: "1073741824"
  RACER_SEGMENT_BYTES: "67108864"
  RACER_FREE_SEGMENT_RESERVE: "2"
