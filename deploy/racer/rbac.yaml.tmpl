apiVersion: v1
kind: ServiceAccount
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: racer-dataplane
  namespace: {{ .Namespace | default "unbounded-system" }}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: racer-controller
rules:
  # Install node-restriction.yaml and its binding before this ClusterRoleBinding.
  # RBAC cannot limit patches to the enrollment and recovery annotations.
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch", "patch"]
  - apiGroups: ["racer.unbounded-cloud.io"]
    resources: ["clustervolumes"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["authentication.k8s.io"]
    resources: ["tokenreviews"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: racer-controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: racer-controller
subjects:
  - kind: ServiceAccount
    name: racer-controller
    namespace: {{ .Namespace | default "unbounded-system" }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
rules:
  - apiGroups: [""]
    resources: ["pods", "serviceaccounts"]
    verbs: ["get", "list", "watch"]
  # Create cannot be restricted by resourceNames. The fail-closed admission
  # policy must be installed before enabling this RoleBinding or any workload.
  - apiGroups: [""]
    resources: ["secrets", "configmaps"]
    verbs: ["create"]
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: [{{ .CredentialsSecretName | default "racer-credentials" | quote }}]
    # List/watch require the matching metadata.name field selector.
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: [{{ .InstallationConfigMapName | default "racer-installation" | quote }}, {{ .VersionConfigMapName | default "racer-version" | quote }}]
    # Each cache uses its own matching metadata.name field selector.
    verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: ["apps"]
    resources: ["daemonsets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    # RBAC cannot restrict create by name; LeaseLock needs no list/watch.
    verbs: ["create"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    resourceNames: ["racer-controller"]
    verbs: ["get", "update"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: racer-controller
subjects:
  - kind: ServiceAccount
    name: racer-controller
    namespace: {{ .Namespace | default "unbounded-system" }}
