apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: racer-runtime-write-restriction
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["configmaps", "secrets"]
  matchConditions:
    - name: racer-controller
      expression: >-
        request.userInfo.username == {{ printf "system:serviceaccount:%s:racer-controller" (.Namespace | default "unbounded-system") | toJson }}
  validations:
    - expression: >-
        request.userInfo.username == 'system:serviceaccount:' + request.namespace + ':racer-controller' &&
        ((request.resource.resource == 'configmaps' && object.metadata.name in [{{ .InstallationConfigMapName | default "racer-installation" | toJson }}, {{ .VersionConfigMapName | default "racer-version" | toJson }}]) ||
         (request.resource.resource == 'secrets' && object.metadata.name == {{ .CredentialsSecretName | default "racer-credentials" | toJson }} &&
          dyn(object).type == 'Opaque' &&
          (!has(object.metadata.annotations) ||
           (!('kubernetes.io/service-account.name' in object.metadata.annotations) &&
            !('kubernetes.io/service-account.uid' in object.metadata.annotations)))))
      message: Racer may only write its runtime installation/version objects and Opaque credentials Secret without service-account annotations
      reason: Forbidden
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: racer-runtime-write-restriction
spec:
  policyName: racer-runtime-write-restriction
  validationActions: [Deny]
