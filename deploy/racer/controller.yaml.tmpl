apiVersion: apps/v1
kind: Deployment
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
spec:
  replicas: 3
  # Only the leader is ready. RollingUpdate cannot retire the last old leader
  # while preserving an available replica. Accept a control-plane interruption;
  # running dataplanes retain their last accepted state. See the controller README.
  strategy:
    type: Recreate
    # Clear API-defaulted RollingUpdate settings when updating an existing install.
    rollingUpdate: null
  selector:
    matchLabels:
      app: racer-controller
  template:
    metadata:
      labels:
        app: racer-controller
    spec:
      serviceAccountName: racer-controller
      containers:
        - name: controller
          image: {{ .ControllerImage | default "ghcr.io/azure/racer-controller:latest" }}
          envFrom:
            - configMapRef:
                name: racer-config
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          ports:
            - name: https
              containerPort: 8443
            - name: probes
              containerPort: 8081
            - name: metrics
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /readyz
              port: probes
          livenessProbe:
            httpGet:
              path: /healthz
              port: probes
          volumeMounts:
            - name: tls
              mountPath: /etc/racer/tls
              readOnly: true
      volumes:
        - name: tls
          secret:
            secretName: {{ .ServingTLSSecret | default "racer-controller-tls" | quote }}
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
---
apiVersion: v1
kind: Service
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
spec:
  selector:
    app: racer-controller
  ports:
    - name: https
      port: 8443
      targetPort: https
