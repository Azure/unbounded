apiVersion: apps/v1
kind: Deployment
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
spec:
  replicas: 3
  # Every synchronized replica becomes ready. Retain Recreate for migration from
  # old leaders without snapshot replication; new followers cannot sync from them.
  # This intentionally interrupts control service.
  strategy:
    type: Recreate
    # Clear API-defaulted RollingUpdate settings when updating an existing install.
    rollingUpdate: null
  selector:
    matchLabels:
      app: racer-controller
  template:
    metadata:
      labels:
        app: racer-controller
    spec:
      serviceAccountName: racer-controller
      securityContext:
        # Kubelet needs an explicit UID to own the 0400 projected replication token.
        runAsUser: 65532
      containers:
        - name: controller
          image: {{ .ControllerImage | default "ghcr.io/azure/racer-controller:latest" }}
          envFrom:
            - configMapRef:
                name: racer-config
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_UID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
          ports:
            - name: https
              containerPort: 8443
            - name: probes
              containerPort: 8081
            - name: metrics
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /readyz
              port: probes
          livenessProbe:
            httpGet:
              path: /healthz
              port: probes
          volumeMounts:
            - name: tls
              mountPath: /etc/racer/tls
              readOnly: true
            - name: replication-token
              mountPath: /var/run/secrets/racer-controller
              readOnly: true
      volumes:
        - name: tls
          secret:
            secretName: {{ .ServingTLSSecret | default "racer-controller-tls" | quote }}
            items:
              - key: tls.crt
                path: tls.crt
              - key: tls.key
                path: tls.key
              - key: ca.crt
                path: ca.crt
        - name: replication-token
          projected:
            defaultMode: 0400
            sources:
              - serviceAccountToken:
                  audience: racer-controller-replication
                  expirationSeconds: 3600
                  path: token
---
apiVersion: v1
kind: Service
metadata:
  name: racer-controller
  namespace: {{ .Namespace | default "unbounded-system" }}
spec:
  selector:
    app: racer-controller
  ports:
    - name: https
      port: 8443
      targetPort: https
