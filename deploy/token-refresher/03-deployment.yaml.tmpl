apiVersion: apps/v1
kind: Deployment
metadata:
  name: token-refresher
  namespace: {{ default "unbounded-system" .Namespace }}
  labels:
    app.kubernetes.io/name: token-refresher
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: token-refresher
  template:
    metadata:
      labels:
        app.kubernetes.io/name: token-refresher
    spec:
      serviceAccountName: token-refresher
      containers:
        - name: token-refresher
          image: {{ default "ghcr.io/azure/token-refresher:dev" .Image }}
          imagePullPolicy: Always
          args:
            - controller
            - --config=/etc/token-refresher/config.yaml
          ports:
            - name: metrics
              containerPort: 8080
              protocol: TCP
            - name: health
              containerPort: 8081
              protocol: TCP
          resources:
            requests:
              cpu: 25m
              memory: 64Mi
            limits:
              cpu: 250m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 65534
            capabilities:
              drop: ["ALL"]
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
          volumeMounts:
            - name: config
              mountPath: /etc/token-refresher/config.yaml
              subPath: config.yaml
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: token-refresher
