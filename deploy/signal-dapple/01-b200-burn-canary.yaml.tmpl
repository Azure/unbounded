apiVersion: signal.unbounded-cloud.io/v1alpha1
kind: CertificationProfile
metadata:
  name: dapple-b200-burn-canary-8gpu
  annotations:
    signal.unbounded-cloud.io/scope: "Dapple six-hour B200 burn canary using all eight GPUs"
spec:
  participants:
    count: 1
    selector:
      matchLabels:
        node.kubernetes.io/instance-type: Dapple_B200_8x180GB
        nvidia.com/gpu.product: NVIDIA-B200
    requiredResources:
      nvidia.com/gpu: "8"
  script:
    name: project-signal-scripts
    key: gpu-burn-canary.sh
  workflow:
    name: project-signal-gpu-burn-canary
  backend:
    apiVersion: argoproj.io/v1alpha1
    kind: Workflow
  runnerImage: {{ default "example.invalid/project-signal-burn-runner:replace-me" .BurnRunnerImage }}
  purpose: Diagnostic
  stagePlan:
    - id: preflight
      displayName: Burn inventory and safety preflight
      category: health
      description: Validate all expected B200 GPUs and capture baseline Xid, ECC, temperature, and power telemetry.
      required: true
    - id: workload
      displayName: Six-hour mixed burn canary
      category: compute
      description: Run pinned GPU Burn with bounded CPU, memory-integrity, and ephemeral-storage integrity load while sampling safety telemetry.
      expectedDuration: 6h
      required: true
    - id: health-after
      displayName: Burn health-after snapshot
      category: health
      description: Reject new Xids, uncorrectable ECC growth, thermal-limit exhaustion, power-limit violations, or workload failures.
      required: true
  parameters:
    expected-gpu-product-regex: ^NVIDIA B200$
    expected-gpu-count: "8"
    burn-duration-seconds: "21600"
    sample-interval-seconds: "60"
    power-limit-tolerance-percent: "5"
    power-limit-consecutive-samples: "3"
    cpu-workers: "8"
    memory-mib: "2048"
    storage-mib: "2048"
  evidencePath: project-signal/dapple-b200-burn-canary-8gpu
  deadline: 6h30m
  maxAttempts: 1
  tolerations:
    - key: nvidia.com/gpu
      operator: Exists
      effect: NoSchedule
  recurring:
    enabled: false
    nodeNames:
      - gpu-07-03
    minIdleDuration: 15m
    validFor: 24h
    expiresAt: "1970-01-01T00:00:00Z"
    evaluationInterval: 1m
    failureBackoff: 30m
    maxConsecutiveFailures: 1
    maxConcurrent: 1
    failureDomainLabel: topology.kubernetes.io/zone
    maxConcurrentPerFailureDomain: 1
    exclusiveProfiles: []
---
apiVersion: signal.unbounded-cloud.io/v1alpha1
kind: CertificationProfile
metadata:
