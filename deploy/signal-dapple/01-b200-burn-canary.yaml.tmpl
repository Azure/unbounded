  parameters:
    expected-gpu-product-regex: ^NVIDIA B200$
    expected-gpu-count: "7"
    burn-duration-seconds: "21600"
    sample-interval-seconds: "60"
    power-limit-tolerance-percent: "5"
    power-limit-consecutive-samples: "3"
    cpu-workers: "8"
    memory-mib: "2048"
    storage-mib: "2048"
