  deadline: 6h30m
  maxAttempts: 1
  tolerations:
    - key: nvidia.com/gpu
      operator: Exists
      effect: NoSchedule
  recurring:
    enabled: false
    nodeNames:
      - gpu-07-13
    minIdleDuration: 15m
    validFor: 24h
    expiresAt: "1970-01-01T00:00:00Z"
    evaluationInterval: 1m
    failureBackoff: 30m
    maxConsecutiveFailures: 1
    maxConcurrent: 1
    failureDomainLabel: topology.kubernetes.io/zone
    maxConcurrentPerFailureDomain: 1
    exclusiveProfiles: []
