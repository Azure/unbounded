---
# ConfigMap carrying the LocalStack init-hook script. LocalStack 3.x
# scans /etc/localstack/init/ready.d/ once it reports ready and runs
# every executable script it finds there. Scripts re-run on every
# container start (including restarts following pod eviction or the
# LocalStack process crashing), which makes this the right mechanism
# for "make these buckets exist whenever LocalStack is up".
#
# This replaces the previous one-shot 'orca-buckets-init' Kubernetes
# Job. That Job ran once at first deploy and could not re-run after
# a LocalStack pod restart wiped the buckets - producing the orca
# CrashLoopBackOff failure mode with NoSuchBucket on the cachestore
# versioning probe.
#
# Reference: https://docs.localstack.cloud/references/init-hooks/
apiVersion: v1
kind: ConfigMap
metadata:
  name: localstack-init-buckets
  namespace: {{ default "unbounded-kube" .Namespace }}
  labels:
    app.kubernetes.io/name: localstack
    app.kubernetes.io/part-of: orca-dev
data:
  init-buckets.sh: |
    #!/bin/sh
    # LocalStack init-hook (stage=ready). Runs after LocalStack
    # reports ready, on every container start including restarts.
    # Idempotent: head-bucket gates the create-bucket call so reruns
    # against an already-populated bucket are a no-op.
    set -eu

    ensure_bucket() {
      bucket="$1"
      if awslocal s3api head-bucket --bucket "$bucket" >/dev/null 2>&1; then
        echo "init: bucket $bucket already exists"
      else
        awslocal s3 mb "s3://$bucket"
        echo "init: created bucket $bucket"
      fi
    }

    ensure_bucket "{{ default "orca-cache" .CachestoreBucket }}"
    ensure_bucket "{{ default "orca-origin" .OriginBucket }}"

    # Cachestore versioning must remain unset (Enabled / Suspended
    # would break the no-clobber atomic-commit primitive orca
    # depends on). The driver's versioningGate enforces this at
    # startup; we double-check here so misconfiguration also surfaces
    # in LocalStack logs.
    status=$(awslocal s3api get-bucket-versioning \
      --bucket "{{ default "orca-cache" .CachestoreBucket }}" \
      --query Status --output text 2>/dev/null || echo "None")
    echo "init: cachestore versioning = $status (expected None)"
    if [ "$status" = "Enabled" ] || [ "$status" = "Suspended" ]; then
      echo "init: ERROR: cachestore bucket has versioning $status; orca refuses to start"
      exit 1
    fi

    echo "init: complete"

---
apiVersion: v1
kind: Service
metadata:
  name: localstack
  namespace: {{ default "unbounded-kube" .Namespace }}
  labels:
    app.kubernetes.io/name: localstack
    app.kubernetes.io/part-of: orca-dev
spec:
  # NodePort so the host-side dev tool (hack/cmd/orcadev) can talk to
  # LocalStack S3 without a kubectl port-forward. Kind binds node
  # ports to the host's loopback, so the tool talks to
  # http://localhost:<nodePort>/. The fixed port (default 30200)
  # mirrors the Azurite NodePort pattern (30100) and sits in the
  # Kubernetes NodePort range (30000-32767). Two concurrent dev
  # clusters on the same host would collide; override via
  # LocalstackNodePort in the renderer invocation if you run more
  # than one.
  type: NodePort
  selector:
    app.kubernetes.io/name: localstack
  ports:
    - name: edge
      port: 4566
      targetPort: 4566
      nodePort: {{ default "30200" .LocalstackNodePort }}
      protocol: TCP

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: localstack
  namespace: {{ default "unbounded-kube" .Namespace }}
  labels:
    app.kubernetes.io/name: localstack
    app.kubernetes.io/part-of: orca-dev
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: localstack
  template:
    metadata:
      labels:
        app.kubernetes.io/name: localstack
        app.kubernetes.io/part-of: orca-dev
    spec:
      containers:
        - name: localstack
          # 3.8 is community-tier; 'latest' became Pro-only and exits
          # with code 55 ("License activation failed").
          image: {{ default "localstack/localstack:3.8" .LocalstackImage | quote }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 4566
              name: edge
              protocol: TCP
          env:
            - name: SERVICES
              value: s3
            - name: DEBUG
              value: "0"
            - name: PERSISTENCE
              value: "0"
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 1
              memory: 1Gi
          readinessProbe:
            httpGet:
              path: /_localstack/health
              port: 4566
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /_localstack/health
              port: 4566
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
          volumeMounts:
            - name: data
              mountPath: /var/lib/localstack
            - name: init-buckets
              mountPath: /etc/localstack/init/ready.d
              readOnly: true
      volumes:
        - name: data
          emptyDir: {}
        - name: init-buckets
          configMap:
            name: localstack-init-buckets
            # 0755 (decimal 493) so LocalStack's init runner can exec
            # the script. The default ConfigMap mount mode is 0644
            # (no exec bit), which LocalStack silently skips.
            defaultMode: 0755
