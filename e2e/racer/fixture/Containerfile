# Test-only origin and probe image. Build with the repository root as context.
FROM golang:1.26.6 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY e2e/racer/fixture ./e2e/racer/fixture
COPY internal/racer ./internal/racer
COPY api ./api
RUN CGO_ENABLED=0 go build -trimpath -o /fixture ./e2e/racer/fixture/cmd
FROM scratch
COPY --from=build /fixture /fixture
ENTRYPOINT ["/fixture"]
